<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- ========================================
         Tesla 暗色主题 — 碳黑画布 + 电光蓝
         符合 Tesla 设计哲学：无阴影、极简、产品为核
         ======================================== -->
    
    <!-- 主题元数据 -->
    <sys:String x:Key="ThemeId">TeslaDark</sys:String>
    <sys:String x:Key="ThemeDisplayName">碳墨</sys:String>
    <sys:String x:Key="ThemeDisplayNameEn">Carbon Dark</sys:String>
    <sys:String x:Key="ThemeDescription">碳黑画布配电光蓝，纯净低眩光</sys:String>
    <sys:String x:Key="ThemeDescriptionEn">Carbon Dark canvas with Electric Blue accent, pure low-glare</sys:String>
    <sys:String x:Key="ThemeAuthor">YiboSoft</sys:String>
    <sys:String x:Key="ThemeVersion">1.0.0</sys:String>
    
    <!-- 预览色彩 -->
    <sys:String x:Key="PreviewPrimaryColor">#3E6AE1</sys:String>
    <sys:String x:Key="PreviewBackgroundColor">#171A20</sys:String>
    <sys:String x:Key="PreviewSurfaceColor">#1E2129</sys:String>
    <sys:String x:Key="PreviewTextColor">#FFFFFF</sys:String>
    
    <!-- ========================================
         核心资源 (37个 Semantic Tokens)
         ======================================== -->
    
    <!-- 1. 背景类 (9个) — 碳黑层级 -->
    <Color x:Key="BackgroundPrimaryBrush.Color">#171A20</Color>
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#171A20"/>
    
    <Color x:Key="BackgroundSecondaryBrush.Color">#1E2129</Color>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#1E2129"/>
    
    <Color x:Key="BackgroundTertiaryBrush.Color">#252932</Color>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="#252932"/>
    
    <Color x:Key="BackgroundElevatedBrush.Color">#1E2129</Color>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="#1E2129"/>
    
    <Color x:Key="TitleBarBackgroundBrush.Color">#171A20</Color>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#171A20"/>
    
    <Color x:Key="NavigationRegionBrush.Color">#13161B</Color>
    <SolidColorBrush x:Key="NavigationRegionBrush" Color="#13161B"/>
    
    <Color x:Key="SidebarBackgroundBrush.Color">#13161B</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#13161B"/>
    
    <Color x:Key="PaneFocusedBackgroundBrush.Color">#171A20</Color>
    <SolidColorBrush x:Key="PaneFocusedBackgroundBrush" Color="#171A20"/>
    
    <Color x:Key="PaneUnfocusedBackgroundBrush.Color">#14171D</Color>
    <SolidColorBrush x:Key="PaneUnfocusedBackgroundBrush" Color="#14171D"/>

    <!-- 2. 文本类 (6个) — 白→浅灰→中灰 -->
    <Color x:Key="ForegroundPrimaryBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="ForegroundPrimaryBrush" Color="#FFFFFF"/>
    
    <Color x:Key="ForegroundSecondaryBrush.Color">#B0B3B8</Color>
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="#B0B3B8"/>
    
    <Color x:Key="ForegroundTertiaryBrush.Color">#8E8E8E</Color>
    <SolidColorBrush x:Key="ForegroundTertiaryBrush" Color="#8E8E8E"/>
    
    <Color x:Key="ForegroundDisabledBrush.Color">#666666</Color>
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#666666"/>
    
    <Color x:Key="ForegroundOnAccentBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="ForegroundOnAccentBrush" Color="#FFFFFF"/>
    
    <!-- Legacy Key -->
    <Color x:Key="ForegroundPrimaryColor">#FFFFFF</Color>
    
    <!-- 3. 边框类 (3个) -->
    <Color x:Key="BorderDefaultBrush.Color">#2E323A</Color>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#2E323A"/>
    
    <Color x:Key="BorderSubtleBrush.Color">#252932</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#252932"/>
    
    <Color x:Key="BorderFocusBrush.Color">#3E6AE1</Color>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#3E6AE1"/>
    
    <!-- 4. 强调色/交互 (7个) — 电光蓝暗色适配 -->
    <Color x:Key="AccentDefaultBrush.Color">#3E6AE1</Color>
    <SolidColorBrush x:Key="AccentDefaultBrush" Color="#3E6AE1"/>
    
    <Color x:Key="AccentHoverBrush.Color">#5A7DE6</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5A7DE6"/>
    
    <Color x:Key="AccentPressedBrush.Color">#2B5CC7</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2B5CC7"/>
    
    <Color x:Key="AccentSelectedBrush.Color">#6B93EC</Color>
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="#6B93EC"/>
    
    <Color x:Key="AccentLightBrush.Color">#1A2744</Color>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#1A2744"/>
    
    <!-- Legacy Keys -->
    <Color x:Key="AccentColor">#3E6AE1</Color>
    <Color x:Key="AccentHoverColor">#5A7DE6</Color>
    
    <!-- 5. 控件状态 (4个) -->
    <Color x:Key="ControlDefaultBrush.Color">#252932</Color>
    <SolidColorBrush x:Key="ControlDefaultBrush" Color="#252932"/>
    
    <Color x:Key="ControlHoverBrush.Color">#2E323A</Color>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#2E323A"/>
    
    <Color x:Key="ControlPressedBrush.Color">#383D47</Color>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#383D47"/>
    
    <Color x:Key="ControlDisabledBrush.Color">#1E2129</Color>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#1E2129"/>
    
    <!-- 6. 状态色 (4个) -->
    <Color x:Key="StatusSuccessBrush.Color">#4CAF50</Color>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#4CAF50"/>
    
    <Color x:Key="StatusWarningBrush.Color">#FFC107</Color>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFC107"/>
    
    <Color x:Key="StatusErrorBrush.Color">#E57373</Color>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#E57373"/>
    
    <Color x:Key="StatusInfoBrush.Color">#3E6AE1</Color>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#3E6AE1"/>
    
    <!-- 7. 特殊用途 (5个) — 无阴影 -->
    <Color x:Key="TransparentBrush.Color">Transparent</Color>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    
    <Color x:Key="OverlayBrush.Color">#66FFFFFF</Color>
    <SolidColorBrush x:Key="OverlayBrush" Color="#66FFFFFF"/>
    
    <Color x:Key="OverlayLightBrush.Color">#33FFFFFF</Color>
    <SolidColorBrush x:Key="OverlayLightBrush" Color="#33FFFFFF"/>
    
    <Color x:Key="OverlayDarkBrush.Color">#66000000</Color>
    <SolidColorBrush x:Key="OverlayDarkBrush" Color="#66000000"/>
    
    <Color x:Key="DividerBrush.Color">#2E323A</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="#2E323A"/>
    
    <!-- Tesla 无阴影 -->
    <Color x:Key="ShadowBrush.Color">#00000000</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="#00000000"/>

</ResourceDictionary>
