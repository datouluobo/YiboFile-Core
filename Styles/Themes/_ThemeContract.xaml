<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================
         Theme Contract (颜色主题合约)
         ================================================================
         本文件定义所有主题必须提供的 37 个 Semantic Token 的默认值。
         作为加载链的第一层, 保证任何键缺失都不会导致崩溃。
         默认值基于 Light 主题。
         
         新增主题时, 请确保覆盖以下所有键。
         可运行 scripts/Validate-Contracts.ps1 验证完整性。
         ================================================================ -->

    <!-- ======== 背景类 ×9 ======== -->
    <Color x:Key="BackgroundPrimaryBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#FFFFFF"/>
    
    <Color x:Key="BackgroundSecondaryBrush.Color">#F8F9FA</Color>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#F8F9FA"/>
    
    <Color x:Key="BackgroundTertiaryBrush.Color">#F5F5F5</Color>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="#F5F5F5"/>
    
    <Color x:Key="BackgroundElevatedBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="#FFFFFF"/>
    
    <Color x:Key="TitleBarBackgroundBrush.Color">#F8F9FA</Color>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F8F9FA"/>
    
    <Color x:Key="NavigationRegionBrush.Color">#F2F2F2</Color>
    <SolidColorBrush x:Key="NavigationRegionBrush" Color="#F2F2F2"/>
    
    <Color x:Key="SidebarBackgroundBrush.Color">#F0F0F0</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F0F0F0"/>
    
    <Color x:Key="PaneFocusedBackgroundBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="PaneFocusedBackgroundBrush" Color="#FFFFFF"/>
    
    <Color x:Key="PaneUnfocusedBackgroundBrush.Color">#FAFAFA</Color>
    <SolidColorBrush x:Key="PaneUnfocusedBackgroundBrush" Color="#FAFAFA"/>

    <!-- ======== 文本类 ×6 ======== -->
    <Color x:Key="ForegroundPrimaryBrush.Color">#212529</Color>
    <SolidColorBrush x:Key="ForegroundPrimaryBrush" Color="#212529"/>
    
    <Color x:Key="ForegroundSecondaryBrush.Color">#666666</Color>
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="#666666"/>
    
    <Color x:Key="ForegroundTertiaryBrush.Color">#999999</Color>
    <SolidColorBrush x:Key="ForegroundTertiaryBrush" Color="#999999"/>
    
    <Color x:Key="ForegroundDisabledBrush.Color">#ADB5BD</Color>
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#ADB5BD"/>
    
    <Color x:Key="ForegroundOnAccentBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="ForegroundOnAccentBrush" Color="#FFFFFF"/>
    
    <!-- Legacy Key for animation -->
    <Color x:Key="ForegroundPrimaryColor">#212529</Color>

    <!-- ======== 边框类 ×3 ======== -->
    <Color x:Key="BorderDefaultBrush.Color">#E0E0E0</Color>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#E0E0E0"/>
    
    <Color x:Key="BorderSubtleBrush.Color">#F0F0F0</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#F0F0F0"/>
    
    <Color x:Key="BorderFocusBrush.Color">#007BFF</Color>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#007BFF"/>

    <!-- ======== 强调色 ×7 ======== -->
    <Color x:Key="AccentDefaultBrush.Color">#007BFF</Color>
    <SolidColorBrush x:Key="AccentDefaultBrush" Color="#007BFF"/>
    
    <Color x:Key="AccentHoverBrush.Color">#0056B3</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0056B3"/>
    
    <Color x:Key="AccentPressedBrush.Color">#004085</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#004085"/>
    
    <Color x:Key="AccentSelectedBrush.Color">#64B5F6</Color>
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="#64B5F6"/>
    
    <Color x:Key="AccentLightBrush.Color">#E3F2FD</Color>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#E3F2FD"/>
    
    <!-- Legacy Keys for animation -->
    <Color x:Key="AccentColor">#007BFF</Color>
    <Color x:Key="AccentHoverColor">#0056B3</Color>

    <!-- ======== 控件状态 ×4 ======== -->
    <Color x:Key="ControlDefaultBrush.Color">#E3F2FD</Color>
    <SolidColorBrush x:Key="ControlDefaultBrush" Color="#E3F2FD"/>
    
    <Color x:Key="ControlHoverBrush.Color">#BBDEFB</Color>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#BBDEFB"/>
    
    <Color x:Key="ControlPressedBrush.Color">#90CAF9</Color>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#90CAF9"/>
    
    <Color x:Key="ControlDisabledBrush.Color">#F5F5F5</Color>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#F5F5F5"/>

    <!-- ======== 语义状态 ×4 ======== -->
    <Color x:Key="StatusSuccessBrush.Color">#28A745</Color>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#28A745"/>
    
    <Color x:Key="StatusWarningBrush.Color">#FFC107</Color>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFC107"/>
    
    <Color x:Key="StatusErrorBrush.Color">#DC3545</Color>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#DC3545"/>
    
    <Color x:Key="StatusInfoBrush.Color">#17A2B8</Color>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#17A2B8"/>

    <!-- ======== 特殊用途 ×5 ======== -->
    <Color x:Key="TransparentBrush.Color">Transparent</Color>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    
    <Color x:Key="OverlayBrush.Color">#66000000</Color>
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>
    
    <Color x:Key="OverlayLightBrush.Color">#33000000</Color>
    <SolidColorBrush x:Key="OverlayLightBrush" Color="#33000000"/>
    
    <Color x:Key="OverlayDarkBrush.Color">#66000000</Color>
    <SolidColorBrush x:Key="OverlayDarkBrush" Color="#66000000"/>
    
    <Color x:Key="DividerBrush.Color">#E0E0E0</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="#E0E0E0"/>
    
    <Color x:Key="ShadowBrush.Color">#1A000000</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="#1A000000"/>

</ResourceDictionary>

