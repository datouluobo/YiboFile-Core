<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- ========================================
         主题元数据 (Theme Metadata)
         ======================================== -->
    <sys:String x:Key="ThemeId">Forest</sys:String>
    <sys:String x:Key="ThemeDisplayName">森林绿</sys:String>
    <sys:String x:Key="ThemeDisplayNameEn">Forest Green</sys:String>
    <sys:String x:Key="ThemeDescription">舒缓视觉疲劳的柔和自然色调，平衡专业感与舒适度</sys:String>
    <sys:String x:Key="ThemeDescriptionEn">Soft natural tones to soothe visual fatigue, balancing professionalism and comfort</sys:String>
    <sys:String x:Key="ThemeAuthor">YiboSoft</sys:String>
    <sys:String x:Key="ThemeVersion">3.0.0</sys:String>
    
    <!-- 预览色彩 (Preview Colors) -->
    <sys:String x:Key="PreviewPrimaryColor">#43A047</sys:String>
    <sys:String x:Key="PreviewBackgroundColor">#FFFFFF</sys:String>
    <sys:String x:Key="PreviewSurfaceColor">#F8F9FA</sys:String>
    <sys:String x:Key="PreviewTextColor">#212529</sys:String>
    
    <!-- ========================================
         核心资源 (37个 Semantic Tokens)
         ======================================== -->
    
    <!-- 1. 背景类 (9个) -->
    <Color x:Key="BackgroundPrimaryBrush.Color">#141E14</Color>
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#141E14"/>       <!-- 主背景: 森林深绿 -->
    <Color x:Key="BackgroundSecondaryBrush.Color">#1E2B1E</Color>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#1E2B1E"/>     <!-- 次背景 -->
    <Color x:Key="BackgroundTertiaryBrush.Color">#293829</Color>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="#293829"/>      <!-- 三级背景 -->
    <Color x:Key="BackgroundElevatedBrush.Color">#344534</Color>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="#344534"/>      <!-- 对话框 -->
    <Color x:Key="TitleBarBackgroundBrush.Color">#101810</Color>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#101810"/>      <!-- 标题栏 -->
    <Color x:Key="NavigationRegionBrush.Color">#182418</Color>
    <SolidColorBrush x:Key="NavigationRegionBrush" Color="#182418"/>        <!-- 导航区 -->
    <Color x:Key="SidebarBackgroundBrush.Color">#0D140D</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0D140D"/>       <!-- 侧边栏 -->
    <Color x:Key="PaneFocusedBackgroundBrush.Color">#141E14</Color>
    <SolidColorBrush x:Key="PaneFocusedBackgroundBrush" Color="#141E14"/>   <!-- 焦点栏 -->
    <Color x:Key="PaneUnfocusedBackgroundBrush.Color">#182218</Color>
    <SolidColorBrush x:Key="PaneUnfocusedBackgroundBrush" Color="#182218"/> <!-- 非焦点栏 -->
    
    <!-- 2. 文本类 (6个) -->
    <Color x:Key="ForegroundPrimaryColor">#E0E6E0</Color>
    <Color x:Key="ForegroundPrimaryBrush.Color">#E0E6E0</Color>
    <SolidColorBrush x:Key="ForegroundPrimaryBrush" Color="#E0E6E0"/>       <!-- 主要文本: 淡绿白 -->
    <Color x:Key="ForegroundSecondaryBrush.Color">#A8B2A8</Color>
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="#A8B2A8"/>     <!-- 次要文本 -->
    <Color x:Key="ForegroundTertiaryBrush.Color">#7D857D</Color>
    <SolidColorBrush x:Key="ForegroundTertiaryBrush" Color="#7D857D"/>      <!-- 三级文本 -->
    <Color x:Key="ForegroundDisabledBrush.Color">#4D544D</Color>
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#4D544D"/>      <!-- 禁用文本 -->
    <Color x:Key="ForegroundOnAccentBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="ForegroundOnAccentBrush" Color="#FFFFFF"/>      <!-- 强调色上的文本 -->
    
    <!-- 3. 边框类 (3个) -->
    <Color x:Key="BorderDefaultBrush.Color">#344534</Color>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#344534"/>           <!-- 默认边框 -->
    <Color x:Key="BorderSubtleBrush.Color">#253425</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#253425"/>            <!-- 淡边框 -->
    <Color x:Key="BorderFocusBrush.Color">#43A047</Color>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#43A047"/>             <!-- 聚焦边框 -->
    
    <!-- 4. 强调色/交互 (7个) -->
    <Color x:Key="AccentColor">#43A047</Color>                              <!-- 强调 Color -->
    <Color x:Key="AccentHoverColor">#388E3C</Color>                         <!-- 悬停 Color -->
    <Color x:Key="AccentDefaultBrush.Color">#43A047</Color>
    <SolidColorBrush x:Key="AccentDefaultBrush" Color="#43A047"/>           <!-- 主强调色 -->
    <Color x:Key="AccentHoverBrush.Color">#388E3C</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#388E3C"/>             <!-- 悬停 -->
    <Color x:Key="AccentPressedBrush.Color">#004085</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#004085"/>           <!-- 按下 -->
    <Color x:Key="AccentSelectedBrush.Color">#64B5F6</Color>
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="#64B5F6"/>          <!-- 选中 -->
    <Color x:Key="AccentLightBrush.Color">#203A2B</Color>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#203A2B"/>             <!-- 浅强调色背景: 深色主题下使用深绿色保证文字对比度 -->
    
    <!-- 5. 控件状态 (4个) -->
    <Color x:Key="ControlDefaultBrush.Color">#344534</Color>
    <SolidColorBrush x:Key="ControlDefaultBrush" Color="#344534"/>          <!-- 控件默认: 同 Elevated -->
    <Color x:Key="ControlHoverBrush.Color">#425742</Color>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#425742"/>            <!-- 控件悬停: 稍亮 -->
    <Color x:Key="ControlPressedBrush.Color">#293829</Color>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#293829"/>          <!-- 控件按下: 同 Tertiary -->
    <Color x:Key="ControlDisabledBrush.Color">#1E2B1E</Color>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#1E2B1E"/>         <!-- 控件禁用 -->
    
    <!-- 6. 状态色 (4个) -->
    <Color x:Key="StatusSuccessBrush.Color">#28A745</Color>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#28A745"/>           <!-- 成功 -->
    <Color x:Key="StatusWarningBrush.Color">#FFC107</Color>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFC107"/>           <!-- 警告 -->
    <Color x:Key="StatusErrorBrush.Color">#DC3545</Color>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#DC3545"/>             <!-- 错误 -->
    <Color x:Key="StatusInfoBrush.Color">#17A2B8</Color>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#17A2B8"/>              <!-- 信息 -->
    
    <!-- 7. 特殊用途 (4个) -->
    <Color x:Key="TransparentBrush.Color">Transparent</Color>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>         <!-- 透明 -->
    <Color x:Key="OverlayBrush.Color">#80000000</Color>
    <SolidColorBrush x:Key="OverlayBrush" Color="#80000000"/>               <!-- 遮罩 -->
    <Color x:Key="OverlayLightBrush.Color">#30FFFFFF</Color>
    <SolidColorBrush x:Key="OverlayLightBrush" Color="#30FFFFFF"/>          <!-- 浅遮罩 -->
    <Color x:Key="OverlayDarkBrush.Color">#80000000</Color>
    <SolidColorBrush x:Key="OverlayDarkBrush" Color="#80000000"/>           <!-- 深遮罩 -->
    <Color x:Key="DividerBrush.Color">#1E2B1E</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="#1E2B1E"/>                 <!-- 分隔线 -->
    <Color x:Key="ShadowBrush.Color">#60000000</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="#60000000"/>                <!-- 阴影 -->
    

</ResourceDictionary>

