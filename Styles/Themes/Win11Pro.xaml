<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- ================================================================
         Theme: Win11 专业版 (Mica 蓝色系 v4.5)
         
         调优记录：
         针对“色彩偏黑”的反馈，提升了 15% 的蓝色通道饱和度，
         并整体抬升了 L 亮度阶梯，确保在非 OLED 屏幕上也能清晰辨识“蓝调”。
         ================================================================ -->

    <sys:String x:Key="ThemeId">Win11Pro</sys:String>
    <sys:String x:Key="ThemeDisplayName">沉浸蓝调</sys:String>
    <sys:String x:Key="ThemeDisplayNameEn">Immersive Blue</sys:String>
    <sys:String x:Key="ThemeDescription">深邃的蓝色背景配合多层次阴影，营造沉浸式视觉体验</sys:String>
    <sys:String x:Key="ThemeDescriptionEn">Deep blue background with multi-layered shadows for an immersive experience</sys:String>
    <sys:String x:Key="ThemeAuthor">YiboFile</sys:String>
    <sys:String x:Key="ThemeVersion">4.5.1</sys:String>
    
    <sys:String x:Key="PreviewPrimaryColor">#00A2EE</sys:String>
    <sys:String x:Key="PreviewBackgroundColor">#1E2B3E</sys:String>
    <sys:String x:Key="PreviewSurfaceColor">#28384D</sys:String>
    <sys:String x:Key="PreviewTextColor">#F0F4F8</sys:String>
    
    <!-- 1. 背景色谱 (9 tokens) — 强化蓝调 -->
    
    <!-- 主工作区：深海蓝 (Deep Sea Blue) -->
    <Color x:Key="BackgroundPrimaryBrush.Color">#1E2B3E</Color>
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#1E2B3E"/>
    
    <!-- 次级表面：略浅的深蓝 -->
    <Color x:Key="BackgroundSecondaryBrush.Color">#24344A</Color>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#24344A"/>
    
    <!-- 三级表面/悬浮： -->
    <Color x:Key="BackgroundTertiaryBrush.Color">#2B3D55</Color>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="#2B3D55"/>
    
    <!-- 抬升表面/弹出菜单 -->
    <Color x:Key="BackgroundElevatedBrush.Color">#364D6B</Color>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="#364D6B"/>
    
    <!-- 标题栏：与所有深色主题兼容的沉稳蓝 -->
    <Color x:Key="TitleBarBackgroundBrush.Color">#182332</Color>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#182332"/>
    
    <!-- 导航区域 -->
    <Color x:Key="NavigationRegionBrush.Color">#182332</Color>
    <SolidColorBrush x:Key="NavigationRegionBrush" Color="#182332"/>
    
    <!-- 侧边栏：藏蓝 (Midnight Navy) -->
    <Color x:Key="SidebarBackgroundBrush.Color">#141C26</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#141C26"/>
    
    <!-- 面板氛围色 -->
    <Color x:Key="PaneFocusedBackgroundBrush.Color">#223146</Color>
    <SolidColorBrush x:Key="PaneFocusedBackgroundBrush" Color="#223146"/>
    
    <Color x:Key="PaneUnfocusedBackgroundBrush.Color">#1A2433</Color>
    <SolidColorBrush x:Key="PaneUnfocusedBackgroundBrush" Color="#1A2433"/>
    
    <!-- 2. 文本色谱 -->
    <Color x:Key="ForegroundPrimaryBrush.Color">#F0F4F8</Color>
    <SolidColorBrush x:Key="ForegroundPrimaryBrush" Color="#F0F4F8"/>
    
    <Color x:Key="ForegroundSecondaryBrush.Color">#AAB8C9</Color>
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="#AAB8C9"/>
    
    <Color x:Key="ForegroundTertiaryBrush.Color">#7D8B9C</Color>
    <SolidColorBrush x:Key="ForegroundTertiaryBrush" Color="#7D8B9C"/>
    
    <Color x:Key="ForegroundDisabledBrush.Color">#4A5A6A</Color>
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#4A5A6A"/>
    
    <Color x:Key="ForegroundOnAccentBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="ForegroundOnAccentBrush" Color="#FFFFFF"/>
    <Color x:Key="ForegroundPrimaryColor">#F0F4F8</Color>
    
    <!-- 3. 边框 (低对比度蓝灰) -->
    <Color x:Key="BorderDefaultBrush.Color">#2E4057</Color>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#2E4057"/>
    
    <Color x:Key="BorderSubtleBrush.Color">#243447</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#243447"/>
    
    <Color x:Key="BorderFocusBrush.Color">#00A2EE</Color>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#00A2EE"/>
    
    <!-- 4. 强调色 (Win11 冰蓝系) -->
    <Color x:Key="AccentDefaultBrush.Color">#00A2EE</Color>
    <SolidColorBrush x:Key="AccentDefaultBrush" Color="#00A2EE"/>
    
    <Color x:Key="AccentHoverBrush.Color">#33B5F2</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#33B5F2"/>
    
    <Color x:Key="AccentPressedBrush.Color">#0088CC</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0088CC"/>
    
    <Color x:Key="AccentSelectedBrush.Color">#2200A2EE</Color>
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="#2200A2EE"/>
    
    <Color x:Key="AccentLightBrush.Color">#1533B5F2</Color>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#1533B5F2"/>
    <Color x:Key="AccentColor">#00A2EE</Color>
    <Color x:Key="AccentHoverColor">#33B5F2</Color>
    
    <!-- 5. 控件状态 -->
    <Color x:Key="ControlDefaultBrush.Color">#2B3D55</Color>
    <SolidColorBrush x:Key="ControlDefaultBrush" Color="#2B3D55"/>
    
    <Color x:Key="ControlHoverBrush.Color">#425D80</Color>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#425D80"/>
    
    <Color x:Key="ControlPressedBrush.Color">#405B7A</Color>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#405B7A"/>
    
    <Color x:Key="ControlDisabledBrush.Color">#1A2432</Color>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#1A2432"/>
    
    <!-- 6. 状态色 -->
    <Color x:Key="StatusSuccessBrush.Color">#47D16C</Color>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#47D16C"/>
    
    <Color x:Key="StatusWarningBrush.Color">#FFB938</Color>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFB938"/>
    
    <Color x:Key="StatusErrorBrush.Color">#FF6B6B</Color>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF6B6B"/>
    
    <Color x:Key="StatusInfoBrush.Color">#00A2EE</Color>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#00A2EE"/>
    
    <!-- 7. 特殊用途 -->
    <Color x:Key="TransparentBrush.Color">Transparent</Color>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    
    <Color x:Key="OverlayBrush.Color">#CC0D1219</Color>
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC0D1219"/>
    
    <Color x:Key="OverlayLightBrush.Color">#1AFFFFFF</Color>
    <SolidColorBrush x:Key="OverlayLightBrush" Color="#1AFFFFFF"/>
    
    <Color x:Key="DividerBrush.Color">#2A384A</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="#2A384A"/>
    
    <Color x:Key="ShadowBrush.Color">#70000000</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="#70000000"/>
    
</ResourceDictionary>
