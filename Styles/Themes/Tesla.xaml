<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- ========================================
         Tesla 浅色主题 — 灵感来自 Tesla 设计语言
         极简：纯白画布 + 碳黑文字 + 电光蓝点缀
         无阴影、无渐变、极致减法
         ======================================== -->
    
    <!-- 主题元数据 -->
    <sys:String x:Key="ThemeId">Tesla</sys:String>
    <sys:String x:Key="ThemeDisplayName">极光</sys:String>
    <sys:String x:Key="ThemeDisplayNameEn">Aurora</sys:String>
    <sys:String x:Key="ThemeDescription">纯白画布、极致减法、电光蓝点缀。无阴影、无渐变、摄影级纯净</sys:String>
    <sys:String x:Key="ThemeDescriptionEn">Pure white canvas, radical subtraction, Electric Blue accent. No shadows, no gradients, photography-grade purity.</sys:String>
    <sys:String x:Key="ThemeAuthor">YiboSoft</sys:String>
    <sys:String x:Key="ThemeVersion">1.0.0</sys:String>
    
    <!-- 预览色彩 -->
    <sys:String x:Key="PreviewPrimaryColor">#3E6AE1</sys:String>
    <sys:String x:Key="PreviewBackgroundColor">#FFFFFF</sys:String>
    <sys:String x:Key="PreviewSurfaceColor">#F4F4F4</sys:String>
    <sys:String x:Key="PreviewTextColor">#171A20</sys:String>
    
    <!-- ========================================
         核心资源 (37个 Semantic Tokens)
         ======================================== -->
    
    <!-- 1. 背景类 (9个) — 纯白画布 + 浅灰替代面 -->
    <Color x:Key="BackgroundPrimaryBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#FFFFFF"/>
    
    <Color x:Key="BackgroundSecondaryBrush.Color">#F4F4F4</Color>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#F4F4F4"/>
    
    <Color x:Key="BackgroundTertiaryBrush.Color">#EEEEEE</Color>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="#EEEEEE"/>
    
    <Color x:Key="BackgroundElevatedBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="#FFFFFF"/>
    
    <Color x:Key="TitleBarBackgroundBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FFFFFF"/>
    
    <Color x:Key="NavigationRegionBrush.Color">#F4F4F4</Color>
    <SolidColorBrush x:Key="NavigationRegionBrush" Color="#F4F4F4"/>
    
    <Color x:Key="SidebarBackgroundBrush.Color">#F4F4F4</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F4F4F4"/>
    
    <Color x:Key="PaneFocusedBackgroundBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="PaneFocusedBackgroundBrush" Color="#FFFFFF"/>
    
    <Color x:Key="PaneUnfocusedBackgroundBrush.Color">#FAFAFA</Color>
    <SolidColorBrush x:Key="PaneUnfocusedBackgroundBrush" Color="#FAFAFA"/>

    <!-- 2. 文本类 (6个) — 碳黑→石墨→银灰层级 -->
    <Color x:Key="ForegroundPrimaryBrush.Color">#171A20</Color>
    <SolidColorBrush x:Key="ForegroundPrimaryBrush" Color="#171A20"/>
    
    <Color x:Key="ForegroundSecondaryBrush.Color">#393C41</Color>
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="#393C41"/>
    
    <Color x:Key="ForegroundTertiaryBrush.Color">#5C5E62</Color>
    <SolidColorBrush x:Key="ForegroundTertiaryBrush" Color="#5C5E62"/>
    
    <Color x:Key="ForegroundDisabledBrush.Color">#8E8E8E</Color>
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#8E8E8E"/>
    
    <Color x:Key="ForegroundOnAccentBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="ForegroundOnAccentBrush" Color="#FFFFFF"/>
    
    <!-- Legacy Key -->
    <Color x:Key="ForegroundPrimaryColor">#171A20</Color>
    
    <!-- 3. 边框类 (3个) — 极细线、精确 -->
    <Color x:Key="BorderDefaultBrush.Color">#D0D1D2</Color>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#D0D1D2"/>
    
    <Color x:Key="BorderSubtleBrush.Color">#EEEEEE</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#EEEEEE"/>
    
    <Color x:Key="BorderFocusBrush.Color">#3E6AE1</Color>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#3E6AE1"/>
    
    <!-- 4. 强调色/交互 (7个) — 电光蓝为唯一色彩 -->
    <Color x:Key="AccentDefaultBrush.Color">#3E6AE1</Color>
    <SolidColorBrush x:Key="AccentDefaultBrush" Color="#3E6AE1"/>
    
    <Color x:Key="AccentHoverBrush.Color">#2B5CC7</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2B5CC7"/>
    
    <Color x:Key="AccentPressedBrush.Color">#1A4DAE</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1A4DAE"/>
    
    <Color x:Key="AccentSelectedBrush.Color">#6B93EC</Color>
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="#6B93EC"/>
    
    <Color x:Key="AccentLightBrush.Color">#EBF1FD</Color>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#EBF1FD"/>
    
    <!-- Legacy Keys -->
    <Color x:Key="AccentColor">#3E6AE1</Color>
    <Color x:Key="AccentHoverColor">#2B5CC7</Color>
    
    <!-- 5. 控件状态 (4个) — 极淡交互反馈 -->
    <Color x:Key="ControlDefaultBrush.Color">#EEEEEE</Color>
    <SolidColorBrush x:Key="ControlDefaultBrush" Color="#EEEEEE"/>
    
    <Color x:Key="ControlHoverBrush.Color">#E0E0E0</Color>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#E0E0E0"/>
    
    <Color x:Key="ControlPressedBrush.Color">#D0D1D2</Color>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#D0D1D2"/>
    
    <Color x:Key="ControlDisabledBrush.Color">#F4F4F4</Color>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#F4F4F4"/>
    
    <!-- 6. 状态色 (4个) -->
    <Color x:Key="StatusSuccessBrush.Color">#4CAF50</Color>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#4CAF50"/>
    
    <Color x:Key="StatusWarningBrush.Color">#FFC107</Color>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFC107"/>
    
    <Color x:Key="StatusErrorBrush.Color">#E53935</Color>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#E53935"/>
    
    <Color x:Key="StatusInfoBrush.Color">#3E6AE1</Color>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#3E6AE1"/>
    
    <!-- 7. 特殊用途 (5个) - 无阴影！符合 Tesla 设计哲学 -->
    <Color x:Key="TransparentBrush.Color">Transparent</Color>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    
    <Color x:Key="OverlayBrush.Color">#66000000</Color>
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>
    
    <Color x:Key="OverlayLightBrush.Color">#33000000</Color>
    <SolidColorBrush x:Key="OverlayLightBrush" Color="#33000000"/>
    
    <Color x:Key="OverlayDarkBrush.Color">#66000000</Color>
    <SolidColorBrush x:Key="OverlayDarkBrush" Color="#66000000"/>
    
    <Color x:Key="DividerBrush.Color">#EEEEEE</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="#EEEEEE"/>
    
    <!-- Tesla 无阴影 — 透明零强度 -->
    <Color x:Key="ShadowBrush.Color">#00000000</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="#00000000"/>

</ResourceDictionary>
