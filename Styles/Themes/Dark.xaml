<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- ========================================
         主题元数据 (Theme Metadata)
         ======================================== -->
    <sys:String x:Key="ThemeId">Dark</sys:String>
    <sys:String x:Key="ThemeDisplayName">深色模式</sys:String>
    <sys:String x:Key="ThemeDescription">低亮度深色主题，适合夜间使用，护眼舒适</sys:String>
    <sys:String x:Key="ThemeAuthor">YiboSoft</sys:String>
    <sys:String x:Key="ThemeVersion">3.0.0</sys:String>
    
    <!-- 预览色彩 (Preview Colors) -->
    <sys:String x:Key="PreviewPrimaryColor">#4DA3FF</sys:String>
    <sys:String x:Key="PreviewBackgroundColor">#202020</sys:String>
    <sys:String x:Key="PreviewSurfaceColor">#2D2D2D</sys:String>
    <sys:String x:Key="PreviewTextColor">#FFFFFF</sys:String>
    
    <!-- ========================================
         核心资源 (37个 Semantic Tokens)
         ======================================== -->
    
    <!-- 1. 背景类 (9个) -->
    <Color x:Key="BackgroundPrimaryBrush.Color">#202020</Color>
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{DynamicResource BackgroundPrimaryBrush.Color}"/>
    
    <Color x:Key="BackgroundSecondaryBrush.Color">#2D2D2D</Color>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{DynamicResource BackgroundSecondaryBrush.Color}"/>
    
    <Color x:Key="BackgroundTertiaryBrush.Color">#333333</Color>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="{DynamicResource BackgroundTertiaryBrush.Color}"/>
    
    <Color x:Key="BackgroundElevatedBrush.Color">#2D2D2D</Color>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="{DynamicResource BackgroundElevatedBrush.Color}"/>
    
    <Color x:Key="TitleBarBackgroundBrush.Color">#2D2D2D</Color>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{DynamicResource TitleBarBackgroundBrush.Color}"/>
    
    <Color x:Key="NavigationRegionBrush.Color">#181818</Color>
    <SolidColorBrush x:Key="NavigationRegionBrush" Color="{DynamicResource NavigationRegionBrush.Color}"/>
    
    <Color x:Key="SidebarBackgroundBrush.Color">#1A1A1A</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{DynamicResource SidebarBackgroundBrush.Color}"/>
    
    <Color x:Key="PaneFocusedBackgroundBrush.Color">#202020</Color>
    <SolidColorBrush x:Key="PaneFocusedBackgroundBrush" Color="{DynamicResource PaneFocusedBackgroundBrush.Color}"/>
    
    <Color x:Key="PaneUnfocusedBackgroundBrush.Color">#1C1C1C</Color>
    <SolidColorBrush x:Key="PaneUnfocusedBackgroundBrush" Color="{DynamicResource PaneUnfocusedBackgroundBrush.Color}"/>
    
    <!-- 2. 文本类 (6个) -->
    <Color x:Key="ForegroundPrimaryBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="ForegroundPrimaryBrush" Color="{DynamicResource ForegroundPrimaryBrush.Color}"/>
    
    <Color x:Key="ForegroundSecondaryBrush.Color">#B0B0B0</Color>
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="{DynamicResource ForegroundSecondaryBrush.Color}"/>
    
    <Color x:Key="ForegroundTertiaryBrush.Color">#888888</Color>
    <SolidColorBrush x:Key="ForegroundTertiaryBrush" Color="{DynamicResource ForegroundTertiaryBrush.Color}"/>
    
    <Color x:Key="ForegroundDisabledBrush.Color">#6C757D</Color>
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="{DynamicResource ForegroundDisabledBrush.Color}"/>
    
    <Color x:Key="ForegroundOnAccentBrush.Color">#000000</Color>
    <SolidColorBrush x:Key="ForegroundOnAccentBrush" Color="{DynamicResource ForegroundOnAccentBrush.Color}"/>
    
    <!-- Legacy Key -->
    <Color x:Key="ForegroundPrimaryColor">#FFFFFF</Color>
    
    <!-- 3. 边框类 (3个) -->
    <Color x:Key="BorderDefaultBrush.Color">#404040</Color>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{DynamicResource BorderDefaultBrush.Color}"/>
    
    <Color x:Key="BorderSubtleBrush.Color">#3A3A3A</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource BorderSubtleBrush.Color}"/>
    
    <Color x:Key="BorderFocusBrush.Color">#4DA3FF</Color>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{DynamicResource BorderFocusBrush.Color}"/>
    
    <!-- 4. 强调色/交互 (7个) -->
    <Color x:Key="AccentDefaultBrush.Color">#4DA3FF</Color>
    <SolidColorBrush x:Key="AccentDefaultBrush" Color="{DynamicResource AccentDefaultBrush.Color}"/>
    
    <Color x:Key="AccentHoverBrush.Color">#80BFFF</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverBrush.Color}"/>
    
    <Color x:Key="AccentPressedBrush.Color">#2196F3</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedBrush.Color}"/>
    
    <Color x:Key="AccentSelectedBrush.Color">#64B5F6</Color>
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="{DynamicResource AccentSelectedBrush.Color}"/>
    
    <Color x:Key="AccentLightBrush.Color">#1E3A5F</Color>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{DynamicResource AccentLightBrush.Color}"/>
    
    <!-- Legacy Keys -->
    <Color x:Key="AccentColor">#4DA3FF</Color>
    <Color x:Key="AccentHoverColor">#80BFFF</Color>
    
    <!-- 5. 控件状态 (4个) -->
    <Color x:Key="ControlDefaultBrush.Color">#3A3A3A</Color>
    <SolidColorBrush x:Key="ControlDefaultBrush" Color="{DynamicResource ControlDefaultBrush.Color}"/>
    
    <Color x:Key="ControlHoverBrush.Color">#4A4A4A</Color>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{DynamicResource ControlHoverBrush.Color}"/>
    
    <Color x:Key="ControlPressedBrush.Color">#555555</Color>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{DynamicResource ControlPressedBrush.Color}"/>
    
    <Color x:Key="ControlDisabledBrush.Color">#2A2A2A</Color>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="{DynamicResource ControlDisabledBrush.Color}"/>
    
    <!-- 6. 状态色 (4个) -->
    <Color x:Key="StatusSuccessBrush.Color">#4CAF50</Color>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{DynamicResource StatusSuccessBrush.Color}"/>
    
    <Color x:Key="StatusWarningBrush.Color">#FFC107</Color>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{DynamicResource StatusWarningBrush.Color}"/>
    
    <Color x:Key="StatusErrorBrush.Color">#E57373</Color>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{DynamicResource StatusErrorBrush.Color}"/>
    
    <Color x:Key="StatusInfoBrush.Color">#64B5F6</Color>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{DynamicResource StatusInfoBrush.Color}"/>
    
    <!-- 7. 特殊用途 (4个) -->
    <Color x:Key="TransparentBrush.Color">Transparent</Color>
    <SolidColorBrush x:Key="TransparentBrush" Color="{DynamicResource TransparentBrush.Color}"/>
    
    <Color x:Key="OverlayBrush.Color">#66FFFFFF</Color>
    <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource OverlayBrush.Color}"/>
    
    <Color x:Key="OverlayLightBrush.Color">#33FFFFFF</Color>
    <SolidColorBrush x:Key="OverlayLightBrush" Color="{DynamicResource OverlayLightBrush.Color}"/>
    
    <Color x:Key="DividerBrush.Color">#404040</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource DividerBrush.Color}"/>
    
    <Color x:Key="ShadowBrush.Color">#66000000</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="{DynamicResource ShadowBrush.Color}"/>
    

</ResourceDictionary>
