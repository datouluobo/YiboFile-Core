<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- ========================================
         主题元数据 (Theme Metadata)
         ======================================== -->
    <sys:String x:Key="ThemeId">Dark</sys:String>
    <sys:String x:Key="ThemeDisplayName">暗黑模式</sys:String>
    <sys:String x:Key="ThemeDisplayNameEn">Dark Mode</sys:String>
    <sys:String x:Key="ThemeDescription">低亮度深色方案，适合夜间使用，减轻视觉疲劳</sys:String>
    <sys:String x:Key="ThemeDescriptionEn">Low-brightness dark scheme for nighttime use to reduce eye strain</sys:String>
    <sys:String x:Key="ThemeAuthor">YiboSoft</sys:String>
    <sys:String x:Key="ThemeVersion">3.0.0</sys:String>
    
    <!-- 预览色彩 (Preview Colors) -->
    <sys:String x:Key="PreviewPrimaryColor">#4DA3FF</sys:String>
    <sys:String x:Key="PreviewBackgroundColor">#202020</sys:String>
    <sys:String x:Key="PreviewSurfaceColor">#2D2D2D</sys:String>
    <sys:String x:Key="PreviewTextColor">#FFFFFF</sys:String>
    
    <!-- ========================================
         核心资源 (37个 Semantic Tokens)
         ======================================== -->
    
    <!-- 1. 背景类 (9个) -->
    <Color x:Key="BackgroundPrimaryBrush.Color">#202020</Color>
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#202020"/>
    
    <Color x:Key="BackgroundSecondaryBrush.Color">#2D2D2D</Color>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#2D2D2D"/>
    
    <Color x:Key="BackgroundTertiaryBrush.Color">#333333</Color>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="#333333"/>
    
    <Color x:Key="BackgroundElevatedBrush.Color">#2D2D2D</Color>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="#2D2D2D"/>
    
    <Color x:Key="TitleBarBackgroundBrush.Color">#2D2D2D</Color>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#2D2D2D"/>
    
    <Color x:Key="NavigationRegionBrush.Color">#181818</Color>
    <SolidColorBrush x:Key="NavigationRegionBrush" Color="#181818"/>
    
    <Color x:Key="SidebarBackgroundBrush.Color">#1A1A1A</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1A1A1A"/>
    
    <Color x:Key="PaneFocusedBackgroundBrush.Color">#202020</Color>
    <SolidColorBrush x:Key="PaneFocusedBackgroundBrush" Color="#202020"/>
    
    <Color x:Key="PaneUnfocusedBackgroundBrush.Color">#1C1C1C</Color>
    <SolidColorBrush x:Key="PaneUnfocusedBackgroundBrush" Color="#1C1C1C"/>
    
    <!-- 2. 文本类 (6个) -->
    <Color x:Key="ForegroundPrimaryBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="ForegroundPrimaryBrush" Color="#FFFFFF"/>
    
    <Color x:Key="ForegroundSecondaryBrush.Color">#B0B0B0</Color>
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="#B0B0B0"/>
    
    <Color x:Key="ForegroundTertiaryBrush.Color">#888888</Color>
    <SolidColorBrush x:Key="ForegroundTertiaryBrush" Color="#888888"/>
    
    <Color x:Key="ForegroundDisabledBrush.Color">#6C757D</Color>
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#6C757D"/>
    
    <Color x:Key="ForegroundOnAccentBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="ForegroundOnAccentBrush" Color="#FFFFFF"/>
    
    <!-- Legacy Key -->
    <Color x:Key="ForegroundPrimaryColor">#FFFFFF</Color>
    
    <!-- 3. 边框类 (3个) -->
    <Color x:Key="BorderDefaultBrush.Color">#404040</Color>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#404040"/>
    
    <Color x:Key="BorderSubtleBrush.Color">#3A3A3A</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#3A3A3A"/>
    
    <Color x:Key="BorderFocusBrush.Color">#4DA3FF</Color>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#4DA3FF"/>
    
    <!-- 4. 强调色/交互 (7个) -->
    <Color x:Key="AccentDefaultBrush.Color">#4DA3FF</Color>
    <SolidColorBrush x:Key="AccentDefaultBrush" Color="#4DA3FF"/>
    
    <Color x:Key="AccentHoverBrush.Color">#80BFFF</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#80BFFF"/>
    
    <Color x:Key="AccentPressedBrush.Color">#2196F3</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2196F3"/>
    
    <Color x:Key="AccentSelectedBrush.Color">#64B5F6</Color>
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="#64B5F6"/>
    
    <Color x:Key="AccentLightBrush.Color">#1E3A5F</Color>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#1E3A5F"/>
    
    <!-- Legacy Keys -->
    <Color x:Key="AccentColor">#4DA3FF</Color>
    <Color x:Key="AccentHoverColor">#80BFFF</Color>
    
    <!-- 5. 控件状态 (4个) -->
    <Color x:Key="ControlDefaultBrush.Color">#3A3A3A</Color>
    <SolidColorBrush x:Key="ControlDefaultBrush" Color="#3A3A3A"/>
    
    <Color x:Key="ControlHoverBrush.Color">#4A4A4A</Color>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#4A4A4A"/>
    
    <Color x:Key="ControlPressedBrush.Color">#555555</Color>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#555555"/>
    
    <Color x:Key="ControlDisabledBrush.Color">#2A2A2A</Color>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#2A2A2A"/>
    
    <!-- 6. 状态色 (4个) -->
    <Color x:Key="StatusSuccessBrush.Color">#4CAF50</Color>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#4CAF50"/>
    
    <Color x:Key="StatusWarningBrush.Color">#FFC107</Color>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFC107"/>
    
    <Color x:Key="StatusErrorBrush.Color">#E57373</Color>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#E57373"/>
    
    <Color x:Key="StatusInfoBrush.Color">#64B5F6</Color>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#64B5F6"/>
    
    <!-- 7. 特殊用途 (4个) -->
    <Color x:Key="TransparentBrush.Color">Transparent</Color>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    
    <Color x:Key="OverlayBrush.Color">#66FFFFFF</Color>
    <SolidColorBrush x:Key="OverlayBrush" Color="#66FFFFFF"/>
    
    <Color x:Key="OverlayLightBrush.Color">#33FFFFFF</Color>
    <SolidColorBrush x:Key="OverlayLightBrush" Color="#33FFFFFF"/>
    
    <Color x:Key="DividerBrush.Color">#404040</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="#404040"/>
    
    <Color x:Key="ShadowBrush.Color">#66000000</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="#66000000"/>
    

</ResourceDictionary>

