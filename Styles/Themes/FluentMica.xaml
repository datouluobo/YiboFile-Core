<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- ========================================
         主题元数据 (Theme Metadata) - Fluent Mica
         ======================================== -->
    <sys:String x:Key="ThemeId">FluentMica</sys:String>
    <sys:String x:Key="ThemeDisplayName">云母沉浸 (Fluent Mica)</sys:String>
    <sys:String x:Key="ThemeDescription">基于 Windows 11 Fluent Design 的沉浸式主题，支持 Mica/Acrylic 视觉感官</sys:String>
    <sys:String x:Key="ThemeAuthor">Antigravity</sys:String>
    <sys:String x:Key="ThemeVersion">1.0.0</sys:String>
    
    <!-- 预览色彩 (Preview Colors) -->
    <sys:String x:Key="PreviewPrimaryColor">#0078D4</sys:String>
    <sys:String x:Key="PreviewBackgroundColor">#202020</sys:String> <!-- 虽然是半透明，但在预览中显示基色 -->
    <sys:String x:Key="PreviewSurfaceColor">#2D2D2D</sys:String>
    <sys:String x:Key="PreviewTextColor">#FFFFFF</sys:String>
    
    <!-- ========================================
         核心资源 (Semantic Tokens)
         依照概念图：深色背景、蓝/紫色强调、半透明质感
         ======================================== -->
    
    <!-- 1. 背景类 (9个) -->
    <!-- 背景采用深灰色基调，以便后续在 Win11 下应用 Mica 效果 -->
    <Color x:Key="BackgroundPrimaryBrush.Color">#202020</Color>
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="#202020"/>
    
    <!-- Secondary/Tertiary 通常对应侧边栏和列表背景，概念图中侧边栏更暗且有透明感 -->
    <Color x:Key="BackgroundSecondaryBrush.Color">#1A1A1A</Color>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#1A1A1A"/>
    
    <Color x:Key="BackgroundTertiaryBrush.Color">#252525</Color>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="#252525"/>
    
    <Color x:Key="BackgroundElevatedBrush.Color">#323232</Color>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="#323232"/>
    
    <Color x:Key="TitleBarBackgroundBrush.Color">#00000000</Color> <!-- 透明标题栏，交由 Window 处理融合 -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="Transparent"/>
    
    <Color x:Key="NavigationRegionBrush.Color">#1C1C1C</Color>
    <SolidColorBrush x:Key="NavigationRegionBrush" Color="#1C1C1C"/>
    
    <Color x:Key="SidebarBackgroundBrush.Color">#181818</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#181818" Opacity="0.8"/>
    
    <Color x:Key="PaneFocusedBackgroundBrush.Color">#202020</Color>
    <SolidColorBrush x:Key="PaneFocusedBackgroundBrush" Color="#202020"/>
    
    <Color x:Key="PaneUnfocusedBackgroundBrush.Color">#1E1E1E</Color>
    <SolidColorBrush x:Key="PaneUnfocusedBackgroundBrush" Color="#1E1E1E"/>
    
    <!-- 2. 文本类 (6个) -->
    <Color x:Key="ForegroundPrimaryBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="ForegroundPrimaryBrush" Color="#FFFFFF"/>
    
    <Color x:Key="ForegroundSecondaryBrush.Color">#EBEBEB</Color>
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="#EBEBEB" Opacity="0.8"/>
    
    <Color x:Key="ForegroundTertiaryBrush.Color">#B0B0B0</Color>
    <SolidColorBrush x:Key="ForegroundTertiaryBrush" Color="#B0B0B0"/>
    
    <Color x:Key="ForegroundDisabledBrush.Color">#666666</Color>
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#666666"/>
    
    <Color x:Key="ForegroundOnAccentBrush.Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="ForegroundOnAccentBrush" Color="#FFFFFF"/>
    <Color x:Key="ForegroundPrimaryColor">#FFFFFF</Color>
    
    <!-- 3. 边框类 (3个) -->
    <Color x:Key="BorderDefaultBrush.Color">#3F3F3F</Color>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#3F3F3F"/>
    
    <Color x:Key="BorderSubtleBrush.Color">#2A2A2A</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2A2A2A"/>
    
    <!-- 强调色边框使用概念图中的蓝紫色 -->
    <Color x:Key="BorderFocusBrush.Color">#6D5BFF</Color>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#6D5BFF"/>
    
    <!-- 4. 强调色 (7个) -->
    <!-- 基于概念图中的紫色渐变感，提取中间值 -->
    <Color x:Key="AccentDefaultBrush.Color">#7A6AFF</Color>
    <SolidColorBrush x:Key="AccentDefaultBrush" Color="#7A6AFF"/>
    
    <Color x:Key="AccentHoverBrush.Color">#9589FF</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9589FF"/>
    
    <Color x:Key="AccentPressedBrush.Color">#5F4DFF</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#5F4DFF"/>
    
    <Color x:Key="AccentSelectedBrush.Color">#40B0B0B0</Color>
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="#40B0B0B0"/>
    
    <Color x:Key="AccentLightBrush.Color">#207A6AFF</Color>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#207A6AFF"/>
    <Color x:Key="AccentColor">#7A6AFF</Color>
    <Color x:Key="AccentHoverColor">#9589FF</Color>
    
    <!-- 5. 控件状态 (4个) -->
    <Color x:Key="ControlDefaultBrush.Color">#2D2D2D</Color> 
    <SolidColorBrush x:Key="ControlDefaultBrush" Color="#2D2D2D"/>
    
    <Color x:Key="ControlHoverBrush.Color">#3D3D3D</Color>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3D3D3D"/>
    
    <Color x:Key="ControlPressedBrush.Color">#454545</Color>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#454545"/>
    
    <Color x:Key="ControlDisabledBrush.Color">#252525</Color>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#252525"/>
    
    <!-- 6. 状态色 (4个) -->
    <Color x:Key="StatusSuccessBrush.Color">#6CCB5F</Color>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#6CCB5F"/>
    
    <Color x:Key="StatusWarningBrush.Color">#FFB900</Color>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFB900"/>
    
    <Color x:Key="StatusErrorBrush.Color">#FF6363</Color>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF6363"/>
    
    <Color x:Key="StatusInfoBrush.Color">#60CDFF</Color>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#60CDFF"/>
    
    <!-- 7. 特殊用途 (5个) -->
    <Color x:Key="TransparentBrush.Color">Transparent</Color>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    
    <Color x:Key="OverlayBrush.Color">#80000000</Color>
    <SolidColorBrush x:Key="OverlayBrush" Color="#80000000"/>
    
    <Color x:Key="OverlayLightBrush.Color">#30FFFFFF</Color>
    <SolidColorBrush x:Key="OverlayLightBrush" Color="#30FFFFFF"/>
    
    <Color x:Key="DividerBrush.Color">#1FFFFFFF</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="#1FFFFFFF"/>
    
    <Color x:Key="ShadowBrush.Color">#80000000</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="#80000000"/>
    
</ResourceDictionary>
