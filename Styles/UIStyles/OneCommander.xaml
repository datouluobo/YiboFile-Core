<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ======== 元数据 (3键) ======== -->
    <sys:String x:Key="UIStyleId">OneCommander</sys:String>
    <sys:String x:Key="UIStyleDisplayName">双栏极简</sys:String>
    <sys:String x:Key="UIStyleDisplayNameEn">Dual Pane Minimalist</sys:String>
    <sys:String x:Key="UIStyleDescription">极致紧凑的双栏布局，配备方形标签页与全宽高亮，适合高效管理</sys:String>
    <sys:String x:Key="UIStyleDescriptionEn">Compact dual-pane layout with square tabs and wide selection, designed for high efficiency</sys:String>

    <!-- ================================================================
         A. Tab 标签页 (14键) — 方形平坦 + 底部彩色指示条
         ================================================================ -->
    <CornerRadius x:Key="UI.TabItem.CornerRadius">0</CornerRadius>
    <Thickness x:Key="UI.TabItem.Margin">0,0</Thickness>
    <Thickness x:Key="UI.TabItem.Padding">2,0</Thickness>
    <sys:Double x:Key="UI.TabItem.Height">30</sys:Double>
    <SolidColorBrush x:Key="UI.TabItem.ActiveBackground" Color="{DynamicResource AccentLightBrush.Color}"/>
    <Thickness x:Key="UI.TabItem.ActiveBorderThickness">1,0,1,0</Thickness>
    <Visibility x:Key="UI.TabItem.SeparatorVisibility">Visible</Visibility>
    <sys:Double x:Key="UI.TabItem.SeparatorHeight">16</sys:Double>
    <!-- 底部粗指示条: 与 Original/Geek 的顶部细指示条形成对比 -->
    <Visibility x:Key="UI.TabItem.ActiveIndicatorVisibility">Visible</Visibility>
    <VerticalAlignment x:Key="UI.TabItem.ActiveIndicatorPosition">Bottom</VerticalAlignment>
    <sys:Double x:Key="UI.TabItem.ActiveIndicatorHeight">2</sys:Double>
    <Thickness x:Key="UI.TabItem.ActiveIndicatorMargin">0</Thickness>
    <sys:Double x:Key="UI.TabItem.ActiveIndicatorRadius">0</sys:Double>
    <SolidColorBrush x:Key="UI.TabItem.ActiveIndicatorColor" Color="{DynamicResource AccentColor}"/>
    <!-- 🆕 无阴影 + 边框(左右侧) + SemiBold (文件管理器风) -->
    <DropShadowEffect x:Key="UI.TabItem.ActiveShadowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="Transparent"/>
    <SolidColorBrush x:Key="UI.TabItem.ActiveBorderBrush" Color="{DynamicResource BorderDefaultBrush.Color}"/>
    <FontWeight x:Key="UI.TabItem.ActiveFontWeight">SemiBold</FontWeight>


    <!-- ================================================================
         B. 工具栏按钮 (5键) — 紧凑 + 有边框 + 小图标
         ================================================================ -->
    <CornerRadius x:Key="UI.ToolbarButton.CornerRadius">2</CornerRadius>
    <Thickness x:Key="UI.ToolbarButton.BorderThickness">1</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Padding">4,0</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Margin">1,0</Thickness>
    <sys:Double x:Key="UI.ToolbarButton.Height">26</sys:Double>

    <!-- ================================================================
         C. 侧边栏/导航列表 (6键) — 极致紧凑、全宽高亮
         ================================================================ -->
    <CornerRadius x:Key="UI.Sidebar.ItemCornerRadius">0</CornerRadius>
    <Thickness x:Key="UI.Sidebar.ItemMargin">0</Thickness>
    <Visibility x:Key="UI.Sidebar.ActiveIndicatorVisibility">Collapsed</Visibility>
    <Thickness x:Key="UI.Sidebar.ItemPadding">6,3</Thickness>
    <sys:Double x:Key="UI.Sidebar.ItemHeight">24</sys:Double>
    <SolidColorBrush x:Key="UI.Sidebar.ActiveBackground" Color="{DynamicResource AccentColor}"/>

    <!-- ================================================================
         D. 地址栏 (2键) — 方形 + 有边框
         ================================================================ -->
    <CornerRadius x:Key="UI.AddressBar.CornerRadius">0</CornerRadius>
    <Thickness x:Key="UI.AddressBar.BorderThickness">1</Thickness>

    <!-- ================================================================
         E. 文件列表行 (6键) — 极致紧凑 + 底线 + 全宽
         ================================================================ -->
    <CornerRadius x:Key="UI.FileList.RowCornerRadius">0</CornerRadius>
    <Thickness x:Key="UI.FileList.RowMargin">0</Thickness>
    <Thickness x:Key="UI.FileList.RowBorderThickness">0,0,0,1</Thickness>
    <sys:Double x:Key="UI.FileList.RowMinHeight">26</sys:Double>
    <Thickness x:Key="UI.FileList.RowPadding">2,0</Thickness>
    <Thickness x:Key="UI.FileList.SelectedBorderThickness">0</Thickness>

    <!-- ================================================================
         F. 文件列表列头 (4键) — 紧凑 + 底线 + 粗体
         ================================================================ -->
    <Thickness x:Key="UI.ColumnHeader.Padding">6,4</Thickness>
    <Thickness x:Key="UI.ColumnHeader.BorderThickness">0,0,0,1</Thickness>
    <FontWeight x:Key="UI.ColumnHeader.FontWeight">SemiBold</FontWeight>
    <sys:Double x:Key="UI.ColumnHeader.Height">26</sys:Double>

    <!-- ================================================================
         G. 分割器 (5键) — 可见细线 + 抓手
         ================================================================ -->
    <Visibility x:Key="UI.Splitter.VisibleLine">Collapsed</Visibility>
    <sys:Double x:Key="UI.Splitter.Width">4</sys:Double>
    <sys:Double x:Key="UI.Splitter.LineThickness">1</sys:Double>
    <Visibility x:Key="UI.Splitter.HoverShowGripDot">Visible</Visibility>
    <sys:Double x:Key="UI.Splitter.CollapseButtonOpacity">0.5</sys:Double>

    <!-- ================================================================
         H. 滚动条 (6键) — 经典模式，始终可见
         ================================================================ -->
    <CornerRadius x:Key="UI.ScrollBar.ThumbCornerRadius">1</CornerRadius>
    <sys:Double x:Key="UI.ScrollBar.ThumbWidth">6</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbHoverWidth">8</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbOpacity">0.4</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbHoverOpacity">0.7</sys:Double>
    <sys:String x:Key="UI.ScrollBar.Mode">Classic</sys:String>

    <!-- ================================================================
         I. 通用控件圆角 (6键) — 极小圆角 / 直角
         ================================================================ -->
    <CornerRadius x:Key="UI.Button.CornerRadius">2</CornerRadius>
    <CornerRadius x:Key="UI.TextBox.CornerRadius">2</CornerRadius>
    <CornerRadius x:Key="UI.ComboBox.CornerRadius">2</CornerRadius>
    <CornerRadius x:Key="UI.GroupBox.CornerRadius">0</CornerRadius>
    <CornerRadius x:Key="UI.ContextMenu.CornerRadius">4</CornerRadius>
    <CornerRadius x:Key="UI.MenuItem.CornerRadius">2</CornerRadius>

    <!-- ================================================================
         J. 对话框 (2键)
         ================================================================ -->
    <CornerRadius x:Key="UI.Dialog.CornerRadius">4</CornerRadius>
    <CornerRadius x:Key="UI.Dialog.ButtonCornerRadius">2</CornerRadius>

</ResourceDictionary>
