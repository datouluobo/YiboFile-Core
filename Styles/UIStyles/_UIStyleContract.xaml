<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================
         UIStyle Contract (UI风格合约)
         ================================================================
         本文件定义所有 UI 风格必须提供的 59 个 Token 的默认值。
         作为加载链的第一层, 保证任何键缺失都不会导致崩溃。
         默认值基于 Original 风格。

         Token 分两类:
         - 形状 Token: CornerRadius, Thickness, Double, Visibility 等
         - 颜色映射 Token: 引用 Theme Semantic Token 的 Brush
           (只允许引用 DynamicResource, 不允许硬编码 #XXXXXX)

         新增风格时, 请确保覆盖以下所有键。
         可运行 scripts/Validate-Contracts.ps1 验证完整性。
         ================================================================ -->

    <!-- ======== 元数据 (3键) ======== -->
    <sys:String x:Key="UIStyleId">Original</sys:String>
    <sys:String x:Key="UIStyleDisplayName">经典</sys:String>
    <sys:String x:Key="UIStyleDescription">经典紧凑布局，扁平全宽选中、分割线、顶部小指示条</sys:String>

    <!-- ================================================================
         A. Tab 标签页 (17键, 含3个新增键)
         ================================================================ -->
    <CornerRadius x:Key="UI.TabItem.CornerRadius">6,6,0,0</CornerRadius>
    <Thickness x:Key="UI.TabItem.Margin">1,0</Thickness>
    <Thickness x:Key="UI.TabItem.Padding">1,0</Thickness>
    <sys:Double x:Key="UI.TabItem.Height">34</sys:Double>
    <SolidColorBrush x:Key="UI.TabItem.ActiveBackground" Color="Transparent"/>
    <Thickness x:Key="UI.TabItem.ActiveBorderThickness">0</Thickness>
    <Visibility x:Key="UI.TabItem.SeparatorVisibility">Visible</Visibility>
    <sys:Double x:Key="UI.TabItem.SeparatorHeight">14</sys:Double>
    <Visibility x:Key="UI.TabItem.ActiveIndicatorVisibility">Visible</Visibility>
    <VerticalAlignment x:Key="UI.TabItem.ActiveIndicatorPosition">Top</VerticalAlignment>
    <sys:Double x:Key="UI.TabItem.ActiveIndicatorHeight">3</sys:Double>
    <Thickness x:Key="UI.TabItem.ActiveIndicatorMargin">6,0,6,0</Thickness>
    <sys:Double x:Key="UI.TabItem.ActiveIndicatorRadius">1.5</sys:Double>
    <SolidColorBrush x:Key="UI.TabItem.ActiveIndicatorColor" Color="{DynamicResource AccentColor}"/>
    <!-- 🆕 活动 Tab 阴影 (BlurRadius=0 表示无阴影) -->
    <DropShadowEffect x:Key="UI.TabItem.ActiveShadowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="Transparent"/>
    <!-- 🆕 活动 Tab 边框颜色 -->
    <SolidColorBrush x:Key="UI.TabItem.ActiveBorderBrush" Color="Transparent"/>
    <!-- 🆕 活动 Tab 文字粗细 -->
    <FontWeight x:Key="UI.TabItem.ActiveFontWeight">SemiBold</FontWeight>


    <!-- ================================================================
         B. 工具栏按钮 (5键)
         ================================================================ -->
    <CornerRadius x:Key="UI.ToolbarButton.CornerRadius">4</CornerRadius>
    <Thickness x:Key="UI.ToolbarButton.BorderThickness">1</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Padding">10,0</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Margin">1,0</Thickness>
    <sys:Double x:Key="UI.ToolbarButton.Height">32</sys:Double>

    <!-- ================================================================
         C. 侧边栏/导航列表 (6键)
         ================================================================ -->
    <CornerRadius x:Key="UI.Sidebar.ItemCornerRadius">0</CornerRadius>
    <Thickness x:Key="UI.Sidebar.ItemMargin">0</Thickness>
    <Visibility x:Key="UI.Sidebar.ActiveIndicatorVisibility">Collapsed</Visibility>
    <Thickness x:Key="UI.Sidebar.ItemPadding">8,6</Thickness>
    <sys:Double x:Key="UI.Sidebar.ItemHeight">30</sys:Double>
    <SolidColorBrush x:Key="UI.Sidebar.ActiveBackground" Color="{DynamicResource AccentColor}"/>

    <!-- ================================================================
         D. 地址栏 (2键)
         ================================================================ -->
    <CornerRadius x:Key="UI.AddressBar.CornerRadius">4</CornerRadius>
    <Thickness x:Key="UI.AddressBar.BorderThickness">1</Thickness>

    <!-- ================================================================
         E. 文件列表行 (6键)
         ================================================================ -->
    <CornerRadius x:Key="UI.FileList.RowCornerRadius">0</CornerRadius>
    <Thickness x:Key="UI.FileList.RowMargin">0</Thickness>
    <Thickness x:Key="UI.FileList.RowBorderThickness">0,0,0,1</Thickness>
    <sys:Double x:Key="UI.FileList.RowMinHeight">34</sys:Double>
    <Thickness x:Key="UI.FileList.RowPadding">4,0</Thickness>
    <Thickness x:Key="UI.FileList.SelectedBorderThickness">0</Thickness>

    <!-- ================================================================
         F. 文件列表列头 (4键)
         ================================================================ -->
    <Thickness x:Key="UI.ColumnHeader.Padding">12,8</Thickness>
    <Thickness x:Key="UI.ColumnHeader.BorderThickness">0,0,0,1</Thickness>
    <FontWeight x:Key="UI.ColumnHeader.FontWeight">Normal</FontWeight>
    <sys:Double x:Key="UI.ColumnHeader.Height">32</sys:Double>

    <!-- ================================================================
         G. 分割器 (5键)
         ================================================================ -->
    <Visibility x:Key="UI.Splitter.VisibleLine">Collapsed</Visibility>
    <sys:Double x:Key="UI.Splitter.Width">6</sys:Double>
    <sys:Double x:Key="UI.Splitter.LineThickness">1</sys:Double>
    <Visibility x:Key="UI.Splitter.HoverShowGripDot">Visible</Visibility>
    <sys:Double x:Key="UI.Splitter.CollapseButtonOpacity">0.5</sys:Double>

    <!-- ================================================================
         H. 滚动条 (6键)
         ================================================================ -->
    <CornerRadius x:Key="UI.ScrollBar.ThumbCornerRadius">3</CornerRadius>
    <sys:Double x:Key="UI.ScrollBar.ThumbWidth">4</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbHoverWidth">8</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbOpacity">0.3</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbHoverOpacity">0.6</sys:Double>
    <sys:String x:Key="UI.ScrollBar.Mode">Overlay</sys:String>

    <!-- ================================================================
         I. 通用控件圆角 (6键)
         ================================================================ -->
    <CornerRadius x:Key="UI.Button.CornerRadius">4</CornerRadius>
    <CornerRadius x:Key="UI.TextBox.CornerRadius">4</CornerRadius>
    <CornerRadius x:Key="UI.ComboBox.CornerRadius">4</CornerRadius>
    <CornerRadius x:Key="UI.GroupBox.CornerRadius">4</CornerRadius>
    <CornerRadius x:Key="UI.ContextMenu.CornerRadius">6</CornerRadius>
    <CornerRadius x:Key="UI.MenuItem.CornerRadius">2</CornerRadius>

    <!-- ================================================================
         J. 对话框 (2键)
         ================================================================ -->
    <CornerRadius x:Key="UI.Dialog.CornerRadius">8</CornerRadius>
    <CornerRadius x:Key="UI.Dialog.ButtonCornerRadius">4</CornerRadius>

</ResourceDictionary>
