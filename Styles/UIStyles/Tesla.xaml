<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================
         Tesla UI 风格 — 极简精确
         4px 圆角、无阴影、无装饰、精确工程感
         ================================================================ -->

    <!-- ======== 元数据 ======== -->
    <sys:String x:Key="UIStyleId">Tesla</sys:String>
    <sys:String x:Key="UIStyleDisplayName">Tesla</sys:String>
    <sys:String x:Key="UIStyleDisplayNameEn">Tesla</sys:String>
    <sys:String x:Key="UIStyleDescription">Tesla 极简风格：4px 精确圆角、无阴影、极细线、产品优先纯净布局</sys:String>
    <sys:String x:Key="UIStyleDescriptionEn">Tesla minimal: 4px precise radius, no shadows, ultra-thin lines, product-first clean layout</sys:String>

    <!-- ================================================================
         A. Tab 标签页 (14键) — 顶部指示条、无阴影、无分隔线
         ================================================================ -->
    <CornerRadius x:Key="UI.TabItem.CornerRadius">4,4,0,0</CornerRadius>
    <Thickness x:Key="UI.TabItem.Margin">0,0</Thickness>
    <Thickness x:Key="UI.TabItem.Padding">12,0</Thickness>
    <sys:Double x:Key="UI.TabItem.Height">34</sys:Double>
    <SolidColorBrush x:Key="UI.TabItem.ActiveBackground" Color="{DynamicResource AccentLightBrush.Color}"/>
    <Thickness x:Key="UI.TabItem.ActiveBorderThickness">0</Thickness>
    <Visibility x:Key="UI.TabItem.SeparatorVisibility">Collapsed</Visibility>
    <sys:Double x:Key="UI.TabItem.SeparatorHeight">14</sys:Double>
    <Visibility x:Key="UI.TabItem.ActiveIndicatorVisibility">Visible</Visibility>
    <VerticalAlignment x:Key="UI.TabItem.ActiveIndicatorPosition">Top</VerticalAlignment>
    <sys:Double x:Key="UI.TabItem.ActiveIndicatorHeight">2</sys:Double>
    <Thickness x:Key="UI.TabItem.ActiveIndicatorMargin">4,0,4,0</Thickness>
    <sys:Double x:Key="UI.TabItem.ActiveIndicatorRadius">1</sys:Double>
    <SolidColorBrush x:Key="UI.TabItem.ActiveIndicatorColor" Color="{DynamicResource AccentColor}"/>
    <!-- Tesla 无阴影 -->
    <DropShadowEffect x:Key="UI.TabItem.ActiveShadowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="Transparent"/>
    <SolidColorBrush x:Key="UI.TabItem.ActiveBorderBrush" Color="Transparent"/>
    <FontWeight x:Key="UI.TabItem.ActiveFontWeight">SemiBold</FontWeight>

    <!-- ================================================================
         B. 工具栏按钮 (5键) — 无边框、纯平、精确 4px
         ================================================================ -->
    <CornerRadius x:Key="UI.ToolbarButton.CornerRadius">4</CornerRadius>
    <Thickness x:Key="UI.ToolbarButton.BorderThickness">0</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Padding">8,0</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Margin">0,0</Thickness>
    <sys:Double x:Key="UI.ToolbarButton.Height">32</sys:Double>

    <!-- ================================================================
         C. 侧边栏/导航列表 (6键) — 全宽选中、无指示器
         ================================================================ -->
    <CornerRadius x:Key="UI.Sidebar.ItemCornerRadius">0</CornerRadius>
    <Thickness x:Key="UI.Sidebar.ItemMargin">0,1</Thickness>
    <Visibility x:Key="UI.Sidebar.ActiveIndicatorVisibility">Collapsed</Visibility>
    <Thickness x:Key="UI.Sidebar.ItemPadding">12,6</Thickness>
    <sys:Double x:Key="UI.Sidebar.ItemHeight">30</sys:Double>
    <SolidColorBrush x:Key="UI.Sidebar.ActiveBackground" Color="{DynamicResource AccentColor}"/>

    <!-- ================================================================
         D. 地址栏 (2键) — 4px 圆角、1px 细线
         ================================================================ -->
    <CornerRadius x:Key="UI.AddressBar.CornerRadius">4</CornerRadius>
    <Thickness x:Key="UI.AddressBar.BorderThickness">1</Thickness>

    <!-- ================================================================
         E. 文件列表行 (6键) — 无分割线、利用留白区分
         ================================================================ -->
    <CornerRadius x:Key="UI.FileList.RowCornerRadius">0</CornerRadius>
    <Thickness x:Key="UI.FileList.RowMargin">0</Thickness>
    <Thickness x:Key="UI.FileList.RowBorderThickness">0</Thickness>
    <sys:Double x:Key="UI.FileList.RowMinHeight">36</sys:Double>
    <Thickness x:Key="UI.FileList.RowPadding">8,0</Thickness>
    <Thickness x:Key="UI.FileList.SelectedBorderThickness">0</Thickness>

    <!-- ================================================================
         F. 文件列表列头 (4键) — 无分割线、轻微间距
         ================================================================ -->
    <Thickness x:Key="UI.ColumnHeader.Padding">8,8</Thickness>
    <Thickness x:Key="UI.ColumnHeader.BorderThickness">0</Thickness>
    <FontWeight x:Key="UI.ColumnHeader.FontWeight">500</FontWeight>
    <sys:Double x:Key="UI.ColumnHeader.Height">34</sys:Double>

    <!-- ================================================================
         G. 分割器 (5键) — 极细、不突兀
         ================================================================ -->
    <Visibility x:Key="UI.Splitter.VisibleLine">Collapsed</Visibility>
    <sys:Double x:Key="UI.Splitter.Width">4</sys:Double>
    <sys:Double x:Key="UI.Splitter.LineThickness">1</sys:Double>
    <Visibility x:Key="UI.Splitter.HoverShowGripDot">Collapsed</Visibility>
    <sys:Double x:Key="UI.Splitter.CollapseButtonOpacity">0.3</sys:Double>

    <!-- ================================================================
         H. 滚动条 (6键) — 超薄浮层、仅 hover 显示
         ================================================================ -->
    <CornerRadius x:Key="UI.ScrollBar.ThumbCornerRadius">2</CornerRadius>
    <sys:Double x:Key="UI.ScrollBar.ThumbWidth">3</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbHoverWidth">6</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbOpacity">0.15</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbHoverOpacity">0.4</sys:Double>
    <sys:String x:Key="UI.ScrollBar.Mode">Overlay</sys:String>

    <!-- ================================================================
         I. 通用控件圆角 (6键) — 全部 4px，精确一致
         ================================================================ -->
    <CornerRadius x:Key="UI.Button.CornerRadius">4</CornerRadius>
    <CornerRadius x:Key="UI.TextBox.CornerRadius">4</CornerRadius>
    <CornerRadius x:Key="UI.ComboBox.CornerRadius">4</CornerRadius>
    <CornerRadius x:Key="UI.GroupBox.CornerRadius">4</CornerRadius>
    <CornerRadius x:Key="UI.ContextMenu.CornerRadius">4</CornerRadius>
    <CornerRadius x:Key="UI.MenuItem.CornerRadius">2</CornerRadius>

    <!-- ================================================================
         J. 对话框 (2键)
         ================================================================ -->
    <CornerRadius x:Key="UI.Dialog.CornerRadius">8</CornerRadius>
    <CornerRadius x:Key="UI.Dialog.ButtonCornerRadius">4</CornerRadius>

</ResourceDictionary>
