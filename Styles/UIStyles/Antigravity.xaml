<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ======== 元数据 (3键) ======== -->
    <sys:String x:Key="UIStyleId">Antigravity</sys:String>
    <sys:String x:Key="UIStyleDisplayName">引力感</sys:String>
    <sys:String x:Key="UIStyleDescription">模仿 Antigravity IDE 的现代风格：胶囊 Tab、柔和圆角、舒适留白、无分隔线</sys:String>

    <!-- ================================================================
         A. Tab 标签页 (14键) — 胶囊形、填充式、无指示条
         ================================================================ -->
    <CornerRadius x:Key="UI.TabItem.CornerRadius">20</CornerRadius>
    <Thickness x:Key="UI.TabItem.Margin">3,6</Thickness>
    <Thickness x:Key="UI.TabItem.Padding">14,4</Thickness>
    <sys:Double x:Key="UI.TabItem.Height">34</sys:Double>
    <!-- 胶囊背景填充: 活动 Tab 用凸出的填充色 -->
    <SolidColorBrush x:Key="UI.TabItem.ActiveBackground" Color="{DynamicResource AccentLightBrush.Color}"/>
    <Thickness x:Key="UI.TabItem.ActiveBorderThickness">0</Thickness>
    <Visibility x:Key="UI.TabItem.SeparatorVisibility">Collapsed</Visibility>
    <sys:Double x:Key="UI.TabItem.SeparatorHeight">14</sys:Double>
    <!-- 不需要指示条，靠胶囊背景区分 -->
    <Visibility x:Key="UI.TabItem.ActiveIndicatorVisibility">Collapsed</Visibility>
    <VerticalAlignment x:Key="UI.TabItem.ActiveIndicatorPosition">Bottom</VerticalAlignment>
    <sys:Double x:Key="UI.TabItem.ActiveIndicatorHeight">2</sys:Double>
    <Thickness x:Key="UI.TabItem.ActiveIndicatorMargin">8,0,8,0</Thickness>
    <sys:Double x:Key="UI.TabItem.ActiveIndicatorRadius">1</sys:Double>
    <SolidColorBrush x:Key="UI.TabItem.ActiveIndicatorColor" Color="{DynamicResource AccentColor}"/>
    <!-- 🆕 柔和阴影 + 无边框 + SemiBold (现代 IDE 胶囊浮动感) -->
    <DropShadowEffect x:Key="UI.TabItem.ActiveShadowEffect" BlurRadius="10" ShadowDepth="1" Opacity="0.15" Color="Black" Direction="270"/>
    <SolidColorBrush x:Key="UI.TabItem.ActiveBorderBrush" Color="Transparent"/>
    <FontWeight x:Key="UI.TabItem.ActiveFontWeight">SemiBold</FontWeight>


    <!-- ================================================================
         B. 工具栏按钮 (5键) — 无边框 + 大圆角 + 宽松间距
         ================================================================ -->
    <CornerRadius x:Key="UI.ToolbarButton.CornerRadius">12</CornerRadius>
    <Thickness x:Key="UI.ToolbarButton.BorderThickness">0</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Padding">16,4</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Margin">3,0</Thickness>
    <sys:Double x:Key="UI.ToolbarButton.Height">34</sys:Double>

    <!-- ================================================================
         C. 侧边栏/导航列表 (6键) — 圆润、适度留白、左侧指示条
         ================================================================ -->
    <CornerRadius x:Key="UI.Sidebar.ItemCornerRadius">10</CornerRadius>
    <Thickness x:Key="UI.Sidebar.ItemMargin">6,2</Thickness>
    <Visibility x:Key="UI.Sidebar.ActiveIndicatorVisibility">Visible</Visibility>
    <Thickness x:Key="UI.Sidebar.ItemPadding">14,8</Thickness>
    <sys:Double x:Key="UI.Sidebar.ItemHeight">36</sys:Double>
    <SolidColorBrush x:Key="UI.Sidebar.ActiveBackground" Color="{DynamicResource AccentLightBrush.Color}"/>

    <!-- ================================================================
         D. 地址栏 (2键) — 胶囊形 + 无边框
         ================================================================ -->
    <CornerRadius x:Key="UI.AddressBar.CornerRadius">20</CornerRadius>
    <Thickness x:Key="UI.AddressBar.BorderThickness">0</Thickness>

    <!-- ================================================================
         E. 文件列表行 (6键) — 适度圆角 + 内缩 + 无底线
         ================================================================ -->
    <CornerRadius x:Key="UI.FileList.RowCornerRadius">10</CornerRadius>
    <Thickness x:Key="UI.FileList.RowMargin">8,2</Thickness>
    <Thickness x:Key="UI.FileList.RowBorderThickness">0</Thickness>
    <sys:Double x:Key="UI.FileList.RowMinHeight">40</sys:Double>
    <Thickness x:Key="UI.FileList.RowPadding">10,4</Thickness>
    <Thickness x:Key="UI.FileList.SelectedBorderThickness">0</Thickness>

    <!-- ================================================================
         F. 文件列表列头 (4键) — 无底线 + 适中内距
         ================================================================ -->
    <Thickness x:Key="UI.ColumnHeader.Padding">14,8</Thickness>
    <Thickness x:Key="UI.ColumnHeader.BorderThickness">0</Thickness>
    <FontWeight x:Key="UI.ColumnHeader.FontWeight">Normal</FontWeight>
    <sys:Double x:Key="UI.ColumnHeader.Height">36</sys:Double>

    <!-- ================================================================
         G. 分割器 (5键) — 隐形分割 + 无抓手
         ================================================================ -->
    <Visibility x:Key="UI.Splitter.VisibleLine">Collapsed</Visibility>
    <sys:Double x:Key="UI.Splitter.Width">8</sys:Double>
    <sys:Double x:Key="UI.Splitter.LineThickness">1</sys:Double>
    <Visibility x:Key="UI.Splitter.HoverShowGripDot">Collapsed</Visibility>
    <sys:Double x:Key="UI.Splitter.CollapseButtonOpacity">0.2</sys:Double>

    <!-- ================================================================
         H. 滚动条 (6键) — 覆盖式、纤细
         ================================================================ -->
    <CornerRadius x:Key="UI.ScrollBar.ThumbCornerRadius">5</CornerRadius>
    <sys:Double x:Key="UI.ScrollBar.ThumbWidth">3</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbHoverWidth">6</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbOpacity">0.2</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbHoverOpacity">0.5</sys:Double>
    <sys:String x:Key="UI.ScrollBar.Mode">Overlay</sys:String>

    <!-- ================================================================
         I. 通用控件圆角 (6键) — 统一大圆角
         ================================================================ -->
    <CornerRadius x:Key="UI.Button.CornerRadius">10</CornerRadius>
    <CornerRadius x:Key="UI.TextBox.CornerRadius">10</CornerRadius>
    <CornerRadius x:Key="UI.ComboBox.CornerRadius">10</CornerRadius>
    <CornerRadius x:Key="UI.GroupBox.CornerRadius">10</CornerRadius>
    <CornerRadius x:Key="UI.ContextMenu.CornerRadius">12</CornerRadius>
    <CornerRadius x:Key="UI.MenuItem.CornerRadius">6</CornerRadius>

    <!-- ================================================================
         J. 对话框 (2键)
         ================================================================ -->
    <CornerRadius x:Key="UI.Dialog.CornerRadius">16</CornerRadius>
    <CornerRadius x:Key="UI.Dialog.ButtonCornerRadius">10</CornerRadius>

</ResourceDictionary>
