<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================
         UIStyle: MacOS (圆润)
         类 macOS 的大圆角风格: 大胶囊 Tab、舒适留白、底部宽指示条
         ================================================================ -->

    <!-- ======== 元数据 (3键) ======== -->
    <sys:String x:Key="UIStyleId">MacOS</sys:String>
    <sys:String x:Key="UIStyleDisplayName">圆润质感</sys:String>
    <sys:String x:Key="UIStyleDisplayNameEn">Rounded Aesthetic</sys:String>
    <sys:String x:Key="UIStyleDescription">采用大圆角、胶囊按钮与分层阴影，营造精致灵活的现代感</sys:String>
    <sys:String x:Key="UIStyleDescriptionEn">Refined rounded corners, capsule buttons, and layered shadows for a modern aesthetic</sys:String>

    <!-- ================================================================
         A. Tab 标签页 (14键) — 大胶囊 + 填充背景 + 无指示条
         ================================================================ -->
    <CornerRadius x:Key="UI.TabItem.CornerRadius">16</CornerRadius>
    <Thickness x:Key="UI.TabItem.Margin">5,7</Thickness>
    <Thickness x:Key="UI.TabItem.Padding">14,4</Thickness>
    <sys:Double x:Key="UI.TabItem.Height">40</sys:Double>
    <!-- 胶囊填充式: 靠背景色区分，不需要指示条 -->
    <SolidColorBrush x:Key="UI.TabItem.ActiveBackground" Color="{DynamicResource AccentLightBrush.Color}"/>
    <Thickness x:Key="UI.TabItem.ActiveBorderThickness">0</Thickness>
    <Visibility x:Key="UI.TabItem.SeparatorVisibility">Collapsed</Visibility>
    <sys:Double x:Key="UI.TabItem.SeparatorHeight">14</sys:Double>
    <Visibility x:Key="UI.TabItem.ActiveIndicatorVisibility">Collapsed</Visibility>
    <VerticalAlignment x:Key="UI.TabItem.ActiveIndicatorPosition">Top</VerticalAlignment>
    <sys:Double x:Key="UI.TabItem.ActiveIndicatorHeight">3</sys:Double>
    <Thickness x:Key="UI.TabItem.ActiveIndicatorMargin">6,0,6,0</Thickness>
    <sys:Double x:Key="UI.TabItem.ActiveIndicatorRadius">1.5</sys:Double>
    <SolidColorBrush x:Key="UI.TabItem.ActiveIndicatorColor" Color="{DynamicResource AccentColor}"/>
    <!-- 🆕 柔和阴影 + 无边框 + SemiBold (胶囊悬浮感) -->
    <DropShadowEffect x:Key="UI.TabItem.ActiveShadowEffect" BlurRadius="8" ShadowDepth="1" Opacity="0.12" Color="Black" Direction="270"/>
    <SolidColorBrush x:Key="UI.TabItem.ActiveBorderBrush" Color="Transparent"/>
    <FontWeight x:Key="UI.TabItem.ActiveFontWeight">SemiBold</FontWeight>


    <!-- ================================================================
         B. 工具栏按钮 (5键) — 药丸形、无边框、宽松
         ================================================================ -->
    <CornerRadius x:Key="UI.ToolbarButton.CornerRadius">14</CornerRadius>
    <Thickness x:Key="UI.ToolbarButton.BorderThickness">0</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Padding">16,6</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Margin">4,0</Thickness>
    <sys:Double x:Key="UI.ToolbarButton.Height">38</sys:Double>

    <!-- ================================================================
         C. 侧边栏/导航列表 (6键) — 大圆角、宽松间距、无指示条
         ================================================================ -->
    <CornerRadius x:Key="UI.Sidebar.ItemCornerRadius">12</CornerRadius>
    <Thickness x:Key="UI.Sidebar.ItemMargin">8,3</Thickness>
    <Visibility x:Key="UI.Sidebar.ActiveIndicatorVisibility">Collapsed</Visibility>
    <Thickness x:Key="UI.Sidebar.ItemPadding">16,10</Thickness>
    <sys:Double x:Key="UI.Sidebar.ItemHeight">40</sys:Double>
    <SolidColorBrush x:Key="UI.Sidebar.ActiveBackground" Color="{DynamicResource AccentColor}"/>

    <!-- ================================================================
         D. 地址栏 (2键) — 大胶囊
         ================================================================ -->
    <CornerRadius x:Key="UI.AddressBar.CornerRadius">14</CornerRadius>
    <Thickness x:Key="UI.AddressBar.BorderThickness">0</Thickness>

    <!-- ================================================================
         E. 文件列表行 (6键) — 大圆角、宽松内缩、左侧选中线
         ================================================================ -->
    <CornerRadius x:Key="UI.FileList.RowCornerRadius">12</CornerRadius>
    <Thickness x:Key="UI.FileList.RowMargin">10,3</Thickness>
    <Thickness x:Key="UI.FileList.RowBorderThickness">0</Thickness>
    <sys:Double x:Key="UI.FileList.RowMinHeight">46</sys:Double>
    <Thickness x:Key="UI.FileList.RowPadding">16,6</Thickness>
    <!-- 选中时左侧2px强调线 -->
    <Thickness x:Key="UI.FileList.SelectedBorderThickness">2,0,0,0</Thickness>

    <!-- ================================================================
         F. 文件列表列头 (4键) — 无底线 + SemiBold
         ================================================================ -->
    <Thickness x:Key="UI.ColumnHeader.Padding">16,10</Thickness>
    <Thickness x:Key="UI.ColumnHeader.BorderThickness">0</Thickness>
    <FontWeight x:Key="UI.ColumnHeader.FontWeight">SemiBold</FontWeight>
    <sys:Double x:Key="UI.ColumnHeader.Height">40</sys:Double>

    <!-- ================================================================
         G. 分割器 (5键) — 隐形
         ================================================================ -->
    <Visibility x:Key="UI.Splitter.VisibleLine">Collapsed</Visibility>
    <sys:Double x:Key="UI.Splitter.Width">10</sys:Double>
    <sys:Double x:Key="UI.Splitter.LineThickness">1</sys:Double>
    <Visibility x:Key="UI.Splitter.HoverShowGripDot">Collapsed</Visibility>
    <sys:Double x:Key="UI.Splitter.CollapseButtonOpacity">0.3</sys:Double>

    <!-- ================================================================
         H. 滚动条 (6键) — 覆盖式
         ================================================================ -->
    <CornerRadius x:Key="UI.ScrollBar.ThumbCornerRadius">6</CornerRadius>
    <sys:Double x:Key="UI.ScrollBar.ThumbWidth">4</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbHoverWidth">8</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbOpacity">0.25</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbHoverOpacity">0.5</sys:Double>
    <sys:String x:Key="UI.ScrollBar.Mode">Overlay</sys:String>

    <!-- ================================================================
         I. 通用控件圆角 (6键) — 一致的大圆角
         ================================================================ -->
    <CornerRadius x:Key="UI.Button.CornerRadius">12</CornerRadius>
    <CornerRadius x:Key="UI.TextBox.CornerRadius">12</CornerRadius>
    <CornerRadius x:Key="UI.ComboBox.CornerRadius">12</CornerRadius>
    <CornerRadius x:Key="UI.GroupBox.CornerRadius">10</CornerRadius>
    <CornerRadius x:Key="UI.ContextMenu.CornerRadius">12</CornerRadius>
    <CornerRadius x:Key="UI.MenuItem.CornerRadius">8</CornerRadius>

    <!-- ================================================================
         J. 对话框 (2键)
         ================================================================ -->
    <CornerRadius x:Key="UI.Dialog.CornerRadius">20</CornerRadius>
    <CornerRadius x:Key="UI.Dialog.ButtonCornerRadius">10</CornerRadius>

</ResourceDictionary>
