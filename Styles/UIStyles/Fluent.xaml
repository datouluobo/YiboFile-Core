<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ======== 元数据 (3键) ======== -->
    <sys:String x:Key="UIStyleId">Fluent</sys:String>
    <sys:String x:Key="UIStyleDisplayName">流畅设计</sys:String>
    <sys:String x:Key="UIStyleDescription">Windows 11 风格，大圆角内缩卡片、无分割线、隐藏边界感</sys:String>

    <!-- ================================================================
         A. Tab 标签页 (14键)
         ================================================================ -->
    <CornerRadius x:Key="UI.TabItem.CornerRadius">8,8,8,8</CornerRadius>
    <Thickness x:Key="UI.TabItem.Margin">4,5</Thickness>
    <Thickness x:Key="UI.TabItem.Padding">6,2</Thickness>
    <sys:Double x:Key="UI.TabItem.Height">36</sys:Double>
    
    <!-- 颜色引用改为 Theme Token，而不再硬编码 #FFFFFF -->
    <SolidColorBrush x:Key="UI.TabItem.ActiveBackground" Color="{DynamicResource BackgroundElevatedBrush.Color}"/>
    <Thickness x:Key="UI.TabItem.ActiveBorderThickness">0</Thickness>
    <Visibility x:Key="UI.TabItem.SeparatorVisibility">Collapsed</Visibility>
    <sys:Double x:Key="UI.TabItem.SeparatorHeight">14</sys:Double>
    
    <Visibility x:Key="UI.TabItem.ActiveIndicatorVisibility">Collapsed</Visibility>
    <VerticalAlignment x:Key="UI.TabItem.ActiveIndicatorPosition">Top</VerticalAlignment>
    <sys:Double x:Key="UI.TabItem.ActiveIndicatorHeight">3</sys:Double>
    <Thickness x:Key="UI.TabItem.ActiveIndicatorMargin">0</Thickness>
    <sys:Double x:Key="UI.TabItem.ActiveIndicatorRadius">0</sys:Double>
    <SolidColorBrush x:Key="UI.TabItem.ActiveIndicatorColor" Color="{DynamicResource AccentColor}"/>

    <!-- ================================================================
         B. 工具栏按钮 (5键)
         ================================================================ -->
    <CornerRadius x:Key="UI.ToolbarButton.CornerRadius">8</CornerRadius>
    <Thickness x:Key="UI.ToolbarButton.BorderThickness">0</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Padding">14,4</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Margin">2,0</Thickness>
    <sys:Double x:Key="UI.ToolbarButton.Height">34</sys:Double>

    <!-- ================================================================
         C. 侧边栏/导航列表 (6键)
         ================================================================ -->
    <CornerRadius x:Key="UI.Sidebar.ItemCornerRadius">8</CornerRadius>
    <Thickness x:Key="UI.Sidebar.ItemMargin">6,3</Thickness>
    <Visibility x:Key="UI.Sidebar.ActiveIndicatorVisibility">Visible</Visibility>
    <Thickness x:Key="UI.Sidebar.ItemPadding">12,8</Thickness>
    <sys:Double x:Key="UI.Sidebar.ItemHeight">36</sys:Double>
    <SolidColorBrush x:Key="UI.Sidebar.ActiveBackground" Color="{DynamicResource AccentLightBrush.Color}"/>

    <!-- ================================================================
         D. 地址栏 (2键)
         ================================================================ -->
    <CornerRadius x:Key="UI.AddressBar.CornerRadius">16</CornerRadius>
    <Thickness x:Key="UI.AddressBar.BorderThickness">0</Thickness>

    <!-- ================================================================
         E. 文件列表行 (6键)
         ================================================================ -->
    <CornerRadius x:Key="UI.FileList.RowCornerRadius">8</CornerRadius>
    <Thickness x:Key="UI.FileList.RowMargin">8,3</Thickness>
    <Thickness x:Key="UI.FileList.RowBorderThickness">0</Thickness>
    <sys:Double x:Key="UI.FileList.RowMinHeight">40</sys:Double>
    <Thickness x:Key="UI.FileList.RowPadding">8,4</Thickness>
    <Thickness x:Key="UI.FileList.SelectedBorderThickness">0</Thickness>

    <!-- ================================================================
         F. 文件列表列头 (4键)
         ================================================================ -->
    <Thickness x:Key="UI.ColumnHeader.Padding">14,10</Thickness>
    <Thickness x:Key="UI.ColumnHeader.BorderThickness">0</Thickness>
    <FontWeight x:Key="UI.ColumnHeader.FontWeight">Normal</FontWeight>
    <sys:Double x:Key="UI.ColumnHeader.Height">36</sys:Double>

    <!-- ================================================================
         G. 分割器 (5键)
         ================================================================ -->
    <Visibility x:Key="UI.Splitter.VisibleLine">Collapsed</Visibility>
    <sys:Double x:Key="UI.Splitter.Width">8</sys:Double>
    <sys:Double x:Key="UI.Splitter.LineThickness">1</sys:Double>
    <Visibility x:Key="UI.Splitter.HoverShowGripDot">Collapsed</Visibility>
    <sys:Double x:Key="UI.Splitter.CollapseButtonOpacity">0.2</sys:Double>

    <!-- ================================================================
         H. 滚动条 (6键)
         ================================================================ -->
    <CornerRadius x:Key="UI.ScrollBar.ThumbCornerRadius">4</CornerRadius>
    <sys:Double x:Key="UI.ScrollBar.ThumbWidth">4</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbHoverWidth">8</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbOpacity">0.3</sys:Double>
    <sys:Double x:Key="UI.ScrollBar.ThumbHoverOpacity">0.6</sys:Double>
    <sys:String x:Key="UI.ScrollBar.Mode">Overlay</sys:String>

    <!-- ================================================================
         I. 通用控件圆角 (6键)
         ================================================================ -->
    <CornerRadius x:Key="UI.Button.CornerRadius">8</CornerRadius>
    <CornerRadius x:Key="UI.TextBox.CornerRadius">8</CornerRadius>
    <CornerRadius x:Key="UI.ComboBox.CornerRadius">8</CornerRadius>
    <CornerRadius x:Key="UI.GroupBox.CornerRadius">6</CornerRadius>
    <CornerRadius x:Key="UI.ContextMenu.CornerRadius">8</CornerRadius>
    <CornerRadius x:Key="UI.MenuItem.CornerRadius">4</CornerRadius>

    <!-- ================================================================
         J. 对话框 (2键)
         ================================================================ -->
    <CornerRadius x:Key="UI.Dialog.CornerRadius">12</CornerRadius>
    <CornerRadius x:Key="UI.Dialog.ButtonCornerRadius">6</CornerRadius>

</ResourceDictionary>
