<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tabs="clr-namespace:YiboFile.Services.Tabs"
                    xmlns:controls="clr-namespace:YiboFile.Controls"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:helpers="clr-namespace:YiboFile.Helpers"
                    xmlns:converters="clr-namespace:YiboFile.Controls.Converters">

    <converters:WidthToVisibilityConverter x:Key="WidthToVisibilityConverter" />

    <!-- ================================================================
         Tab Button Styles — 核心模板，消费 UIStyle Token
         ================================================================ -->

    <!-- ======== 非活动 Tab 样式 ======== -->
    <Style x:Key="TabButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="Height" Value="{DynamicResource UI.TabItem.Height}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="{DynamicResource UI.TabItem.Margin}" />
        <Setter Property="Padding" Value="{DynamicResource UI.TabItem.Padding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Main Tab Container -->
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource UI.TabItem.CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        
                        <!-- Separator Line -->
                        <Rectangle x:Name="Separator"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Width="1"
                                   Height="{DynamicResource UI.TabItem.SeparatorHeight}"
                                   Fill="{DynamicResource DividerBrush}"
                                   Margin="0,0,-1,0"
                                   Visibility="{DynamicResource UI.TabItem.SeparatorVisibility}" />
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" TargetName="border" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Separator" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======== 活动 Tab 样式 (核心视觉反馈模板) ======== -->
    <Style x:Key="ActiveTabButtonStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
        <Setter Property="Height" Value="{DynamicResource UI.TabItem.Height}" />
        <Setter Property="Background" Value="{DynamicResource UI.TabItem.ActiveBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
        <Setter Property="FontWeight" Value="{DynamicResource UI.TabItem.ActiveFontWeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- ① 主体容器: 背景 + 边框 + 阴影 -->
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource UI.TabItem.ActiveBorderBrush}"
                                BorderThickness="{DynamicResource UI.TabItem.ActiveBorderThickness}"
                                CornerRadius="{DynamicResource UI.TabItem.CornerRadius}"
                                Effect="{DynamicResource UI.TabItem.ActiveShadowEffect}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        
                        <!-- ② 指示条 (位置/高度/颜色/圆角 全部由 Token 控制) -->
                        <Rectangle Height="{DynamicResource UI.TabItem.ActiveIndicatorHeight}"
                                   VerticalAlignment="{DynamicResource UI.TabItem.ActiveIndicatorPosition}"
                                   Fill="{DynamicResource UI.TabItem.ActiveIndicatorColor}"
                                   Margin="{DynamicResource UI.TabItem.ActiveIndicatorMargin}"
                                   RadiusX="{DynamicResource UI.TabItem.ActiveIndicatorRadius}"
                                   RadiusY="{DynamicResource UI.TabItem.ActiveIndicatorRadius}"
                                   Visibility="{DynamicResource UI.TabItem.ActiveIndicatorVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======== 新建 Tab 按钮 ======== -->
    <Style x:Key="NewTabButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" TargetName="border" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" TargetName="border" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         Tab DataTemplate (标签页数据模板)
         ================================================================ -->
    <DataTemplate x:Key="PathTabDataTemplate" DataType="{x:Type tabs:PathTab}">
        <Button x:Name="TabButton" Style="{StaticResource TabButtonStyle}" Width="{Binding TargetWidth}" Command="{Binding SelectCommand}" ToolTip="{Binding Title}" controls:TabManagerControl.IsActiveNotifier="{Binding IsActive}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.InputBindings>
                <MouseBinding MouseAction="MiddleClick" Command="{Binding CloseCommand}" />
            </Button.InputBindings>
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="关闭标签页" Command="{Binding CloseCommand}" />
                    <MenuItem Header="固定此标签页" Command="{Binding CloseCommand}" IsEnabled="False" />
                </ContextMenu>
            </Button.ContextMenu>
            <Grid Margin="8,0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Icon -->
                <TextBlock Grid.Column="0" x:Name="IconText" Text="📁" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" IsHitTestVisible="False" 
                           Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=80}" />
                
                <!-- Title -->
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                
                <!-- Close Button (默认隐藏，活动标签或悬停时显示) -->
                <Button Grid.Column="2" x:Name="PART_CloseButton" Width="18" Height="18" Margin="6,0,0,0" Padding="0" 
                        VerticalAlignment="Center" HorizontalAlignment="Right" 
                        Foreground="{DynamicResource ForegroundPrimaryBrush}" 
                        Command="{Binding CloseCommand}" 
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="Transparent" CornerRadius="4">
                                            <Path x:Name="iconPath" Data="M 0,0 L 8,8 M 8,0 L 0,8" 
                                                  Stroke="{TemplateBinding Foreground}" 
                                                  StrokeThickness="1.2"
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Stretch="None" 
                                                  Opacity="0.7"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <!-- Windows 标准轻量化强调红 -->
                                                <Setter TargetName="border" Property="Background" Value="#FFE2E2"/>
                                                <Setter TargetName="iconPath" Property="Stroke" Value="#E81123"/>
                                                <Setter TargetName="iconPath" Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FFC6C6"/>
                                                <Setter TargetName="iconPath" Property="Stroke" Value="#E81123"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1.0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <!-- 激活状态样式 -->
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="TabButton" Property="Style" Value="{StaticResource ActiveTabButtonStyle}" />
                <Setter TargetName="IconText" Property="Opacity" Value="1.0" />
            </DataTrigger>
            
            <!-- 悬停时显示关闭按钮（非活动标签） -->
            <Trigger SourceName="TabButton" Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
            </Trigger>
            
            <!-- 动态图标逻辑 -->
            <DataTrigger Binding="{Binding Path, Converter={StaticResource StringStartsWithConverter}, ConverterParameter='search://'}" Value="True">
                <Setter TargetName="IconText" Property="Text" Value="🔍" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path, Converter={StaticResource StringStartsWithConverter}, ConverterParameter='tag://'}" Value="True">
                <Setter TargetName="IconText" Property="Text" Value="🏷️" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path, Converter={StaticResource StringStartsWithConverter}, ConverterParameter='lib://'}" Value="True">
                <Setter TargetName="IconText" Property="Text" Value="📚" />
            </DataTrigger>
            
            <!-- 固定状态逻辑 -->
            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconText" Property="Text" Value="📌" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
