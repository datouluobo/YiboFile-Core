<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tabs="clr-namespace:YiboFile.Services.Tabs"
                    xmlns:controls="clr-namespace:YiboFile.Controls"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:helpers="clr-namespace:YiboFile.Helpers"
                    xmlns:converters="clr-namespace:YiboFile.Controls.Converters">

    <converters:WidthToVisibilityConverter x:Key="WidthToVisibilityConverter" />

    <!-- ================================================================
         Tab Button Styles — 核心模板，消费 UIStyle Token
         ================================================================ -->

    <!-- ======== 非活动 Tab 样式 ======== -->
    <Style x:Key="TabButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="Height" Value="{DynamicResource UI.TabItem.Height}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
        <Setter Property="Margin" Value="{DynamicResource UI.TabItem.Margin}" />
        <Setter Property="Padding" Value="{DynamicResource UI.TabItem.Padding}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid ClipToBounds="False" SnapsToDevicePixels="True">
                        <!-- Main Tab Container -->
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource UI.TabItem.CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        
                        <!-- Separator Line -->
                        <Rectangle x:Name="Separator"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Width="1"
                                   Height="{DynamicResource UI.TabItem.SeparatorHeight}"
                                   Fill="{DynamicResource DividerBrush}"
                                   Visibility="{DynamicResource UI.TabItem.SeparatorVisibility}" />
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" TargetName="border" />
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======== 活动 Tab 样式 (核心视觉反馈模板) ======== -->
    <Style x:Key="ActiveTabButtonStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
        <Setter Property="Height" Value="{DynamicResource UI.TabItem.Height}" />
        <Setter Property="Background" Value="{DynamicResource UI.TabItem.ActiveBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}" />
        <Setter Property="FontWeight" Value="{DynamicResource UI.TabItem.ActiveFontWeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid ClipToBounds="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Grid ClipToBounds="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <!-- ① 主体容器: 背景 + 边框 + 阴影。边缘直接绘制，由父级不裁剪和像素对齐保证完整显示。 -->
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource UI.TabItem.ActiveBorderBrush}"
                                    BorderThickness="{DynamicResource UI.TabItem.ActiveBorderThickness}"
                                    CornerRadius="{DynamicResource UI.TabItem.CornerRadius}"
                                    Effect="{DynamicResource UI.TabItem.ActiveShadowEffect}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                            </Border>

                            <!-- ② 侧向指示条: 用于和底线/顶线形成真正不同的 tab 样式 -->
                            <Border Width="{DynamicResource UI.TabItem.ActiveSideIndicatorWidth}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource UI.TabItem.ActiveSideIndicatorColor}"
                                    CornerRadius="{DynamicResource UI.TabItem.ActiveSideIndicatorRadius}"
                                    Margin="{DynamicResource UI.TabItem.ActiveSideIndicatorMargin}"
                                    Visibility="{DynamicResource UI.TabItem.ActiveSideIndicatorVisibility}" />
                        
                            <!-- ③ 指示条 (位置/高度/颜色/圆角 全部由 Token 控制) -->
                            <Rectangle Height="{DynamicResource UI.TabItem.ActiveIndicatorHeight}"
                                       VerticalAlignment="{DynamicResource UI.TabItem.ActiveIndicatorPosition}"
                                       Fill="{DynamicResource UI.TabItem.ActiveIndicatorColor}"
                                       Margin="{DynamicResource UI.TabItem.ActiveIndicatorMargin}"
                                       RadiusX="{DynamicResource UI.TabItem.ActiveIndicatorRadius}"
                                       RadiusY="{DynamicResource UI.TabItem.ActiveIndicatorRadius}"
                                       Visibility="{DynamicResource UI.TabItem.ActiveIndicatorVisibility}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======== 新建 Tab 按钮 ======== -->
    <Style x:Key="NewTabButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="Width" Value="{DynamicResource UI.TabItem.Height}" />
        <Setter Property="Height" Value="{DynamicResource UI.TabItem.Height}" />
        <Setter Property="Margin" Value="{DynamicResource UI.TabItem.Margin}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource UI.TabItem.CornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" TargetName="border" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" TargetName="border" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         Tab DataTemplate (标签页数据模板)
         ================================================================ -->

</ResourceDictionary>
