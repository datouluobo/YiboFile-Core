    <!-- ================================================================
         Tesla 图标集 — 极简几何风格
         1.5px 描边、精确工程感、无填充
         灵感来自 Tesla 汽车 UI 的纯净线条
         ================================================================ -->

    <!-- 图标集元数据 -->
    <sys:String x:Key="IconStyleId">Tesla</sys:String>
    <sys:String x:Key="IconStyleDisplayName">工程图标</sys:String>
    <sys:String x:Key="IconStyleDisplayNameEn">Blueprint Icons</sys:String>
    <sys:String x:Key="IconStyleDescription">极简工程描边图标，1px CAD 图纸线条</sys:String>
    <sys:String x:Key="IconStyleDescriptionEn">Minimal engineering stroke icons, 1px CAD blueprint lines</sys:String>
    <sys:String x:Key="IconRenderMode">Path</sys:String>
    <sys:String x:Key="UI.IconStyleId">Tesla</sys:String>
    <sys:String x:Key="UI.IconStyleDisplayName">工程图标</sys:String>
    <sys:String x:Key="UI.IconStyleDescription">极简工程描边图标 (Stroke-based, 1px CAD)</sys:String>

    <!-- ================================================================
         所有图标使用统一模板：
         - ViewBox: 24x24
         - Stroke: 1px (极细工程线)
         - Caps: Flat/Square, Joins: Miter
         机械图纸风格 — 精确、锐利、无装饰
         ================================================================ -->

