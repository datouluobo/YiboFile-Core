<Window x:Class="YiboFile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YiboFile"
        xmlns:controls="clr-namespace:YiboFile.Controls"
        xmlns:converters="clr-namespace:YiboFile.Converters"
        Title="YiboFile - 文件资源管理器" 
        Height="800" 
        Width="1200"
        MinHeight="600"
        MinWidth="960"
        WindowState="Normal"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        Background="{DynamicResource BackgroundPrimaryBrush}">

    <Window.InputBindings>
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding FileOperation.CopyCommand}" CommandParameter="{Binding ActivePane.Selection.SelectedItems}"/>
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding FileOperation.CutCommand}" CommandParameter="{Binding ActivePane.Selection.SelectedItems}"/>
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding FileOperation.PasteCommand}" CommandParameter="{Binding ActivePane}"/>
        <KeyBinding Key="Delete" Command="{Binding FileOperation.DeleteCommand}" CommandParameter="{Binding ActivePane.Selection.SelectedItems}"/>
        <!-- Shift+Delete handled by Command implementation checking modifiers, or separate binding -->
        <KeyBinding Key="F2" Command="{Binding FileOperation.RenameCommand}" CommandParameter="{Binding ActivePane.Selection.SelectedItem}"/>
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding FileOperation.NewFolderCommand}" CommandParameter="{Binding ActivePane}"/>
        <!-- New File? -->
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding FileOperation.UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding FileOperation.RedoCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ActivePane.Commands.RefreshCommand}"/>
    </Window.InputBindings>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0" 
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:TimeUnitConverter x:Key="TimeUnitConverter"/>
        <converters:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter"/>
    </Window.Resources>

    <!-- 主容器：包含标题栏和窗口内容 -->
    <Grid Name="MainContainer">
        <!-- 窗口内容容器 -->
        <Grid Name="RootGrid" Background="{DynamicResource BackgroundPrimaryBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="Margin" Value="7"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <!-- 左中右4列布局 (Rail + Side + Main + Right) -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColRail" Width="56" MinWidth="56" MaxWidth="56"/>
                <ColumnDefinition x:Name="ColLeft" Width="232" MinWidth="220"/>
                <ColumnDefinition x:Name="ColSplitterLeft" Width="10"/>
                <!-- 对齐水平分割器的宽度 -->
                <ColumnDefinition x:Name="ColCenter" Width="*" MinWidth="250"/>
                <ColumnDefinition x:Name="ColSplitterRight" Width="10"/>
                <!-- 对齐水平分割器的宽度 -->
                <ColumnDefinition x:Name="ColRight" Width="0" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- 布局：标题栏行 + 标签页行 + 内容行 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏背景（包含底部边框） -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6"
                Background="{DynamicResource TitleBarBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Panel.ZIndex="1000"/>

            <!-- ========== 列0：导航侧栏 ========== -->
            <controls:NavigationRailControl x:Name="NavigationRail"
                                      Grid.Row="0" Grid.RowSpan="4"
                                      Grid.Column="0"
                                      Panel.ZIndex="2000"
                                      WindowChrome.IsHitTestVisibleInChrome="True" Width="56"/>

            <!-- 导航按钮：位于列0 (随列0宽度自动调整) -->


            <!-- 列1（左侧辅助面板）背景：贯穿主标题栏 -->
            <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="4"
                Background="{DynamicResource NavigationRegionBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0"
                Panel.ZIndex="50"/>



            <!-- ========== 标签页管理器 ========== -->


            <!-- 垂直分割器（从Row 2开始，跨越2行：Row 2和Row 3） -->
            <!-- 左侧导航与中间文件列表之间的分割器 -->
            <!-- 左侧导航与中间文件列表之间的分割器 (Col 2) -->
            <controls:CollapsibleGridSplitter x:Name="SplitterLeft" Grid.Row="0" Grid.Column="2" Grid.RowSpan="4"
                      Style="{StaticResource VerticalCollapsibleGridSplitterStyle}"
                      Background="{DynamicResource NavigationRegionBrush}"
                      Margin="0"
                      HorizontalAlignment="Stretch"
                      CollapseMode="Previous"
                      ShowsPreview="False"
                      Panel.ZIndex="2000"
                      IsPreviousCollapsed="{Binding Layout.IsLeftPanelCollapsed, Mode=TwoWay}"/>

            <!-- 中间文件列表与右侧预览之间的分割器 -->
            <!-- 中间文件列表与右侧预览之间的分割器 (Col 4) -->
            <controls:CollapsibleGridSplitter x:Name="SplitterRight" Grid.Row="0" Grid.Column="4" Grid.RowSpan="4"
                      Style="{StaticResource VerticalCollapsibleGridSplitterStyle}"
                      Background="{DynamicResource PaneFocusedBackgroundBrush}"
                      Margin="0"
                      HorizontalAlignment="Stretch"
                      CollapseMode="Both"
                      ShowsPreview="False"
                      Panel.ZIndex="2000"
                      AutoFillNeighbor="True"
                      MouseDoubleClick="SplitterRight_MouseDoubleClick"/>

            <!-- ========== 列1：左侧导航内容区域（从顶端 Row 0 开始） ========== -->
            <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="4" Panel.ZIndex="2001">
                <Grid.RowDefinitions>
                    <RowDefinition Height="217*"/>
                    <RowDefinition Height="31*"/>
                    <RowDefinition Height="529*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:NavigationPanelControl Grid.Row="0" x:Name="NavigationPanelControl" Grid.RowSpan="3"
                                                 NavigateCommand="{Binding Navigation.NavigateToCommand}"
                                                 OpenInNewTabCommand="{Binding Tabs.OpenInNewTabCommand}"
                                                 NavigateLibraryCommand="{Binding Library.OpenLibraryCommand}"/>

                <!-- 底部占位（如果需要背景贯穿，可以在这里放一个简单的 Border，或者直接移除） -->
                <!-- 原底部全局按钮区域已移至侧边栏 -->
                <Border Grid.Row="3" Height="0"/>

                <!-- 剪切板历史 Popup -->

            </Grid>

            <!-- 列3：主内容宿主（包含文件浏览器 + 自定义面板切换） -->
            <controls:PaneContentHost x:Name="PrimaryContentHost"
                                     Grid.Row="1" Grid.RowSpan="3"
                                     Grid.Column="3" 
                                     VerticalAlignment="Stretch"
                                     Margin="0,0,0,0"
                                     Panel.ZIndex="100"
                                     ActiveTab="{Binding DataContext.Tabs.PrimaryActiveTab, RelativeSource={RelativeSource AncestorType=Window}}"
                                     DataContext="{Binding PrimaryPane}"/>



            <!-- ========== 列5：副文件列表（仅双列模式可见） ========== -->
            <Grid Grid.Row="0" Grid.Column="5" Grid.RowSpan="4" 
              WindowChrome.IsHitTestVisibleInChrome="True"
              Panel.ZIndex="1001">
                <!-- 副文件列表区域（默认隐藏） -->
                <Grid x:Name="SecondFileBrowserContainer" 
                  WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <!-- 标签页行 -->
                        <RowDefinition Height="*"/>
                        <!-- 文件列表 -->
                    </Grid.RowDefinitions>

                    <!-- 副内容宿主 -->
                    <controls:PaneContentHost x:Name="SecondContentHost"
                                             Grid.Row="1"
                                             HorizontalAlignment="Stretch" 
                                             VerticalAlignment="Stretch"
                                             ActiveTab="{Binding DataContext.Tabs.SecondaryActiveTab, RelativeSource={RelativeSource AncestorType=Window}}"
                                             DataContext="{Binding SecondaryPane}"/>
                </Grid>
            </Grid>


            <!-- 右上角窗口控制按钮：移动到 RootGrid 内部以保持 Margin 一致性 -->


            <!-- 对齐吸附指示线 -->
            <Canvas x:Name="GlobalSnapIndicator" Grid.RowSpan="4" Grid.ColumnSpan="6" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="10000">
                <Line x:Name="GlobalSnapLine" X1="0" Y1="0" X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" Y2="0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="4 4" SnapsToDevicePixels="True"/>
            </Canvas>

            <!-- 通知容器: 位于底部中央，覆盖在最上层 -->
            <StackPanel x:Name="NotificationContainer"
                    Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="6"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,20"
                    Panel.ZIndex="9000"/>



            </Grid>

            <!-- 独立标题栏 Tab 层：与内容网格同列宽，但不参与内容区裁切和分割器覆盖 -->
            <Grid x:Name="TitleTabOverlayGrid"
                  Height="44"
                  VerticalAlignment="Top"
                  Margin="{Binding Margin, ElementName=RootGrid}"
                  Panel.ZIndex="9000"
                  ClipToBounds="False"
                  WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Width, ElementName=ColRail}"/>
                    <ColumnDefinition Width="{Binding Width, ElementName=ColLeft}"/>
                    <ColumnDefinition Width="{Binding Width, ElementName=ColSplitterLeft}"/>
                    <ColumnDefinition Width="{Binding Width, ElementName=ColCenter}"/>
                    <ColumnDefinition Width="{Binding Width, ElementName=ColSplitterRight}"/>
                    <ColumnDefinition Width="{Binding Width, ElementName=ColRight}"/>
                </Grid.ColumnDefinitions>

                <controls:TabManagerControl x:Name="TabManager"
                                            Grid.Column="3"
                                            Visibility="{Binding DataContext.Layout.IsPrimaryTabVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            DataContext="{Binding Tabs}"
                                            ItemsSource="{Binding PrimaryTabs}"
                                            NewTabCommand="{Binding PrimaryNewTabCommand}"
                                            Margin="0"
                                            VerticalAlignment="Top"
                                            Panel.ZIndex="1"
                                            ClipToBounds="False"
                                            WindowChrome.IsHitTestVisibleInChrome="True"/>

                <controls:TabManagerControl x:Name="SecondTabManager"
                                            Grid.Column="5"
                                            Visibility="{Binding DataContext.Layout.IsDualPaneEffectivelyVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            DataContext="{Binding Tabs}"
                                            ItemsSource="{Binding SecondaryTabs}"
                                            NewTabCommand="{Binding SecondaryNewTabCommand}"
                                            Margin="0"
                                            VerticalAlignment="Top"
                                            Panel.ZIndex="1"
                                            ClipToBounds="False"
                                            WindowChrome.IsHitTestVisibleInChrome="True"/>

            </Grid>

            <!-- 右上角窗口控制按钮：放回 RootGrid 内部以继承合适的窗口内边缘控制 -->
            <Grid Name="WindowControlButtonsContainer" 
              Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Height="44"
              Panel.ZIndex="10000"
              PreviewMouseDown="WindowControlButtonsContainer_PreviewMouseDown">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <!-- 正常状态下补偿 RootGrid 的 4px 边距，并且保持右侧对其 -->
                        <Setter Property="Margin" Value="0,0,0,0"/>
                        <Style.Triggers>
                            <!-- 最大化时，RootGrid 边距 8 等同屏幕外扩缓存，零边距即刚好挂靠绝对角落 -->
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter Property="Margin" Value="0,0,0,0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

            <!-- 按钮区域 -->
            <StackPanel x:Name="WindowButtonsStackPanel" 
                   Orientation="Horizontal"
                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   WindowChrome.IsHitTestVisibleInChrome="True">
                   
                <!-- 之前的按钮已移动到左下角 -->
                <Grid Width="0" Height="0"/>
                <!-- 最小化按钮 -->
                <Button x:Name="TitleBarMinimizeButton"
                    Width="46"
                    Height="44"
                    Click="WindowMinimize_Click" 
                    ToolTip="最小化"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Image Source="{DynamicResource Icon_Window_Minimize}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlPressedBackgroundBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="TitleBarMaxRestoreButton"
                    Width="46"
                    Height="44"
                    Click="WindowMaximize_Click" 
                    ToolTip="最大化"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Image x:Name="TitleBarMaxRestoreImage" Source="{DynamicResource Icon_Window_Maximize}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlPressedBackgroundBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 关闭按钮 -->
                <Button x:Name="TitleBarCloseButton"
                    Width="46"
                    Height="44"
                    Click="WindowClose_Click" 
                    ToolTip="关闭" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" 
                                Background="Transparent" 
                                BorderThickness="0">
                                <Image x:Name="ButtonIcon"
                                       Source="{DynamicResource Icon_Window_Close}" 
                                       Width="16" Height="16"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#E81123"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#C41019"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</Window>

