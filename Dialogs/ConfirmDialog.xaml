<Window x:Class="YiboFile.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认" 
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseDialogWindowStyle}"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False">
    
    <Grid Margin="24" MinWidth="320" MaxWidth="450" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="GridScale" ScaleX="0.95" ScaleY="0.95"/>
        </Grid.RenderTransform>
        
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="GridScale" 
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="GridScale" 
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.0" To="1.0" Duration="0:0:0.15"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0"
                       x:Name="IconTextBlock" 
                       Style="{StaticResource DialogIconStyle}"
                       Text="ℹ️"/>
            
            <TextBlock Grid.Column="1"
                       x:Name="ConfirmTitle" 
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundPrimaryBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </Grid>
        
        <!-- 消息内容 -->
        <TextBlock Grid.Row="1" 
                   x:Name="MessageTextBlock" 
                   FontSize="14"
                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Margin="0,0,0,24"/>
        
        <!-- 按钮区域 -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            
            <Button x:Name="NoButton"
                    Content="否" 
                    Visibility="Collapsed"
                    Click="No_Click"
                    Style="{StaticResource DialogButtonStyle}"
                    Margin="10,0,0,0"/>

            <Button x:Name="CancelButton"
                    Content="取消" 
                    Click="Cancel_Click" 
                    Style="{StaticResource DialogButtonStyle}"
                    Margin="10,0,0,0"/>
            
            <Button x:Name="ConfirmButton"
                    Content="确定" 
                    Click="Confirm_Click" 
                    Style="{StaticResource PrimaryDialogButtonStyle}"
                    Margin="10,0,0,0"/>

            <Button x:Name="YesButton"
                    Content="是" 
                    Visibility="Collapsed"
                    Click="Yes_Click" 
                    Style="{StaticResource PrimaryDialogButtonStyle}"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
