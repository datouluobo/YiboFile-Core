<Window x:Class="YiboFile.Dialogs.ConflictResolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件冲突" 
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseDialogWindowStyle}"
        ShowInTaskbar="False">
    
    <Grid Margin="24" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="GridScale" ScaleX="0.95" ScaleY="0.95"/>
        </Grid.RenderTransform>
        
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="GridScale" 
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="GridScale" 
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1.0" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.0" To="1.0" Duration="0:0:0.15"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 图标和标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DialogIconStyle}" Text="⚠️" Foreground="{DynamicResource StatusWarningBrush}"/>
            <TextBlock Grid.Column="1" Text="目标位置已存在同名文件" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundPrimaryBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- 文件名 -->
        <TextBlock x:Name="FileNameText" Grid.Row="1" 
                   Text="filename.txt"
                   FontSize="14"
                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,24"/>

        <!-- 按钮区域 -->
        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 单个文件操作 -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="仅当前文件" FontSize="12" Foreground="{DynamicResource ForegroundTertiaryBrush}" Margin="0,0,0,10" FontWeight="SemiBold"/>
                <Button Content="📋 覆盖" Tag="Overwrite" Click="DirectButton_Click"
                        Style="{StaticResource DialogButtonStyle}" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
                <Button Content="⏭ 跳过" Tag="Skip" Click="DirectButton_Click"
                        Style="{StaticResource DialogButtonStyle}" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
                <Button Content="📄 保留两者" Tag="Rename" Click="DirectButton_Click"
                        Style="{StaticResource PrimaryDialogButtonStyle}" HorizontalContentAlignment="Left"/>
            </StackPanel>

            <!-- 所有文件操作 -->
            <StackPanel Grid.Column="2" x:Name="AllFilesPanel">
                <TextBlock Text="所有冲突文件" FontSize="12" Foreground="{DynamicResource ForegroundTertiaryBrush}" Margin="0,0,0,10" FontWeight="SemiBold"/>
                <Button Content="📋 覆盖全部" Tag="OverwriteAll" Click="DirectButton_Click"
                        Style="{StaticResource DialogButtonStyle}" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
                <Button Content="⏭ 跳过全部" Tag="SkipAll" Click="DirectButton_Click"
                        Style="{StaticResource DialogButtonStyle}" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
                <Button Content="📄 保留全部" Tag="RenameAll" Click="DirectButton_Click"
                        Style="{StaticResource PrimaryDialogButtonStyle}" HorizontalContentAlignment="Left"/>
            </StackPanel>
        </Grid>

        <!-- 底部取消 -->
        <Button Grid.Row="3" Content="放弃其余操作" 
                Click="CancelAll_Click"
                HorizontalAlignment="Right"
                Style="{StaticResource DialogButtonStyle}"
                Foreground="{DynamicResource StatusErrorBrush}"
                Padding="16,8"/>
    </Grid>
</Window>
