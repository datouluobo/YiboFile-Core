<UserControl x:Class="YiboFile.Controls.RenameOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YiboFile.Controls">
    <Popup x:Name="RenamePopup"
           PlacementTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=local:RenameOverlay}}"
           Placement="Relative"
           HorizontalOffset="{Binding PopupHorizontalOffset, RelativeSource={RelativeSource AncestorType=local:RenameOverlay}}"
           VerticalOffset="{Binding PopupVerticalOffset, RelativeSource={RelativeSource AncestorType=local:RenameOverlay}}"
           StaysOpen="True"
           AllowsTransparency="True"
           IsOpen="{Binding IsOpen, RelativeSource={RelativeSource AncestorType=local:RenameOverlay}}"
           PopupAnimation="None">
        <Border x:Name="PopupBorder" 
                Background="{DynamicResource BackgroundElevatedBrush}"
                BorderBrush="{DynamicResource BorderFocusBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="0"
                RenderTransformOrigin="0.5,0.5"
                PreviewMouseLeftButtonDown="OnPopupBorderPreviewMouseDown"
                PreviewMouseLeftButtonUp="OnPopupBorderPreviewMouseUp">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- 主行：TextBox + 按钮 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>      <!-- TextBox -->
                        <ColumnDefinition Width="Auto"/>   <!-- ✓ -->
                        <ColumnDefinition Width="Auto"/>   <!-- ✗ -->
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="RenameTextBox" Grid.Column="0"
                             Text="{Binding Text, RelativeSource={RelativeSource AncestorType=local:RenameOverlay}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="{Binding MinTextWidth, RelativeSource={RelativeSource AncestorType=local:RenameOverlay}}"
                             MaxWidth="{Binding MaxTextWidth, RelativeSource={RelativeSource AncestorType=local:RenameOverlay}}"
                             FontSize="{Binding TextFontSize, RelativeSource={RelativeSource AncestorType=local:RenameOverlay}}"
                             FontWeight="{Binding TextFontWeight, RelativeSource={RelativeSource AncestorType=local:RenameOverlay}}"
                             TextAlignment="{Binding TextAlignment, RelativeSource={RelativeSource AncestorType=local:RenameOverlay}}"
                             Padding="{Binding TextPadding, RelativeSource={RelativeSource AncestorType=local:RenameOverlay}}"
                             Margin="-2,0,0,0"
                             Background="Transparent"
                             Foreground="{DynamicResource ForegroundPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentDefaultBrush}"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             PreviewMouseLeftButtonDown="OnTextBoxPreviewMouseDown"/>
                    
                    <!-- ✓ 确认按钮 -->
                    <Button x:Name="ConfirmButton" Grid.Column="1"
                            Width="22" Height="22"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,0,0"
                            ToolTip="确认 (Enter)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Path Data="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z"
                                          Fill="{DynamicResource AccentDefaultBrush}"
                                          Width="10" Height="10" Stretch="Uniform"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" x:Name="stConfirm" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="stConfirm" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.1"/><DoubleAnimation Storyboard.TargetName="stConfirm" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.1"/></Storyboard></BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="stConfirm" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/><DoubleAnimation Storyboard.TargetName="stConfirm" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/></Storyboard></BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- ✗ 取消按钮 -->
                    <Button x:Name="CancelButton" Grid.Column="2"
                            Width="22" Height="22"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,2,0"
                            ToolTip="取消 (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Fill="{DynamicResource ForegroundSecondaryBrush}"
                                          Width="9" Height="9" Stretch="Uniform"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" x:Name="stCancel" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="stCancel" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.1"/><DoubleAnimation Storyboard.TargetName="stCancel" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.1"/></Storyboard></BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="stCancel" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/><DoubleAnimation Storyboard.TargetName="stCancel" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/></Storyboard></BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                
                <!-- 校验错误提示行 -->
                <TextBlock x:Name="ValidationErrorText"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="11"
                           Margin="8,2,8,4"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Popup>
</UserControl>
