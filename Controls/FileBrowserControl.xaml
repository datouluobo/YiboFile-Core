<UserControl x:Class="YiboFile.Controls.FileBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:YiboFile.Controls"
             xmlns:helpers="clr-namespace:YiboFile.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.InputBindings>
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}"/>
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteCommand}"/>
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Key="F2" Command="{Binding RenameCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Alt" Command="{Binding PropertiesCommand}"/>
        <KeyBinding Key="Back" Command="{Binding NavigateUpCommand}"/>
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:BindingProxy x:Key="ControlProxy" Data="{Binding RelativeSource={RelativeSource AncestorType=controls:FileBrowserControl}}"/>
        <!-- 统一使用 AppStyles 中的 ModernToolbarButtonStyle -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernToolbarButtonStyle}"/>
        
        <Style x:Key="ToolbarRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 分段按钮样式（用于搜索模式切换） -->
        <Style x:Key="SegmentedButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 过滤器芯片样式 -->
        <Style x:Key="FilterChipStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 文件右键菜单 -->
        <ContextMenu x:Key="FileListContextMenu" DataContext="{Binding Data.DataContext, Source={StaticResource ControlProxy}}">
            <MenuItem x:Name="CopyItem" Header="复制" 
                      Command="{Binding CopyCommand}" 
                      Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Icon="📄"/>
            <MenuItem x:Name="CutItem" Header="剪切" 
                      Command="{Binding CutCommand}" 
                      Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Icon="✂️"/>
            <MenuItem x:Name="PasteItem" Header="粘贴" 
                      Command="{Binding PasteCommand}" 
                      Icon="📋"/>
            <Separator Visibility="{Binding IsNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem Header="新建" Visibility="{Binding IsNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}" Icon="➕">
                <MenuItem Header="文件夹" Command="{Binding NewFolderCommand}" Icon="📁"/>
                <MenuItem Header="文本文档" Command="{Binding NewFileCommand}" Icon="📄"/>
            </MenuItem>
            <Separator Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem x:Name="DeleteItem" Header="删除" 
                      Command="{Binding DeleteCommand}" 
                      Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Icon="🗑️"/>
            <MenuItem x:Name="RenameItem" Header="重命名" 
                      Command="{Binding RenameCommand}" 
                      Visibility="{Binding IsSingleSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Icon="✏️"/>
            <Separator Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem x:Name="AddToLibraryMenuItem" Header="📚 添加到库" 
                      Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ItemsSource="{Binding LibraryMenuItems}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Header}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                        <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
                        <Setter Property="Icon" Value="{Binding Icon}"/>
                        <Setter Property="IsCheckable" Value="{Binding IsCheckable}"/>
                        <Setter Property="IsChecked" Value="{Binding IsChecked}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Separator Margin="0,2" Background="{DynamicResource BorderBrush}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem x:Name="AddFavoriteMenuItem" Header="⭐ 添加到收藏" 
                      Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ItemsSource="{Binding FavoriteMenuItems}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Header}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                        <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
                        <Setter Property="Icon" Value="{Binding Icon}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Separator Margin="0,2" Background="{DynamicResource BorderBrush}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem x:Name="AddTagMenuItem" Header="🏷️ 添加标签" 
                      Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ItemsSource="{Binding TagMenuItems}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Header}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                        <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
                        <Setter Property="IsCheckable" Value="True"/>
                        <Setter Property="IsChecked" Value="{Binding IsChecked}"/>
                        <Setter Property="Icon">
                            <Setter.Value>
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" 
                                           Fill="{Binding IconBrush, TargetNullValue=Transparent}"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Separator Margin="0,2" Background="{DynamicResource BorderBrush}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Icon" Value="{x:Null}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem x:Name="RefreshItem" Header="刷新" 
                      Command="{Binding RefreshCommand}" 
                      Visibility="{Binding IsNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Icon="🔄"/>
            <MenuItem x:Name="PropertiesItem" Header="属性" 
                      Command="{Binding PropertiesCommand}" 
                      Icon="ℹ️"/>
        </ContextMenu>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: 地址栏 -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: 工具栏行 -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: 搜索状态提示 -->
            <RowDefinition Height="*"/>     <!-- Row 3: 文件列表 -->
            <RowDefinition Height="12"/>     <!-- Row 4: Splitter -->
            <RowDefinition Height="180" MinHeight="120"/> <!-- Row 5: Info Panel -->
        </Grid.RowDefinitions>

        <!-- Row 0: 地址栏（纯地址输入） -->
        <Border Grid.Row="0" Background="Transparent" Margin="0,4,0,4">
            <controls:AddressBarControl x:Name="AddressBarControl" Margin="8,0" 
                                       AddressText="{Binding CurrentPath, Mode=TwoWay}"
                                       IsReadOnly="{Binding IsAddressReadOnly}"/>
        </Border>
        
        <!-- Row 1: 工具栏行（导航 + 操作 + 视图 + 搜索） -->
        <Border Grid.Row="1" Background="Transparent" Margin="0,0,0,4">
            <Grid Margin="8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- 导航按钮 -->
                    <ColumnDefinition Width="8"/>     <!-- 间距 -->
                    <ColumnDefinition Width="Auto"/>  <!-- TitleActionBar -->
                    <ColumnDefinition Width="*"/>     <!-- 填充 -->
                    <ColumnDefinition Width="Auto"/>  <!-- 视图切换 -->
                    <ColumnDefinition Width="8"/>     <!-- 间距 -->
                    <ColumnDefinition Width="Auto"/>  <!-- 搜索/筛选 -->
                </Grid.ColumnDefinitions>
                
                <!-- 导航按钮 (←→↑) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Name="NavBackBtn" FontFamily="{DynamicResource IconFontFamily}" Content="{DynamicResource Icon_Back}" FontSize="14" Command="{Binding NavigateBackCommand}" ToolTip="后退" Style="{StaticResource ModernToolbarButtonStyle}"/>
                    <Button Name="NavForwardBtn" FontFamily="{DynamicResource IconFontFamily}" Content="{DynamicResource Icon_Forward}" FontSize="14" Command="{Binding NavigateForwardCommand}" ToolTip="前进" Style="{StaticResource ModernToolbarButtonStyle}"/>
                    <Button Name="NavUpBtn" FontFamily="{DynamicResource IconFontFamily}" Content="{DynamicResource Icon_Up}" FontSize="14" Command="{Binding NavigateUpCommand}" ToolTip="向上" Style="{StaticResource ModernToolbarButtonStyle}"/>
                    <!-- Undo/Redo -->
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="4,0" VerticalAlignment="Center"/>
                    <Button Name="UndoBtn" FontFamily="Segoe MDL2 Assets" Content="&#xE7A7;" FontSize="14" 
                            Command="{Binding UndoCommand}" 
                            ToolTip="撤销" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Name="RedoBtn" FontFamily="Segoe MDL2 Assets" Content="&#xE7A6;" FontSize="14" 
                            Command="{Binding RedoCommand}" 
                            ToolTip="重做" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>
                
                <!-- TitleActionBar (操作按钮) -->
                <controls:TitleActionBar Grid.Column="2" x:Name="TitleActionBar" Mode="{Binding NavigationMode}"/>
                
                <!-- 视图切换按钮 (下拉菜单) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Name="PropertiesBtn" Content="&#xE946;" 
                            FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Visibility="{Binding IsPropertiesButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding PropertiesCommand}" Style="{StaticResource ModernToolbarButtonStyle}" ToolTip="属性"
                            Margin="0,0,4,0"/>
                    <Button Name="ViewModeBtn" Content="{Binding ViewModeIcon}" 
                            FontFamily="{DynamicResource IconFontFamily}" FontSize="14"
                            Click="ViewModeBtn_DropDown" Style="{StaticResource ModernToolbarButtonStyle}" ToolTip="视图模式">
                        <Button.ContextMenu>
                            <ContextMenu Name="ViewModeMenu">
                                <MenuItem Header="📋 列表" Command="{Binding SwitchViewModeCommand}" CommandParameter="List"/>
                                <MenuItem Header="📝 紧凑列表" Command="{Binding SwitchViewModeCommand}" CommandParameter="Compact"/>
                                <Separator/>
                                <MenuItem Header="🖼️ 缩略图" Command="{Binding SwitchViewModeCommand}" CommandParameter="Thumbnail"/>
                                <MenuItem Header="🔲 平铺" Command="{Binding SwitchViewModeCommand}" CommandParameter="Tiles"/>
                                <MenuItem Header="📎 小图标" Command="{Binding SwitchViewModeCommand}" CommandParameter="SmallIcons"/>
                                <Separator/>
                                <MenuItem Header="📄 内容" Command="{Binding SwitchViewModeCommand}" CommandParameter="Content"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                
                <!-- 搜索/筛选按钮 -->
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Name="FilterBtn" Content="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Command="{Binding ToggleFilterPanelCommand}"
                            Style="{StaticResource ModernToolbarButtonStyle}" ToolTip="筛选"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Row 2: 搜索状态提示条 -->
        <Border x:Name="SearchStatusBar" Grid.Row="2" Background="{DynamicResource AccentSubtleBrush}" 
                Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="8,4" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SearchStatusIcon" Text="🔍" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SearchStatusText" Text="{Binding SearchStatusText}" 
                          Foreground="{DynamicResource ForegroundBrush}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Row 3: 文件列表 -->
        <controls:FileListControl Grid.Row="3" x:Name="FileList" 
                                 ItemsSource="{Binding Files}"
                                 CurrentViewMode="{Binding FileViewMode, Mode=TwoWay}"
                                 LoadMoreCommand="{Binding LoadMoreCommand}"
                                 IsLoadMoreVisible="{Binding IsLoadMoreVisible}"
                                 FocusVisualStyle="{x:Null}"/>
        
        <!-- Row 4: 水平分割器（文件列表与信息面板之间） -->
        <controls:CollapsibleGridSplitter Grid.Row="4" 
                      Style="{StaticResource HorizontalCollapsibleGridSplitterStyle}"
                      CollapseMode="Both"
                      HorizontalAlignment="Stretch"
                      Panel.ZIndex="999"
                      AutoFillNeighbor="True"
                      ShowsPreview="True"/>
        
        <!-- Row 5: 右侧信息面板（现在移动到底部作为信息栏） -->
        <Border Grid.Row="5" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,4">
                <!-- 文件信息面板 -->
                <StackPanel x:Name="FileInfoPanel" Margin="4"/>
            </ScrollViewer>
        </Border>

        <!-- 焦点边框覆盖层 (Grid.RowSpan="5") -->
        <Border x:Name="FocusBorder"
                Grid.Row="0" Grid.RowSpan="5"
                BorderThickness="2"
                Margin="-2"
                BorderBrush="Transparent"
                IsHitTestVisible="False"
                Panel.ZIndex="1000"/>

        <!-- 筛选弹出面板 -->
        <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterBtn}" 
               IsOpen="{Binding IsFilterPanelVisible, Mode=TwoWay}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Placement="Bottom" VerticalOffset="4">
            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Effect="{DynamicResource DropShadowEffect}">
                <controls:FilterPanel x:Name="FilterPanelControl" DataContext="{Binding Search}" Options="{Binding SearchOptions}"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
