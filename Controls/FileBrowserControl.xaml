<UserControl x:Class="YiboFile.Controls.FileBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:YiboFile.Controls"
             xmlns:helpers="clr-namespace:YiboFile.Helpers"
             xmlns:converters="clr-namespace:YiboFile.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.InputBindings>
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding Commands.CopyCommand}"/>
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding Commands.PasteCommand}"/>
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding Commands.CutCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding Commands.DeleteCommand}"/>
        <KeyBinding Key="F2" Command="{Binding Commands.RenameCommand}"/>
        <KeyBinding Key="F5" Command="{Binding Commands.RefreshCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Alt" Command="{Binding Commands.PropertiesCommand}"/>
        <KeyBinding Key="Back" Command="{Binding Commands.NavigateUpCommand}"/>
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding Commands.SelectAllCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <converters:EqualityToBoolConverter x:Key="EqualityToBoolConverter"/>
            <helpers:BindingProxy x:Key="ControlProxy" Data="{Binding RelativeSource={RelativeSource AncestorType=controls:FileBrowserControl}}"/>
            <!-- 统一使用 AppStyles 中的 ModernToolbarButtonStyle -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernToolbarButtonStyle}"/>
        
        <Style x:Key="ToolbarRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 分段按钮样式（用于搜索模式切换） -->
        <Style x:Key="SegmentedButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 过滤器芯片样式 -->
        <Style x:Key="FilterChipStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 文件右键菜单 -->
        <ContextMenu x:Key="FileListContextMenu" DataContext="{Binding Data.DataContext, Source={StaticResource ControlProxy}}">
            <MenuItem x:Name="CopyItem" Header="复制" 
                      Command="{Binding Commands.CopyCommand}" 
                      Visibility="{Binding Selection.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Icon="📄"/>
            <MenuItem x:Name="CutItem" Header="剪切" 
                      Command="{Binding Commands.CutCommand}" 
                      Visibility="{Binding Selection.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Icon="✂️"/>
            <MenuItem x:Name="PasteItem" Header="粘贴" 
                      Command="{Binding Commands.PasteCommand}" 
                      Icon="📋"/>
            <Separator Visibility="{Binding Selection.IsNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem Header="新建" Visibility="{Binding Selection.IsNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}" Icon="➕">
                <MenuItem Header="文件夹" Command="{Binding Commands.NewFolderCommand}" Icon="📁"/>
                <MenuItem Header="文本文档" Command="{Binding Commands.NewFileCommand}" Icon="📄"/>
            </MenuItem>
            <Separator Visibility="{Binding Selection.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem x:Name="DeleteItem" Header="删除" 
                      Command="{Binding Commands.DeleteCommand}" 
                      Visibility="{Binding Selection.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Icon="🗑️"/>
            <MenuItem x:Name="RenameItem" Header="重命名" 
                      Command="{Binding Commands.RenameCommand}" 
                      Visibility="{Binding Selection.IsSingleSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Icon="✏️"/>
            <Separator Visibility="{Binding Selection.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem x:Name="AddToLibraryMenuItem" Header="📚 添加到库" 
                      Visibility="{Binding Selection.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ItemsSource="{Binding LibraryMenuItems}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Header}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                        <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
                        <Setter Property="Icon" Value="{Binding Icon}"/>
                        <Setter Property="IsCheckable" Value="{Binding IsCheckable}"/>
                        <Setter Property="IsChecked" Value="{Binding IsChecked}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Separator Margin="0,2" Background="{DynamicResource BorderBrush}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem x:Name="AddFavoriteMenuItem" Header="⭐ 添加到收藏" 
                      Visibility="{Binding Selection.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ItemsSource="{Binding FavoriteMenuItems}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Header}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                        <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
                        <Setter Property="Icon" Value="{Binding Icon}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Separator Margin="0,2" Background="{DynamicResource BorderBrush}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem x:Name="AddTagMenuItem" Header="🏷️ 添加标签" 
                      Visibility="{Binding Selection.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ItemsSource="{Binding TagMenuItems}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Header}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                        <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
                        <Setter Property="IsCheckable" Value="True"/>
                        <Setter Property="IsChecked" Value="{Binding IsChecked}"/>
                        <Setter Property="Icon">
                            <Setter.Value>
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" 
                                           Fill="{Binding IconBrush, TargetNullValue=Transparent}"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Separator Margin="0,2" Background="{DynamicResource BorderBrush}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Icon" Value="{x:Null}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator Visibility="{Binding Selection.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem x:Name="RefreshItem" Header="刷新" 
                      Command="{Binding Commands.RefreshCommand}" 
                      Visibility="{Binding Selection.IsNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Icon="🔄"/>
            <MenuItem x:Name="PropertiesItem" Header="属性" 
                      Command="{Binding Commands.PropertiesCommand}" 
                      Icon="ℹ️"/>
        </ContextMenu>
    </ResourceDictionary>
</UserControl.Resources>
    
    <Grid x:Name="RootGrid" Margin="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: 地址栏 -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: 工具栏行 -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: 搜索状态提示 -->
            <RowDefinition Height="*"/>     <!-- Row 3: 文件列表 -->
            <RowDefinition Height="12"/>     <!-- Row 4: Splitter -->
            <RowDefinition Height="180" MinHeight="120"/> <!-- Row 5: Info Panel -->
        </Grid.RowDefinitions>

        <!-- Row 0: 地址栏（纯地址输入） -->
        <Border Grid.Row="0" Background="Transparent" Margin="0,4,0,4">
            <controls:AddressBarControl x:Name="AddressBarControl" Margin="8,0" 
                                       AddressText="{Binding CurrentPath, Mode=TwoWay}"
                                       IsReadOnly="{Binding IsAddressReadOnly}"/>
        </Border>
        
        <!-- Row 1: 工具栏行（导航 + 操作 + 视图 + 搜索） -->
        <Border Grid.Row="1" Background="Transparent" Margin="0,0,0,4">
            <Grid Margin="8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- 导航按钮 -->
                    <ColumnDefinition Width="8"/>     <!-- 间距 -->
                    <ColumnDefinition Width="Auto"/>  <!-- TitleActionBar -->
                    <ColumnDefinition Width="*"/>     <!-- 填充 -->
                    <ColumnDefinition Width="Auto"/>  <!-- 视图切换 -->
                    <ColumnDefinition Width="8"/>     <!-- 间距 -->
                    <ColumnDefinition Width="Auto"/>  <!-- 搜索/筛选 -->
                </Grid.ColumnDefinitions>
                
                <!-- 导航按钮 (←→↑) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Name="NavBackBtn" Command="{Binding Commands.NavigateBackCommand}" ToolTip="后退" Style="{StaticResource ModernToolbarButtonStyle}"><Image Source="{DynamicResource Icon_Back}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                    <Button Name="NavForwardBtn" Command="{Binding Commands.NavigateForwardCommand}" ToolTip="前进" Style="{StaticResource ModernToolbarButtonStyle}"><Image Source="{DynamicResource Icon_Forward}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                    <Button Name="NavUpBtn" Command="{Binding Commands.NavigateUpCommand}" ToolTip="向上" Style="{StaticResource ModernToolbarButtonStyle}"><Image Source="{DynamicResource Icon_Up}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                    <!-- Undo/Redo -->
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="4,0" VerticalAlignment="Center"/>
                    <Button Name="UndoBtn" 
                            Command="{Binding Commands.UndoCommand}" 
                            ToolTip="撤销" Style="{StaticResource ToolbarButtonStyle}"><Image Source="{DynamicResource Icon_Back}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                    <Button Name="RedoBtn" 
                            Command="{Binding Commands.RedoCommand}" 
                            ToolTip="重做" Style="{StaticResource ToolbarButtonStyle}"><Image Source="{DynamicResource Icon_Forward}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                </StackPanel>
                
                <!-- TitleActionBar (操作按钮) -->
                <controls:TitleActionBar Grid.Column="2" x:Name="TitleActionBar" Mode="{Binding NavigationMode}"/>
                
                <!-- 视图切换按钮 (下拉菜单) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Name="PropertiesBtn"
                            Visibility="{Binding IsPropertiesButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding Commands.PropertiesCommand}" Style="{StaticResource ModernToolbarButtonStyle}" ToolTip="属性"
                            Margin="0,0,4,0"><Image Source="{DynamicResource Icon_Settings}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                    <Button Name="ViewModeBtn"
                            Click="ViewModeBtn_DropDown" Style="{StaticResource ModernToolbarButtonStyle}" ToolTip="视图模式">
                        <Image Source="{DynamicResource Icon_ViewList}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Button.ContextMenu>
                            <ContextMenu Name="ViewModeMenu">
                                <ContextMenu.Resources>
                                    <Style x:Key="ViewModeItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Margin" Value="2,1"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <!-- 默认背景透明 -->
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <!-- 当当前模式与此项匹配时 -->
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource EqualityToBoolConverter}">
                                                        <Binding Path="DataContext.FileViewMode" RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                                        <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <!-- 使用主题资源设置选中态 -->
                                                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="📋 列表" 
                                          Command="{Binding Commands.SwitchViewModeCommand}" CommandParameter="List"
                                          Style="{StaticResource ViewModeItemStyle}"/>
                                <MenuItem Header="📝 紧凑列表" 
                                          Command="{Binding Commands.SwitchViewModeCommand}" CommandParameter="Compact"
                                          Style="{StaticResource ViewModeItemStyle}"/>
                                <Separator/>
                                <MenuItem Header="🖼️ 缩略图" 
                                          Command="{Binding Commands.SwitchViewModeCommand}" CommandParameter="Thumbnail"
                                          Style="{StaticResource ViewModeItemStyle}"/>
                                <MenuItem Header="🔲 平铺" 
                                          Command="{Binding Commands.SwitchViewModeCommand}" CommandParameter="Tiles"
                                          Style="{StaticResource ViewModeItemStyle}"/>
                                <MenuItem Header="📎 小图标" 
                                          Command="{Binding Commands.SwitchViewModeCommand}" CommandParameter="SmallIcons"
                                          Style="{StaticResource ViewModeItemStyle}"/>
                                <Separator/>
                                <MenuItem Header="📄 内容" 
                                          Command="{Binding Commands.SwitchViewModeCommand}" CommandParameter="Content"
                                          Style="{StaticResource ViewModeItemStyle}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                
                <!-- 预览和筛选按钮 -->
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Name="FilterBtn"
                            Command="{Binding Filter.ToggleFilterPanelCommand}"
                            Style="{StaticResource ModernToolbarButtonStyle}" ToolTip="筛选">
                        <Image Source="{DynamicResource Icon_Filter}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Row 2: 搜索状态提示条 -->
        <Border x:Name="SearchStatusBar" Grid.Row="2" Background="{DynamicResource AccentSubtleBrush}" 
                Visibility="{Binding Filter.IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="8,4" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SearchStatusIcon" Text="🔍" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SearchStatusText" Text="{Binding Filter.SearchStatusText}" 
                          Foreground="{DynamicResource ForegroundPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Row 3: 文件列表 -->
        <controls:FileListControl Grid.Row="3" x:Name="FileList" 
                                 ItemsSource="{Binding Files}"
                                 CurrentViewMode="{Binding FileViewMode, Mode=TwoWay}"
                                 LoadMoreCommand="{Binding Filter.LoadMoreCommand}"
                                 IsLoadMoreVisible="{Binding Filter.IsLoadMoreVisible}"
                                 FocusVisualStyle="{x:Null}"/>
        
        <!-- Row 4: 水平分割器（文件列表与信息面板之间） -->
        <controls:CollapsibleGridSplitter Grid.Row="4" x:Name="BottomGridSplitter"
                      Style="{StaticResource HorizontalCollapsibleGridSplitterStyle}"
                      CollapseMode="Both"
                      HorizontalAlignment="Stretch"
                      Panel.ZIndex="999"
                      AutoFillNeighbor="True"
                      ShowsPreview="False"
                      DragStarted="GridSplitter_DragStarted"
                      DragDelta="GridSplitter_DragDelta"
                      DragCompleted="GridSplitter_DragCompleted"/>
        
        <!-- Row 5: 底部信息与内嵌预览区（在非独立预览模式下显示） -->
        <Grid Grid.Row="5" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="BottomPreviewCol">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="300"/>
                            <Setter Property="MinWidth" Value="200"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInnerPreviewVisible}" Value="False">
                                    <Setter Property="Width" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!-- 左侧：原有文件信息面板 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="8,4">
                <StackPanel x:Name="FileInfoPanel" Margin="4"/>
            </ScrollViewer>

            <!-- 中间：分割器（可用来调整内嵌预览宽度） -->
            <controls:CollapsibleGridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Center" VerticalAlignment="Stretch" Style="{StaticResource VerticalCollapsibleGridSplitterStyle}"
                                              Visibility="{Binding IsInnerPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- 右侧：内嵌竖向Tab的预览/备注面板 -->
            <controls:InnerPreviewAttachmentControl x:Name="BottomPreviewControl" Grid.Column="2" DataContext="{Binding Preview}" 
                                               Visibility="{Binding DataContext.IsInnerPreviewVisible, RelativeSource={RelativeSource AncestorType=controls:FileBrowserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- 筛选弹出面板 -->
        <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterBtn}" 
               IsOpen="{Binding Filter.IsFilterPanelVisible, Mode=TwoWay}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Placement="Bottom" VerticalOffset="4">
            <Border Background="{DynamicResource BackgroundPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Effect="{DynamicResource DropShadowEffect}">
                <controls:FilterPanel x:Name="FilterPanelControl" DataContext="{Binding Search}" Options="{Binding DataContext.Filter.SearchOptions, RelativeSource={RelativeSource AncestorType=controls:FileBrowserControl}}"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>


