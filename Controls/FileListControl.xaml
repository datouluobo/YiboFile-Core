<UserControl x:Name="FileListRoot" x:Class="YiboFile.Controls.FileListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:YiboFile.ViewModels"
             xmlns:colmgr="clr-namespace:YiboFile.Services.UI.ColumnManagement"
             xmlns:local="clr-namespace:YiboFile.Controls"
             xmlns:converters="clr-namespace:YiboFile.Controls.Converters"
             xmlns:helpers="clr-namespace:YiboFile.Helpers"
             xmlns:wpftk="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:i18n="clr-namespace:YiboFile.Services.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToThicknessConverter x:Key="NullToThicknessConverter"/>
        <helpers:ResourceKeyConverter x:Key="ResourceKeyConverter"/>

        <!-- Library Card Template (Grid Layout Card with Glassmorphism) -->
        <DataTemplate x:Key="LibraryCardTemplate">
            <Border Width="240" Height="160" Margin="10" 
                    CornerRadius="12"
                    ClipToBounds="True"
                    Background="Transparent">
                <Grid>
                    <!-- Background with Glassmorphism effect -->
                    <Border x:Name="BackgroundBorder" 
                            Background="{DynamicResource BackgroundTertiaryBrush}" 
                            Opacity="0.7" 
                            CornerRadius="12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <Border.CacheMode>
                            <BitmapCache RenderAtScale="1" EnableClearType="False" SnapsToDevicePixels="True"/>
                        </Border.CacheMode>
                    </Border>

                    <!-- Selection/Hover Overlay -->
                    <Border x:Name="OverlayBorder" CornerRadius="12" Background="{DynamicResource AccentBrush}" Opacity="0"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Icon with Folder + Library Branding -->
                        <Grid Width="80" Height="80" Margin="0,0,0,12">
                            <!-- Background folder shape (Layered) -->
                            <TextBlock Text="📁" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" Margin="4,4,0,0"/>
                            <TextBlock x:Name="IconText" Text="📚" Foreground="{DynamicResource AccentBrush}" 
                                       FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="{Binding Name}" 
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                        
                        <TextBlock Text="库" 
                                   FontSize="11" Opacity="0.6"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                    <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                    <Setter TargetName="OverlayBorder" Property="Opacity" Value="0.1"/>
                    <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="BackgroundBorder" Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.9"/>
                    <Setter TargetName="OverlayBorder" Property="Opacity" Value="0.05"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="IconText" Storyboard.TargetProperty="FontSize" To="58" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="IconText" Storyboard.TargetProperty="FontSize" To="52" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ThumbnailTemplate">
            <Border Width="{Binding ItemWidth, ElementName=FileListRoot, FallbackValue=120}" 
                    Height="{Binding ItemHeight, ElementName=FileListRoot, FallbackValue=140}" 
                    Margin="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 缩略图区域 -->
                    <Image Grid.Row="0"
                           Source="{Binding Thumbnail}" 
                           Width="{Binding ThumbnailSize, ElementName=FileListRoot, FallbackValue=100}" 
                           Height="{Binding ThumbnailSize, ElementName=FileListRoot, FallbackValue=100}"
                           Stretch="Uniform" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    
                    <!-- 文件名区域 -->
                    <Grid Grid.Row="1" x:Name="ThumbnailNameGrid">
                        <TextBlock x:Name="ThumbnailFileName"
                                   Text="{Binding Name}" 
                                   TextAlignment="Center" 
                                   TextWrapping="Wrap" 
                                   MaxHeight="36" 
                                   TextTrimming="CharacterEllipsis"
                                   Margin="4,2"
                                   FontSize="11"
                                   ToolTip="{Binding Name}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- 缩略图模式重命名浮层 -->
                        <local:RenameOverlay LostFocusBehavior="{Binding DataContext.RenameLostFocusBehavior, RelativeSource={RelativeSource AncestorType=local:FileListControl}}"
                            IsOpen="{Binding IsRenaming}"
                            Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlacementTarget="{Binding ElementName=ThumbnailFileName}"
                            IsDirectory="{Binding IsDirectory}"
                            TextFontSize="11"
                            TextAlignment="Center"
                            TextPadding="0,0,0,0"
                            PopupHorizontalOffset="-3"
                            PopupVerticalOffset="-2"
                            MinTextWidth="100"
                            MaxTextWidth="300"
                            RenameConfirmed="RenameOverlay_RenameConfirmed"
                            RenameCancelled="RenameOverlay_RenameCancelled"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 平铺视图模板 (Tiles) - 64x64图标 + 多行详细文本 -->
        <DataTemplate x:Key="TilesTemplate">
            <Border Width="250" Height="72" Margin="4" Background="Transparent" 
                    ToolTip="{Binding Path}">
                <Grid x:Name="TilesGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 图标/缩略图 -->
                    <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="64" Height="64" 
                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- 详细信息 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock x:Name="TilesFileName" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" 
                                   Foreground="{DynamicResource ForegroundPrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Type}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding Size}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11"/>
                    </StackPanel>

                    <!-- 平铺重命名 Overlay -->
                    <local:RenameOverlay LostFocusBehavior="{Binding DataContext.RenameLostFocusBehavior, RelativeSource={RelativeSource AncestorType=local:FileListControl}}"
                        IsOpen="{Binding IsRenaming}"
                        Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlacementTarget="{Binding ElementName=TilesFileName}"
                        IsDirectory="{Binding IsDirectory}"
                        TextFontSize="13"
                        TextFontWeight="SemiBold"
                        TextPadding="0,0,0,0"
                        PopupHorizontalOffset="-3"
                        PopupVerticalOffset="-2"
                        MinTextWidth="180"
                        MaxTextWidth="300"
                        RenameConfirmed="RenameOverlay_RenameConfirmed"
                        RenameCancelled="RenameOverlay_RenameCancelled"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 内容视图模板 (Content) - 单行展开式详细信息 -->
        <DataTemplate x:Key="ContentTemplate">
            <Border Height="56" Margin="2" Background="Transparent" 
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1"
                    ToolTip="{Binding Path}">
                <Grid Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 图标 -->
                    <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="40" Height="40" 
                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- 名称 + 类型 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock x:Name="ContentFileName" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ForegroundPrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Type}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text=" · " Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding Size}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text=" · " Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding ModifiedDate}" Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 标签/备注 -->
                    <TextBlock Grid.Column="2" Text="{Binding Notes}" MaxWidth="200" TextTrimming="CharacterEllipsis" 
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0"/>

                    <!-- 内容重命名 Overlay -->
                    <local:RenameOverlay LostFocusBehavior="{Binding DataContext.RenameLostFocusBehavior, RelativeSource={RelativeSource AncestorType=local:FileListControl}}"
                        IsOpen="{Binding IsRenaming}"
                        Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlacementTarget="{Binding ElementName=ContentFileName}"
                        IsDirectory="{Binding IsDirectory}"
                        TextFontSize="13"
                        TextFontWeight="SemiBold"
                        TextPadding="0,0,0,0"
                        PopupHorizontalOffset="-3"
                        PopupVerticalOffset="-2"
                        MinTextWidth="280"
                        MaxTextWidth="600"
                        RenameConfirmed="RenameOverlay_RenameConfirmed"
                        RenameCancelled="RenameOverlay_RenameCancelled"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 小图标视图模板 (SmallIcons) - 16px图标 + 文件名 -->
        <DataTemplate x:Key="SmallIconsTemplate">
            <Border Width="180" Height="28" Margin="2" Background="Transparent"
                    ToolTip="{Binding Path}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <Image Source="{Binding Thumbnail}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SmallIconFileName" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ForegroundPrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- 小图标重命名 Overlay -->
                    <local:RenameOverlay LostFocusBehavior="{Binding DataContext.RenameLostFocusBehavior, RelativeSource={RelativeSource AncestorType=local:FileListControl}}"
                        IsOpen="{Binding IsRenaming}"
                        Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlacementTarget="{Binding ElementName=SmallIconFileName}"
                        IsDirectory="{Binding IsDirectory}"
                        TextFontSize="13"
                        TextPadding="0,0,0,0"
                        PopupHorizontalOffset="-3"
                        PopupVerticalOffset="-2"
                        MinTextWidth="140"
                        MaxTextWidth="400"
                        RenameConfirmed="RenameOverlay_RenameConfirmed"
                        RenameCancelled="RenameOverlay_RenameCancelled"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 紧凑列表模板 (Compact) - 单行简化 -->
        <DataTemplate x:Key="CompactTemplate">
            <Border Height="24" Margin="0" Background="Transparent" 
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1"
                    ToolTip="{Binding Path}">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="16" Height="16" Stretch="Uniform"/>
                    <TextBlock Grid.Column="1" x:Name="CompactFileName" Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0" 
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ForegroundPrimaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right" VerticalAlignment="Center" 
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11"/>
                    <TextBlock Grid.Column="3" Text="{Binding ModifiedDate}" HorizontalAlignment="Right" VerticalAlignment="Center" 
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" FontSize="11"/>

                    <!-- 紧凑重命名 Overlay -->
                    <local:RenameOverlay LostFocusBehavior="{Binding DataContext.RenameLostFocusBehavior, RelativeSource={RelativeSource AncestorType=local:FileListControl}}"
                        IsOpen="{Binding IsRenaming}"
                        Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlacementTarget="{Binding ElementName=CompactFileName}"
                        IsDirectory="{Binding IsDirectory}"
                        TextFontSize="13"
                        TextPadding="0,0,0,0"
                        PopupHorizontalOffset="-3"
                        PopupVerticalOffset="-2"
                        MinTextWidth="160"
                        MaxTextWidth="400"
                        RenameConfirmed="RenameOverlay_RenameConfirmed"
                        RenameCancelled="RenameOverlay_RenameCancelled"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 缩略图视图的 WrapPanel 布局 -->
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <wpftk:VirtualizingWrapPanel Orientation="Horizontal" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>

        <!-- 列表视图的 VirtualizingStackPanel 布局 -->
        <ItemsPanelTemplate x:Key="StackPanelTemplate">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>



        <local:FileListTemplateSelector x:Key="FileListItemSelector"
                                      LibraryTemplate="{StaticResource LibraryCardTemplate}"
                                      DefaultTemplate="{StaticResource ThumbnailTemplate}"/>
    </UserControl.Resources>
    <Grid>
        <!-- 文件列表 -->
        <Border Background="Transparent">
            <Grid>
                <!-- 普通列表视图 -->
                <ListView x:Name="FilesListView" 
                      SelectionMode="Extended"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      FocusVisualStyle="{x:Null}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.InputBindings>
                    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding Commands.CopyCommand}"/>
                    <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding Commands.CutCommand}"/>
                    <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding Commands.PasteCommand}"/>
                    <KeyBinding Key="Delete" Command="{Binding Commands.DeleteCommand}"/>
                    <KeyBinding Key="F2" Command="{Binding Commands.RenameCommand}"/>
                    <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding Commands.SelectAllCommand}"/>
                    <KeyBinding Key="F5" Command="{Binding Commands.RefreshCommand}"/>
                    <KeyBinding Key="Enter" Command="{Binding Commands.PropertiesCommand}" Modifiers="Alt"/> 
                </ListView.InputBindings>
                <ListView.ItemContainerStyle>
                        <StaticResource ResourceKey="FileListItemStyle"/>
                    </ListView.ItemContainerStyle>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderDefaultBrush}">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal" Margin="4">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,8,0"
                                                                       Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding ItemCount, StringFormat=({0})}" VerticalAlignment="Center" 
                                                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView x:Name="FilesGridView" ColumnHeaderContainerStyle="{StaticResource FileListColumnHeaderStyle}">
                            <GridViewColumn x:Name="ColName">
                                <GridViewColumn.Header>
                                    <TextBlock Text="{i18n:Loc Key=FileList.Columns.Name}" Tag="Name"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="NameCellGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- 图标 -->
                                            <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"/>
                                            
                                            <TextBlock Grid.Column="1" x:Name="FileNameText" Text="{Binding Name}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- 列表视图重命名 Overlay -->
                                            <local:RenameOverlay LostFocusBehavior="{Binding DataContext.RenameLostFocusBehavior, RelativeSource={RelativeSource AncestorType=local:FileListControl}}"
                                                IsOpen="{Binding IsRenaming}"
                                                Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PlacementTarget="{Binding ElementName=FileNameText}"
                                                IsDirectory="{Binding IsDirectory}"
                                                TextFontSize="13"
                                                TextPadding="0"
                                                PopupHorizontalOffset="-4"
                                                PopupVerticalOffset="-3"
                                                MinTextWidth="180"
                                                MaxTextWidth="500"
                                                RenameConfirmed="RenameOverlay_RenameConfirmed"
                                                RenameCancelled="RenameOverlay_RenameCancelled"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            
                            <GridViewColumn x:Name="ColType" Width="80" HeaderContainerStyle="{StaticResource NonResizableFileColumnHeaderStyle}" DisplayMemberBinding="{Binding Type}">
                                <GridViewColumn.Header>
                                    <TextBlock Text="{i18n:Loc Key=FileList.Columns.Type}" Tag="Type"/>
                                </GridViewColumn.Header>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColSize" Width="100" HeaderContainerStyle="{StaticResource NonResizableFileColumnHeaderStyle}">
                                <GridViewColumn.Header>
                                    <TextBlock Text="{i18n:Loc Key=FileList.Columns.Size}" Tag="Size"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Size}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColModifiedDate" Width="100" HeaderContainerStyle="{StaticResource NonResizableFileColumnHeaderStyle}" DisplayMemberBinding="{Binding ModifiedDate}">
                                <GridViewColumn.Header>
                                    <TextBlock Text="{i18n:Loc Key=FileList.Columns.ModifiedDate}" Tag="ModifiedDate"/>
                                </GridViewColumn.Header>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColCreatedTime" Width="70">
                                <GridViewColumn.Header>
                                    <TextBlock Text="{i18n:Loc Key=FileList.Columns.CreatedTime}" Tag="CreatedTime"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource NonResizableFileColumnHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,8"/>
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Border Background="{Binding CreatedTimeBrush}" 
                                                    CornerRadius="10" 
                                                    MinWidth="48"
                                                    Padding="6,2"
                                                    Height="20"
                                                    VerticalAlignment="Center" 
                                                    HorizontalAlignment="Center">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.12"/>
                                                </Border.Effect>
                                                <TextBlock Text="{Binding CreatedTime}" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center" 
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundOnAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            
                            <GridViewColumn x:Name="ColTags" Width="150" HeaderContainerStyle="{StaticResource NonResizableFileColumnHeaderStyle}">
                                <GridViewColumn.Header>
                                    <TextBlock Text="{i18n:Loc Key=FileList.Columns.Tags}" Tag="Tags"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding TagList}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                             <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Name}" 
                                                            Background="{Binding ColorBrush}"
                                                            Foreground="{DynamicResource ForegroundOnAccentBrush}"
                                                            Margin="0,0,4,2"
                                                            Padding="6,2"
                                                            BorderThickness="0"
                                                            FontSize="11"
                                                            Click="Tag_Click"
                                                            Cursor="Hand"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="border" 
                                                                        Background="{TemplateBinding Background}" 
                                                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                                        BorderThickness="{Binding Color, Converter={StaticResource NullToThicknessConverter}}"
                                                                        CornerRadius="4" 
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColNotes" Width="200" HeaderContainerStyle="{StaticResource NonResizableFileColumnHeaderStyle}" DisplayMemberBinding="{Binding Notes}">
                                <GridViewColumn.Header>
                                    <TextBlock Text="{i18n:Loc Key=FileList.Columns.Notes}" Tag="Notes"/>
                                </GridViewColumn.Header>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                

                
                <!-- 加载更多按钮 -->
                <Button x:Name="LoadMoreBtn" Content="{i18n:Loc Key=FileList.LoadMore}" Width="88" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                        Visibility="Collapsed" 
                        Command="{Binding LoadMoreCommand, ElementName=FileListRoot}"/>
                
                <!-- 空状态提示 -->
                <TextBlock x:Name="EmptyStateText" 
                           Text="{i18n:Loc Key=FileList.EmptyState}"
                           FontSize="16"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                
                <!-- 框选覆盖层 - 仅用于绘制选择矩形，不拦截鼠标事件 -->
                <Canvas x:Name="LassoSelectionCanvas" 
                        Background="Transparent" 
                        IsHitTestVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Panel.ZIndex="100"/>

                <!-- 列拖拽位置指示器 (垂直线) -->
                <Canvas x:Name="ColumnDropIndicatorCanvas"
                        Background="Transparent"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Panel.ZIndex="200"
                        Visibility="Collapsed">
                    <Border x:Name="ColumnDropIndicator"
                            Width="3"
                            Height="30"
                            Background="{DynamicResource AccentBrush}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{DynamicResource AccentColor}" Opacity="0.8"/>
                        </Border.Effect>
                    </Border>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</UserControl>



