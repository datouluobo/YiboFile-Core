<UserControl x:Class="YiboFile.Controls.ManagementPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:YiboFile.Controls.Settings"
             xmlns:i18n="clr-namespace:YiboFile.Services.Localization"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800"
             Background="{DynamicResource BackgroundPrimaryBrush}"
             Foreground="{DynamicResource ForegroundPrimaryBrush}">

    <UserControl.Resources>
        <!-- Modern TabItem Style — 使用浮动指示条，不占用布局空间 -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <!-- 主体内容 — 底部无占位指示线 -->
                            <Border Name="Border" BorderThickness="0" Margin="0,0,10,0" Padding="15,10,15,10">
                                <ContentPresenter x:Name="ContentSite"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                ContentSource="Header"
                                                RecognizesAccessKey="True"/>
                            </Border>
                            <!-- 浮动指示条 — 覆盖层，不占用布局空间 -->
                            <Rectangle Name="Indicator"
                                       Fill="Transparent"
                                       Height="3"
                                       VerticalAlignment="Bottom"
                                       Margin="8,0,8,0"
                                       RadiusX="1.5" RadiusY="1.5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Indicator" Property="Fill" Value="{DynamicResource AccentDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab Header Area -->
        <Border BorderThickness="0" BorderBrush="{DynamicResource BorderDefaultBrush}"
                Background="{DynamicResource BackgroundSecondaryBrush}" Padding="15,5,15,0">
            <TabControl x:Name="MainTabControl" BorderThickness="0" Background="Transparent"
                        SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem Header="{i18n:Loc Key=Settings.Menu.Path}" Tag="Path"/>
                <TabItem Header="{i18n:Loc Key=Settings.Menu.Library}" Tag="Library"/>
                <TabItem Header="{i18n:Loc Key=Settings.Menu.Tag}" Tag="Tag"/>
            </TabControl>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="1" Padding="0">
            <ContentControl x:Name="TabContentArea"/>
        </Border>
    </Grid>
</UserControl>
