<UserControl x:Class="YiboFile.Controls.Settings.TagSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i18n="clr-namespace:YiboFile.Services.Localization"
             mc:Ignorable="d" 
             Focusable="True" FocusVisualStyle="{x:Null}"
             d:DesignHeight="600" d:DesignWidth="800">
    <StackPanel Margin="20">
        <StackPanel.Resources>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <EventSetter Event="KeyDown" Handler="NumericTextBox_KeyDown" />
                <EventSetter Event="LostFocus" Handler="NumericTextBox_LostFocus" />
                <EventSetter Event="PreviewTextInput" Handler="NumericTextBox_PreviewTextInput" />
            </Style>
        </StackPanel.Resources>

        <TextBlock Text="{i18n:Loc Key=Settings.Tag.FontVisualSettings}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
        

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{i18n:Loc Key=Settings.Tag.SpecificFontSize}" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="110" MinHeight="32" Grid.Column="0" />
            <TextBox MaxLength="3" Text="{Binding TagFontSizeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Width="60" Height="32" VerticalContentAlignment="Center" TextAlignment="Center" Padding="5,0,5,0" Margin="0,0,8,0" Grid.Column="1" />
            <StackPanel Orientation="Vertical" Grid.Column="2" VerticalAlignment="Center">
                <Button Content="▲" Width="24" Height="16" FontSize="10" Padding="0" Margin="0,0,0,2" VerticalAlignment="Center" Click="TagFontSizeUp_Click" Style="{DynamicResource ModernButtonStyle}" />
                <Button Content="▼" Width="24" Height="16" FontSize="10" Padding="0" VerticalAlignment="Center" Click="TagFontSizeDown_Click" Style="{DynamicResource ModernButtonStyle}" />
            </StackPanel>
            <TextBlock Text="{i18n:Loc Key=Settings.Tag.SpecificFontSizeDesc}" FontSize="12" Foreground="{DynamicResource ForegroundSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0" Grid.Column="3" TextWrapping="Wrap" />
        </Grid>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{i18n:Loc Key=Settings.Tag.FixedWidth}" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="110" MinHeight="32" Grid.Column="0" />
            <TextBox MaxLength="4" Text="{Binding TagBoxWidthInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Width="60" Height="32" VerticalContentAlignment="Center" TextAlignment="Center" Padding="5,0,5,0" Margin="0,0,8,0" Grid.Column="1" />
            <StackPanel Orientation="Vertical" Grid.Column="2" VerticalAlignment="Center">
                <Button Content="▲" Width="24" Height="16" FontSize="10" Padding="0" Margin="0,0,0,2" VerticalAlignment="Center" Click="TagBoxWidthUp_Click" Style="{DynamicResource ModernButtonStyle}" />
                <Button Content="▼" Width="24" Height="16" FontSize="10" Padding="0" VerticalAlignment="Center" Click="TagBoxWidthDown_Click" Style="{DynamicResource ModernButtonStyle}" />
            </StackPanel>
            <TextBlock Text="{i18n:Loc Key=Settings.Tag.FixedWidthDesc}" FontSize="12" Foreground="{DynamicResource ForegroundSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0" Grid.Column="3" TextWrapping="Wrap" />
        </Grid>

    </StackPanel>
</UserControl>
