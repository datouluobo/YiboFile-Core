<UserControl x:Class="YiboFile.Controls.Settings.GeneralSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <StackPanel Margin="20">
        
        <TextBlock Text="外观设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
        <TextBlock Text="提示：主题、颜色、透明度等外观设置已移至&#34;外观&#34;设置面板。" FontSize="12" Margin="0,0,0,24" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundSecondaryBrush}"  />

        <TextBlock Text="窗口设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
        <!-- 逻辑上 ViewModel 没实现的放在视图层占位 -->
        <CheckBox Content="记住窗口位置和大小" FontSize="14" MinHeight="32" Margin="0,0,0,10" IsChecked="True" />
        <CheckBox Content="启动时最大化窗口" FontSize="14" MinHeight="32" Margin="0,0,0,24" IsChecked="{Binding IsMaximized, Mode=TwoWay}" />
        <CheckBox Content="启用多窗口支持 (Ctrl+Shift+N)" FontSize="14" MinHeight="32" Margin="0,0,0,10" IsChecked="{Binding EnableMultiWindow, Mode=TwoWay}" />
        <CheckBox Content="中键打开新标签页时立即激活 (否则在后台打开)" FontSize="14" MinHeight="32" Margin="0,0,0,24" IsChecked="{Binding ActivateNewTabOnMiddleClick, Mode=TwoWay}" />

        <TextBlock Text="标签页宽度模式:" FontSize="14" Margin="0,8,0,8" />
        <StackPanel Orientation="Horizontal" Margin="20,0,0,4">
            <RadioButton Content="固定宽度（所有标签统一宽度）" GroupName="TabWidthMode" FontSize="14" MinHeight="32" VerticalAlignment="Center" x:Name="TabWidthFixedRadio" Checked="TabWidthMode_Checked" />
            <TextBlock Text="宽度(50-300):" FontSize="14" VerticalAlignment="Center" Margin="20,0,8,0" x:Name="PinnedTabWidthLabel" />
            <TextBox Text="{Binding PinnedTabWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Width="60" Height="36" VerticalContentAlignment="Center" TextAlignment="Center" Padding="5,0,5,0" Margin="0,0,8,0" x:Name="PinnedTabWidthTextBox" PreviewTextInput="NumericOnly_PreviewTextInput" />
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <Button Content="▲" Width="24" Height="16" FontSize="10" Padding="0" Margin="0,0,0,2" Click="PinnedTabWidthUp_Click" Style="{DynamicResource ModernButtonStyle}" />
                <Button Content="▼" Width="24" Height="16" FontSize="10" Padding="0" Click="PinnedTabWidthDown_Click" Style="{DynamicResource ModernButtonStyle}" />
            </StackPanel>
        </StackPanel>
        <RadioButton Content="动态宽度（根据文本长度自适应）" GroupName="TabWidthMode" FontSize="14" MinHeight="32" Margin="20,0,0,24" x:Name="TabWidthDynamicRadio" Checked="TabWidthMode_Checked" />

        <TextBlock Text="字体设置" FontSize="18" FontWeight="Bold" Margin="0,24,0,16" />
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="字体大小:" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="140" MinHeight="32" Grid.Column="0" />
            <TextBox Text="{Binding UIFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Width="60" Height="32" VerticalContentAlignment="Center" TextAlignment="Center" Padding="5,0,5,0" Margin="0,0,8,0" Grid.Column="1" PreviewTextInput="NumericOnly_PreviewTextInput" />
            <StackPanel Orientation="Vertical" Grid.Column="2">
                <Button Content="▲" Width="24" Height="16" FontSize="10" Padding="0" Margin="0,0,0,2" VerticalAlignment="Center" Click="UIFontSizeUp_Click" Style="{DynamicResource ModernButtonStyle}" />
                <Button Content="▼" Width="24" Height="16" FontSize="10" Padding="0" VerticalAlignment="Center" Click="UIFontSizeDown_Click" Style="{DynamicResource ModernButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tag字号:" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="140" MinHeight="32" Grid.Column="0" />
            <TextBox Text="{Binding TagFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Width="60" Height="32" VerticalContentAlignment="Center" TextAlignment="Center" Padding="5,0,5,0" Margin="0,0,8,0" Grid.Column="1" PreviewTextInput="NumericOnly_PreviewTextInput" />
            <StackPanel Orientation="Vertical" Grid.Column="2">
                <Button Content="▲" Width="24" Height="16" FontSize="10" Padding="0" Margin="0,0,0,2" VerticalAlignment="Center" Click="TagFontSizeUp_Click" Style="{DynamicResource ModernButtonStyle}" />
                <Button Content="▼" Width="24" Height="16" FontSize="10" Padding="0" VerticalAlignment="Center" Click="TagFontSizeDown_Click" Style="{DynamicResource ModernButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tag框宽度:" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="140" MinHeight="32" Grid.Column="0" />
            <TextBox Text="{Binding TagBoxWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Width="60" Height="32" VerticalContentAlignment="Center" TextAlignment="Center" Padding="5,0,5,0" Margin="0,0,8,0" Grid.Column="1" PreviewTextInput="NumericOnly_PreviewTextInput" />
            <StackPanel Orientation="Vertical" Grid.Column="2">
                <Button Content="▲" Width="24" Height="16" FontSize="10" Padding="0" Margin="0,0,0,2" VerticalAlignment="Center" Click="TagBoxWidthUp_Click" Style="{DynamicResource ModernButtonStyle}" />
                <Button Content="▼" Width="24" Height="16" FontSize="10" Padding="0" VerticalAlignment="Center" Click="TagBoxWidthDown_Click" Style="{DynamicResource ModernButtonStyle}" />
            </StackPanel>
        </Grid>
        <TextBlock Text="（0表示自动计算，>0表示固定宽度，范围：0-500）" FontSize="12" Margin="152,-8,0,0" Foreground="{DynamicResource ForegroundSecondaryBrush}" />

        <TextBlock Text="路径设置" FontSize="18" FontWeight="Bold" Margin="0,24,0,8" />
        <TextBlock Text="默认目录：程序根目录下的 .\AppData\ （配置、数据文件集中存储）" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundSecondaryBrush}" />
        
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="当前目录:" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="140" MinHeight="36" Grid.Column="0" />
            <TextBox Text="{Binding BaseDirectory, Mode=OneWay}" FontSize="14" MinHeight="36" VerticalContentAlignment="Center" Padding="10,6,10,6" IsReadOnly="True" Grid.Column="1" />
            <Button Content="选择文件夹" FontSize="13" Padding="12,6,12,6" MinHeight="32" Margin="8,0,0,0" Click="BrowseBaseDirectory_Click" Grid.Column="2" Style="{DynamicResource ModernButtonStyle}" />
        </Grid>

        <Separator Margin="0,20,0,12" />
        
        <TextBlock Text="导入 / 导出" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

        <StackPanel Orientation="Vertical" Margin="0,0,0,12">
            <TextBlock Text="应用配置 (Settings)" FontSize="14" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <Button Content="导出" FontSize="13" Padding="14,6,14,6" MinHeight="32" Margin="0,0,8,0" Click="ExportSettings_Click" Style="{DynamicResource ModernButtonStyle}" />
                <Button Content="导入" FontSize="13" Padding="14,6,14,6" MinHeight="32" Click="ImportSettings_Click" Style="{DynamicResource ModernButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Vertical" Margin="0,0,0,12">
            <TextBlock Text="业务数据 (Data &amp; Structure)" FontSize="14" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <Button Content="导出" FontSize="13" Padding="14,6,14,6" MinHeight="32" Margin="0,0,8,0" Click="ExportData_Click" Style="{DynamicResource ModernButtonStyle}" />
                <Button Content="导入" FontSize="13" Padding="14,6,14,6" MinHeight="32" Click="ImportData_Click" Style="{DynamicResource ModernButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Vertical" Margin="0,0,0,12">
            <TextBlock Text="完整备份 (Full Backup)" FontSize="14" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <Button Content="导出" FontSize="13" Padding="14,6,14,6" MinHeight="32" Margin="0,0,8,0" Click="ExportAll_Click" Style="{DynamicResource ModernButtonStyle}" />
                <Button Content="导入" FontSize="13" Padding="14,6,14,6" MinHeight="32" Click="ImportAll_Click" Style="{DynamicResource ModernButtonStyle}" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
</UserControl>
