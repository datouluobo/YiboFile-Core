<UserControl x:Class="YiboFile.Controls.Settings.AppearanceSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i18n="clr-namespace:YiboFile.Services.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource HeaderTextBlockStyle}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextBlockStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,28"/>
        </Style>

        <DataTemplate x:Key="TabStylePreviewTemplate">
            <Grid MinHeight="54" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Height="44" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Height="44" VerticalAlignment="Bottom" Background="#E5EBF2" CornerRadius="0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                        <Border Width="44" Height="30" Background="Transparent" Margin="0,0,2,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="{DynamicResource Icon_Folder}" Width="13" Height="13" Margin="0,0,4,0"/>
                                <TextBlock Text="A" FontSize="11" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Grid Width="72"
                              Height="{Binding PreviewHeight}"
                              VerticalAlignment="Bottom"
                              Margin="{Binding Margin}"
                              ClipToBounds="False"
                              SnapsToDevicePixels="True">
                            <Grid ClipToBounds="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Border Background="{Binding ActiveBackground}"
                                        BorderBrush="{Binding ActiveBorderBrush}"
                                        BorderThickness="{Binding ActiveBorderThickness}"
                                        CornerRadius="{Binding CornerRadius}"/>
                                <Border Width="{Binding ActiveSideIndicatorWidth}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{Binding ActiveSideIndicatorBrush}"
                                        CornerRadius="{Binding ActiveSideIndicatorRadius}"
                                        Margin="{Binding ActiveSideIndicatorMargin}"
                                        Visibility="{Binding ActiveSideIndicatorVisibility}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="{DynamicResource Icon_Folder}" Width="13" Height="13" Margin="0,0,4,0"/>
                                    <TextBlock Text="当前" FontSize="11" FontWeight="{Binding ActiveFontWeight}" Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                                </StackPanel>
                                <Rectangle Height="{Binding ActiveIndicatorHeight}"
                                           VerticalAlignment="{Binding ActiveIndicatorPosition}"
                                           Fill="{Binding ActiveIndicatorBrush}"
                                           Margin="{Binding ActiveIndicatorMargin}"
                                           RadiusX="{Binding ActiveIndicatorRadius}"
                                           RadiusY="{Binding ActiveIndicatorRadius}"
                                           Visibility="{Binding ActiveIndicatorVisibility}"/>
                            </Grid>
                        </Grid>
                        <Border Width="44" Height="30" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="{DynamicResource Icon_Folder}" Width="13" Height="13" Margin="0,0,4,0"/>
                                <TextBlock Text="B" FontSize="11" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderDefaultBrush}"/>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource ForegroundSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,0,12,0">
        <StackPanel Margin="0,0,0,24" MaxWidth="880" HorizontalAlignment="Stretch">
            
            <TextBlock Text="{i18n:Loc Key=Settings.Appearance.Language}" Style="{StaticResource SettingsSectionTitleStyle}" />
            <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                      ItemsSource="{Binding AvailableLanguages}" DisplayMemberPath="NativeName" SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" />

            <TextBlock Text="{i18n:Loc Key=Settings.Appearance.Theme}" Style="{StaticResource SettingsSectionTitleStyle}" />
            
            <TextBlock Text="{i18n:Loc Key=Settings.Appearance.ThemeDesc}" Style="{StaticResource SettingsDescriptionStyle}" />
            
            <TextBlock Text="{i18n:Loc Key=Settings.Appearance.SelectTheme}" Style="{StaticResource SettingsFieldLabelStyle}" />
            
            <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                      ItemsSource="{Binding Themes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
            
            <TextBlock Text="{i18n:Loc Key=Settings.Appearance.IconStyle}" Style="{StaticResource SettingsFieldLabelStyle}" />
            
            <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                      ItemsSource="{Binding IconStyles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedIconStyle, Mode=TwoWay}" />
            
            <TextBlock Text="{i18n:Loc Key=Settings.Appearance.UIStyle}" Style="{StaticResource SettingsFieldLabelStyle}" />
            
            <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                      ItemsSource="{Binding UIStyles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedUIStyle, Mode=TwoWay}" />

            <TextBlock Text="Tab 样式：" Style="{StaticResource SettingsFieldLabelStyle}" />

            <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                      MinHeight="62"
                      ItemsSource="{Binding TabStyles}"
                      ItemTemplate="{StaticResource TabStylePreviewTemplate}"
                      SelectedItem="{Binding SelectedTabStyle, Mode=TwoWay}" />

            <TextBlock Text="{i18n:Loc Key=Settings.Appearance.GlobalFontSize}" Style="{StaticResource SettingsFieldLabelStyle}" />
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox MaxLength="3" Text="{Binding UIFontSizeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Width="64" Height="34" VerticalContentAlignment="Center" TextAlignment="Center" Padding="6,0" Margin="0,0,8,0" Grid.Column="0">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <EventSetter Event="KeyDown" Handler="NumericTextBox_KeyDown" />
                            <EventSetter Event="LostFocus" Handler="NumericTextBox_LostFocus" />
                            <EventSetter Event="PreviewTextInput" Handler="NumericTextBox_PreviewTextInput" />
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <StackPanel Orientation="Vertical" Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="▲" Width="26" Height="16" MinHeight="16" FontSize="10" Padding="0" Margin="0,0,0,2" VerticalAlignment="Center" Click="UIFontSizeUp_Click" Style="{DynamicResource ModernButtonStyle}" />
                    <Button Content="▼" Width="26" Height="16" MinHeight="16" FontSize="10" Padding="0" VerticalAlignment="Center" Click="UIFontSizeDown_Click" Style="{DynamicResource ModernButtonStyle}" />
                </StackPanel>
                <TextBlock Text="{i18n:Loc Key=Settings.Appearance.GlobalFontSizeDesc}" Style="{StaticResource SettingsDescriptionStyle}" VerticalAlignment="Center" Margin="16,0,0,0" Grid.Column="2" />
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
