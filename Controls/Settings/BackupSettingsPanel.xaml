<UserControl x:Class="YiboFile.Controls.Settings.BackupSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YiboFile.Controls.Settings"
             xmlns:i18n="clr-namespace:YiboFile.Services.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <StackPanel>
        <TextBlock Text="{i18n:Loc Key=Settings.Backup.Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
        
        <!-- 备份位置 -->
        <GroupBox Header="{i18n:Loc Key=Settings.Backup.Storage}" Margin="0,0,0,20" Padding="15">
            <StackPanel>
                <TextBlock Text="{i18n:Loc Key=Settings.Backup.FolderLocation}" FontWeight="Medium" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BackupPathTextBox" Padding="5" IsReadOnly="True" Background="{DynamicResource BackgroundSecondaryBrush}"/>
                    <Button Grid.Column="1" Content="{i18n:Loc Key=Settings.Backup.Browse}" Padding="15,5" Margin="10,0,0,0" Click="BrowseButton_Click"/>
                </Grid>
                <TextBlock Text="{i18n:Loc Key=Settings.Backup.DefaultLocationHint}" 
                           FontSize="12" Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="0,4,0,0"/>

                <Button Content="{i18n:Loc Key=Settings.Backup.OpenFolder}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenFolderButton_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- 管理与策略 -->
        <GroupBox Header="{i18n:Loc Key=Settings.Backup.ManagementPolicy}" Margin="0,0,0,20" Padding="15">
            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i18n:Loc Key=Settings.Backup.RetentionTime}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="RetentionComboBox" Grid.Column="1" Width="150" HorizontalAlignment="Left" SelectionChanged="RetentionComboBox_SelectionChanged">
                        <ComboBoxItem Tag="0"><TextBlock Text="{i18n:Loc Key=Settings.Backup.Permanent}"/></ComboBoxItem>
                        <ComboBoxItem Tag="7"><TextBlock Text="{i18n:Loc Key=Settings.Backup.Days7}"/></ComboBoxItem>
                        <ComboBoxItem Tag="30"><TextBlock Text="{i18n:Loc Key=Settings.Backup.Days30}"/></ComboBoxItem>
                        <ComboBoxItem Tag="90"><TextBlock Text="{i18n:Loc Key=Settings.Backup.Days90}"/></ComboBoxItem>
                        <ComboBoxItem Tag="180"><TextBlock Text="{i18n:Loc Key=Settings.Backup.Days180}"/></ComboBoxItem>
                        <ComboBoxItem Tag="365"><TextBlock Text="{i18n:Loc Key=Settings.Backup.Year1}"/></ComboBoxItem>
                    </ComboBox>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{i18n:Loc Key=Settings.Backup.CleanOldBackups}" Padding="15,8" Click="CleanButton_Click"/>
                </StackPanel>
                <TextBlock Text="{i18n:Loc Key=Settings.Backup.ManageHint}" FontSize="12" Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="0,8,0,0"/>
            </StackPanel>
        </GroupBox>

        <TextBlock Text="{i18n:Loc Key=Settings.Backup.FeatureDescTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,10"/>
        <TextBlock Text="{i18n:Loc Key=Settings.Backup.FeatureDesc}" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundSecondaryBrush}" />
    </StackPanel>
</UserControl>

