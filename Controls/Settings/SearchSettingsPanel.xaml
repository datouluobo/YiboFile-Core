<UserControl x:Class="YiboFile.Controls.Settings.SearchSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i18n="clr-namespace:YiboFile.Services.Localization"
             mc:Ignorable="d" 
             Focusable="True" FocusVisualStyle="{x:Null}"
             d:DesignHeight="800" d:DesignWidth="800">
    <StackPanel x:Name="MainStackPanel" Margin="20">
        <StackPanel.Resources>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <EventSetter Event="KeyDown" Handler="NumericTextBox_KeyDown" />
                <EventSetter Event="LostFocus" Handler="NumericTextBox_LostFocus" />
                <EventSetter Event="PreviewTextInput" Handler="NumericTextBox_PreviewTextInput" />
            </Style>
        </StackPanel.Resources>
        
        <TextBlock Text="{i18n:Loc Key=Settings.Search.FullTextSearchTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
        <TextBlock Text="{i18n:Loc Key=Settings.Search.FullTextDesc}" FontSize="12" Margin="0,0,0,24" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundSecondaryBrush}" />

        <GroupBox Header="{i18n:Loc Key=Settings.Search.EverythingTitle}" Margin="0,0,0,24" Padding="10" Background="Transparent" BorderThickness="0">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i18n:Loc Key=Settings.Search.CurrentVersion}" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                    <TextBlock x:Name="EverythingVersionText" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="1" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                </Grid>
                <Button Content="{i18n:Loc Key=Settings.Search.RebuildEverything}" Click="RebuildEverythingButton_Click" Padding="16,8,16,8" HorizontalAlignment="Left" Margin="0,10,0,10" Cursor="Hand" Style="{DynamicResource ModernButtonStyle}" />
                <TextBlock Text="{i18n:Loc Key=Settings.Search.EverythingDesc}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundSecondaryBrush}" />
            </StackPanel>
        </GroupBox>

        <CheckBox Content="{i18n:Loc Key=Settings.Search.EnableFullText}" IsChecked="{Binding IsEnableFullTextSearch}" FontSize="14" MinHeight="32" Margin="0,0,0,24" Foreground="{DynamicResource ForegroundPrimaryBrush}" />

        <GroupBox Header="{i18n:Loc Key=Settings.Search.IndexStatusTitle}" Margin="0,0,0,24" Padding="10" Background="Transparent" BorderThickness="0">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i18n:Loc Key=Settings.Search.IndexLocation}" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                    <TextBlock Text="{Binding IndexLocation}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" Grid.Column="1" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                    <Button Content="{i18n:Loc Key=Settings.Search.Change}" Click="ChangeIndexLocationButton_Click" Padding="8,2,8,2" Grid.Column="2" Style="{DynamicResource ModernButtonStyle}" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i18n:Loc Key=Settings.Search.IndexedDocCount}" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                    <TextBlock Text="{Binding IndexedFileCount}" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="1" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                </Grid>
                <StackPanel Margin="0,5,0,0">
                    <ProgressBar Value="{Binding IndexingProgress}" Height="6" Margin="0,5,0,5" Maximum="100" />
                    <TextBlock Text="{Binding IndexingStatusText}" FontSize="12" Opacity="0.7" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{i18n:Loc Key=Settings.Search.HistoryTitle}" Margin="0,0,0,24" Padding="10" Background="Transparent" BorderThickness="0">
            <StackPanel>
                <CheckBox Content="{i18n:Loc Key=Settings.Search.AutoExpandHistory}" IsChecked="{Binding AutoExpandHistory}" FontSize="14" Margin="0,0,0,10" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{i18n:Loc Key=Settings.Search.HistoryCount}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                    <TextBox MaxLength="6" Text="{Binding HistoryMaxCountInput, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="4" Grid.Column="1" />
                </Grid>
                <Button Content="{i18n:Loc Key=Settings.Search.ClearHistory}" Click="ClearHistoryButton_Click" Padding="12,6,12,6" HorizontalAlignment="Left" Style="{DynamicResource ModernButtonStyle}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{i18n:Loc Key=Settings.Search.Maintenance}" Margin="0,0,0,24" Padding="10" Background="Transparent" BorderThickness="0">
            <StackPanel>
                <TextBlock Text="{i18n:Loc Key=Settings.Search.IndexScope}" FontWeight="Bold" Margin="0,0,0,5" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                <ListBox x:Name="ScopeListBox" ItemsSource="{Binding IndexScopes}" Height="100" Margin="0,0,0,5" SelectionMode="Extended" Background="{DynamicResource BackgroundPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="{i18n:Loc Key=Settings.Search.AddDirectory}" Click="AddScopeButton_Click" Padding="10,4,10,4" Margin="0,0,10,0" Style="{DynamicResource ModernButtonStyle}" />
                    <Button Content="{i18n:Loc Key=Settings.Search.RemoveSelected}" Click="RemoveScopeButton_Click" Padding="10,4,10,4" Style="{DynamicResource ModernButtonStyle}" />
                </StackPanel>
                <Button Content="{i18n:Loc Key=Settings.Search.RebuildIndex}" Click="RebuildIndexButton_Click" Padding="16,8,16,8" HorizontalAlignment="Left" Margin="0,0,0,10" Style="{DynamicResource ModernButtonStyle}" />
                <TextBlock Text="{i18n:Loc Key=Settings.Search.RebuildIndexDesc}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundSecondaryBrush}" />
            </StackPanel>
        </GroupBox>

        <Expander Header="{i18n:Loc Key=Settings.Search.SupportedExtensions}" Margin="0,0,0,24" Foreground="{DynamicResource ForegroundPrimaryBrush}">
            <StackPanel x:Name="ExtensionsPanel" Margin="10" />
        </Expander>

    </StackPanel>
</UserControl>
