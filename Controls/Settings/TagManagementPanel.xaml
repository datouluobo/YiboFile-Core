<UserControl x:Class="YiboFile.Controls.Settings.TagManagementPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YiboFile.Controls.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <local:TagNullToVisibilityConverter x:Key="NullToVis" />
        <local:TagNullToVisibilityConverter x:Key="NullToVisInvert" Invert="True" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Padding="20" Background="{DynamicResource BackgroundSecondaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="标签管理" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource ForegroundPrimaryBrush}" Grid.Row="0" />

            <Grid Margin="0,10,0,0" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Groups -->
                <Grid Margin="0,0,20,0" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="GroupList" ItemsSource="{Binding TagGroups}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource BackgroundPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Padding="10,4,10,4" CornerRadius="4" SnapsToDevicePixels="True" Margin="0,0,0,2" Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="12" Height="12" CornerRadius="6" Background="{Binding ColorBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Padding="10" Margin="0,10,0,0" CornerRadius="4" Background="{DynamicResource BackgroundSecondaryBrush}" Grid.Row="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <TextBox x:Name="NewGroupTb" MaxLength="50" Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" Padding="5" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" Background="{DynamicResource BackgroundPrimaryBrush}" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                                <TextBlock Text="新分组名称..." Margin="8,0,0,5" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource ForegroundSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=NewGroupTb}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Content="新建分组" Command="{Binding AddTagGroupCommand}" Padding="0,6,0,6" BorderThickness="0" Cursor="Hand" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Right Column: Tags -->
                <Grid Visibility="{Binding SelectedItem, ElementName=GroupList, Converter={StaticResource NullToVis}}" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15" Grid.Row="0">
                        <TextBlock Text="{Binding SelectedItem.Name, ElementName=GroupList, StringFormat='分组: {0}'}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Content="删除分组" Command="{Binding DataContext.DeleteTagGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SelectedItem, ElementName=GroupList}" Margin="15,0,0,0" Padding="10,4,10,4" Background="Transparent" Foreground="Red" BorderThickness="1" BorderBrush="Red" FontSize="12" Cursor="Hand" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20" Grid.Row="1">
                        <Grid Margin="0,0,10,0" Width="200">
                            <TextBox x:Name="NewTagTb" MaxLength="50" Text="{Binding SelectedItem.NewTagText, ElementName=GroupList, UpdateSourceTrigger=PropertyChanged}" Padding="5" VerticalContentAlignment="Center" />
                            <TextBlock Text="输入标签名称..." Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=NewTagTb}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Content="添加标签" Command="{Binding DataContext.AddTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SelectedItem, ElementName=GroupList}" Padding="15,5,15,5" Background="#2196F3" Foreground="White" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding SelectedItem.Tags, ElementName=GroupList}" Grid.Row="2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Setting Tag on the inner Border instead so the ContextMenu can resolve it -->
                                <Border Background="{Binding ColorBrush}" CornerRadius="4" Padding="10,4,8,4" Margin="0,0,8,8" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="修改颜色" Command="{Binding PlacementTarget.Tag.UpdateTagColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            <MenuItem Header="重命名" Command="{Binding PlacementTarget.Tag.RenameTagCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Content="✕" Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="16" Height="16" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" Opacity="0.7" Cursor="Hand" ToolTip="删除标签">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <TextBlock Text="← 请从左侧选择一个分组以管理标签" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundSecondaryBrush}" Visibility="{Binding SelectedItem, ElementName=GroupList, Converter={StaticResource NullToVisInvert}}" Grid.Column="1" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
