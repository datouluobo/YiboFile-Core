<UserControl x:Class="YiboFile.Controls.AddressBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YiboFile.Controls"
             xmlns:helpers="clr-namespace:YiboFile.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="32" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:ResourceKeyConverter x:Key="ResourceKeyConverter"/>

        <Style x:Key="SearchToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <Image x:Name="Icon"
                                       Source="{DynamicResource Icon_Search}" 
                                       Width="14" Height="14"
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 背景和边框：大幅度装饰美化 -->
        <Border Grid.ColumnSpan="3"
                BorderThickness="{DynamicResource UI.AddressBar.BorderThickness}"
                CornerRadius="{DynamicResource UI.AddressBar.CornerRadius}">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- 默认状态：轻微内缩与底层背景区分，颜色更暗 -->
                    <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                    <Style.Triggers>
                        <!-- 鼠标滑过时变亮 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BackgroundPrimaryBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                        </Trigger>
                        <!-- 输入/激活时发光并强化 -->
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BackgroundPrimaryBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- 让地址栏有一层微弱的物理环境阴影，具有现代浏览器搜索框同样的悬浮高级感 -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08" Direction="270" Color="Black"/>
            </Border.Effect>
        </Border>

        <!-- 编辑模式容器 -->
        <Grid Name="EditModeContainer" Grid.Column="1" Visibility="Collapsed">
            <TextBox Name="AddressTextBox"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalContentAlignment="Center"
                     Padding="8,0"
                     KeyDown="AddressTextBox_KeyDown"
                     LostFocus="AddressTextBox_LostFocus"
                     ContextMenuOpening="AddressTextBox_ContextMenuOpening"/>
            
            <ToggleButton Name="SearchModeToggle" 
                          HorizontalAlignment="Right"
                          Style="{StaticResource SearchToggleStyle}"
                          Margin="0,0,4,0"/>
        </Grid>

        <!-- 地址建议弹出项 -->
        <Popup Name="HistoryPopup" 
               PlacementTarget="{Binding ElementName=BreadcrumbContainer}"
               Placement="Bottom"
               StaysOpen="False"
               Width="{Binding ActualWidth, ElementName=BreadcrumbContainer}"
               AllowsTransparency="True">
            <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.1" ShadowDepth="2"/>
                </Border.Effect>
                <ListBox Name="HistoryListBox"
                         MaxHeight="300"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="HistoryListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="32" Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image helpers:IconHelper.IconKey="{Binding IconKey}" 
                                       Width="16" Height="16"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayPath}" 
                                           VerticalAlignment="Center" Margin="8,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding DisplayType}" 
                                           VerticalAlignment="Center" Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                           FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
        
        <!-- 面包屑导航（默认显示） -->
        <Border Name="BreadcrumbContainer"
                Grid.Column="1"
                Background="Transparent"
                MouseLeftButtonDown="BreadcrumbContainer_MouseLeftButtonDown"
                VerticalAlignment="Stretch">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="刷新" Click="AddressBarRefresh_Click" Icon="🔄"/>
                    <MenuItem Header="复制地址" Click="AddressBarCopyPath_Click" Icon="📋"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid Name="PathContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- 左侧：path前缀和省略号（或完整路径） -->
                <TextBlock Name="BreadcrumbText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Padding="5,3"
                           ToolTipService.ShowOnDisabled="True"/>
                
                <!-- 右侧：路径尾部（仅长路径时使用，右对齐） -->
                <TextBlock Name="BreadcrumbTail"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Padding="5,3"
                           HorizontalAlignment="Right"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

