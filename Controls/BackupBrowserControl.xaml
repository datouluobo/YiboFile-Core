<UserControl x:Class="YiboFile.Controls.BackupBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YiboFile.Controls"
             xmlns:conv="clr-namespace:YiboFile.Converters"
             xmlns:vm="clr-namespace:YiboFile.ViewModels"
             xmlns:previews="clr-namespace:YiboFile.ViewModels.Previews"
             xmlns:i18n="clr-namespace:YiboFile.Services.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource BackgroundPrimaryBrush}"
             Foreground="{DynamicResource ForegroundPrimaryBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:MathConverter x:Key="MathConverter"/>
        <Style TargetType="ListViewItem">
             <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
             <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}"/>
        </Style>
        <Style TargetType="ListBoxItem">
             <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="刷新" Padding="10,5" Command="{Binding LoadCommand}" Margin="0,0,10,0"/>
                <Button Content="清空回收站" Padding="10,5" Command="{Binding EmptyBinCommand}" Foreground="{DynamicResource StatusErrorBrush}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Background="{DynamicResource BackgroundPrimaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="150"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Date Groups -->
            <DockPanel Grid.Column="0">
                <TextBlock Text="删除日期" DockPanel.Dock="Top" Margin="10" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" BorderThickness="0" Background="Transparent">
                     <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Date}" FontWeight="Medium" Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                                <TextBlock Text="{Binding CountDisplay}" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                     </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1" Style="{StaticResource VerticalGridSplitterStyle}"/>

            <!-- Right: Files in selected group -->
            <DockPanel Grid.Column="2">
                <TextBlock Text="回收站文件" DockPanel.Dock="Top" Margin="10" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                
                <ListView x:Name="BackupFilesListView" ItemsSource="{Binding SelectedItems}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="Transparent" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="原始路径" Width="{Binding ActualWidth, ElementName=BackupFilesListView, Converter={StaticResource MathConverter}, ConverterParameter=-350}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OriginalPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding SizeDisplay}"/>
                            <GridViewColumn Header="删除时间" Width="130" DisplayMemberBinding="{Binding DeletionDateDisplay}"/>
                            <GridViewColumn Header="操作" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="还原" Margin="0,0,5,0" Padding="5,2" 
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="删除" Padding="5,2"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Foreground="{DynamicResource StatusErrorBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ForegroundSecondaryBrush}">
                        <Run Text="共 "/><Run Text="{Binding TotalItems}"/><Run Text=" 项"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3" Background="{DynamicResource BackgroundElevatedBrush}" Opacity="0.5" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
             <TextBlock Text="正在加载..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
        </Grid>
    </Grid>
</UserControl>
