<UserControl x:Class="YiboFile.Controls.BackupBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YiboFile.Controls"
             xmlns:conv="clr-namespace:YiboFile.Converters"
             xmlns:vm="clr-namespace:YiboFile.ViewModels"
             xmlns:previews="clr-namespace:YiboFile.ViewModels.Previews"
             xmlns:i18n="clr-namespace:YiboFile.Services.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource BackgroundPrimaryBrush}"
             Foreground="{DynamicResource ForegroundPrimaryBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:MathConverter x:Key="MathConverter"/>
        <Style TargetType="ListViewItem">
             <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
             <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}"/>
        </Style>
        <Style TargetType="ListBoxItem">
             <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="{i18n:Loc Key=BackupBrowser.Refresh}" Padding="10,5" Command="{Binding LoadCommand}" Margin="0,0,10,0"/>
                <Button Content="{i18n:Loc Key=BackupBrowser.CleanOldBackups}" Padding="10,5" Command="{Binding CleanCommand}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Background="{DynamicResource BackgroundPrimaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="150"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Backup Dates -->
            <DockPanel Grid.Column="0">
                <TextBlock Text="{i18n:Loc Key=BackupBrowser.BackupDate}" DockPanel.Dock="Top" Margin="10" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" BorderThickness="0" Background="Transparent">
                     <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Date}" FontWeight="Medium" Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                                <TextBlock Text="{Binding Records.Count, StringFormat=' ({0})'}" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                     </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1" Style="{StaticResource VerticalGridSplitterStyle}"/>

            <!-- Middle: Files in selected backup -->
            <DockPanel Grid.Column="2">
                <TextBlock Text="{i18n:Loc Key=BackupBrowser.FileList}" DockPanel.Dock="Top" Margin="10" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                
                <ListView x:Name="BackupFilesListView" ItemsSource="{Binding SelectedBackup.Records}" SelectedItem="{Binding CurrentPreviewRecord}" BorderThickness="0" Background="Transparent" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{i18n:Loc Key=BackupBrowser.OriginalPath}" Width="{Binding ActualWidth, ElementName=BackupFilesListView, Converter={StaticResource MathConverter}, ConverterParameter=-350}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OriginalPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{i18n:Loc Key=BackupBrowser.Size}" Width="80" DisplayMemberBinding="{Binding Size}"/>
                            <GridViewColumn Header="{i18n:Loc Key=BackupBrowser.DeletionTime}" Width="130" DisplayMemberBinding="{Binding DeletionTime}"/>
                            <GridViewColumn Header="{i18n:Loc Key=BackupBrowser.Action}" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{i18n:Loc Key=BackupBrowser.Restore}" Margin="0,0,5,0" Padding="5,2" 
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="{i18n:Loc Key=BackupBrowser.Delete}" Padding="5,2"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Foreground="{DynamicResource StatusErrorBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                     <!-- 暂时隐藏批量操作，等待 ListView 多选绑定支持 -->
                     <!--
                     <Button Content="删除选中" Command="{Binding DeleteSelectedCommand}" Margin="0,0,10,0" Foreground="{DynamicResource StatusErrorBrush}"/>
                     <Button Content="恢复选中" Command="{Binding RestoreSelectedCommand}" />
                     -->
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3" Background="{DynamicResource BackgroundElevatedBrush}" Opacity="0.5" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
             <TextBlock Text="{i18n:Loc Key=BackupBrowser.Loading}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
        </Grid>
    </Grid>
</UserControl>

