<UserControl x:Class="YiboFile.Controls.AboutPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i18n="clr-namespace:YiboFile.Services.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,12">
                    <TextBlock Text="{i18n:Loc Key=About.Title}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>

                <!-- 导航列表 -->
                <StackPanel Grid.Row="1" Margin="0,10">
                    <RadioButton x:Name="TabInfo" Content="{i18n:Loc Key=About.SoftwareInfo}" GroupName="AboutTabs" IsChecked="True"
                                 Style="{DynamicResource SettingsTabButtonStyle}" Click="Tab_Click"/>
                    <RadioButton x:Name="TabShortcuts" Content="{i18n:Loc Key=About.Shortcuts}" GroupName="AboutTabs"
                                 Style="{DynamicResource SettingsTabButtonStyle}" Click="Tab_Click"/>
                    <RadioButton x:Name="TabLicense" Content="{i18n:Loc Key=About.License}" GroupName="AboutTabs"
                                 Style="{DynamicResource SettingsTabButtonStyle}" Click="Tab_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 分割线 -->
        <Border Grid.Column="1" Background="{DynamicResource DividerBrush}"/>

        <!-- 右侧内容区 -->
        <Border Grid.Column="2" Background="{DynamicResource BackgroundPrimaryBrush}">
            <Grid>
                <!-- 内容页 1：软件信息 -->
                <ScrollViewer x:Name="ContentInfo" Visibility="Visible" Padding="40">
                    <StackPanel>
                        <!-- Logo -->
                        <Image Source="/Resources/logo.png" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        
                        <!-- 标题 -->
                        <TextBlock Text="YiboFile" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                        <TextBlock Text="{i18n:Loc Key=About.ModernExplorer}" FontSize="16" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="0,0,0,30"/>

                        <!-- 版本 -->
                        <Border Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{i18n:Loc Key=About.VersionInfo}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{i18n:Loc Key=About.VersionNumber}" Grid.Column="0" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                                    <TextBlock x:Name="VersionText" Text="1.0.0.0" Grid.Column="1" FontWeight="Medium"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{i18n:Loc Key=About.BuildDate}" Grid.Column="0" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                                    <TextBlock x:Name="BuildDateText" Text="2026-01-04" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{i18n:Loc Key=About.Developer}" Grid.Column="0" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                                    <TextBlock Text="YiboSoft" Grid.Column="1"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Copyright © 2024-2026 YiboSoft. All rights reserved." 
                                   HorizontalAlignment="Center" 
                                   Foreground="{DynamicResource ForegroundTertiaryBrush}"
                                   FontSize="12" Margin="0,40,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 内容页 2：快捷操作 -->
                <ScrollViewer x:Name="ContentShortcuts" Visibility="Collapsed" Padding="30">
                    <StackPanel>
                        <TextBlock Text="{i18n:Loc Key=About.ShortcutsTitle}" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                        
                        <Border Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <!-- 表头 -->
                                <Grid Background="{DynamicResource BackgroundSecondaryBrush}" Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{i18n:Loc Key=About.Function}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0"/>
                                    <TextBlock Text="{i18n:Loc Key=About.Operation}" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}"/>
                                
                                <!-- 列表项 -->
                                <ItemsControl x:Name="ShortcutsList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="0">
                                                <StackPanel>
                                                    <Grid Height="40">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="3*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Action}" VerticalAlignment="Center" Margin="15,0" Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
                                                        <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0">
                                                            <TextBlock Text="{Binding Keys}" FontFamily="Consolas, Courier New" Background="{DynamicResource BackgroundSecondaryBrush}" Padding="6,2" Foreground="{DynamicResource AccentDefaultBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Opacity="0.5"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 内容页 3：开源许可 -->
                <ScrollViewer x:Name="ContentLicense" Visibility="Collapsed" Padding="30">
                    <StackPanel>
                        <TextBlock Text="{i18n:Loc Key=About.LicenseTitle}" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="{i18n:Loc Key=About.LicenseDesc}" Margin="0,0,0,20" Foreground="{DynamicResource ForegroundSecondaryBrush}"/>
                        
                        <ItemsControl x:Name="LicensesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="6" Margin="0,0,10,10" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="360" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                            <TextBlock Text="{Binding Description}" Margin="0,4,0,0" Foreground="{DynamicResource ForegroundSecondaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding License}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource ForegroundTertiaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>


    </Grid>

    <UserControl.Resources>
        <!-- 简单的导航按钮样式 -->
        <Style x:Key="SettingsTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Indicator" Background="Transparent" Grid.Column="0"/>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentDefaultBrush}"/>
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentDefaultBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
</UserControl>


