<UserControl x:Class="YiboFile.Controls.TitleActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!-- 统一资源：所有按钮默认为 ModernToolbarButtonStyle -->
    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="Button" BasedOn="{StaticResource ModernToolbarButtonStyle}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <StackPanel x:Name="PathPanel" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Command="{Binding Commands.NewFolderCommand}" ToolTip="新建文件夹" Margin="0,0,2,0">
                <Image Source="{DynamicResource Icon_Folder}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.NewFileCommand}" ToolTip="新建文件" Margin="0,0,2,0">
                <Image Source="{DynamicResource Icon_File}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Separator Margin="12,4" Height="20" VerticalAlignment="Center"/>
            <Button Command="{Binding Commands.CopyCommand}" ToolTip="复制" Margin="0,0,2,0">
                <Image Source="{DynamicResource Icon_Copy}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.PasteCommand}" ToolTip="粘贴" Margin="0,0,2,0">
                <Image Source="{DynamicResource Icon_Format}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.DeleteCommand}" ToolTip="删除" Margin="0,0,2,0">
                <Image Source="{DynamicResource Icon_Delete_Outline}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </StackPanel>

        <StackPanel x:Name="LibraryPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <Button Command="{Binding Commands.NewFolderCommand}" ToolTip="新建文件夹" Margin="0,0,2,0">
                <Image Source="{DynamicResource Icon_Folder}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.NewFileCommand}" ToolTip="新建文件" Margin="0,0,2,0">
                <Image Source="{DynamicResource Icon_File}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Separator Margin="12,4" Height="20" VerticalAlignment="Center"/>
            <Button Command="{Binding Commands.CopyCommand}" ToolTip="复制" Margin="0,0,2,0">
                <Image Source="{DynamicResource Icon_Copy}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.PasteCommand}" ToolTip="粘贴" Margin="0,0,2,0">
                <Image Source="{DynamicResource Icon_Format}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.DeleteCommand}" ToolTip="删除" Margin="0,0,2,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="Height" Value="32"/>
                    </Style>
                </Button.Style>
                <Image Source="{DynamicResource Icon_Delete_Outline}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.RefreshCommand}" ToolTip="刷新" Margin="0,0,2,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="Height" Value="32"/>
                    </Style>
                </Button.Style>
                <Image Source="{DynamicResource Icon_Refresh}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </StackPanel>

        <StackPanel x:Name="TagPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <Button Command="{Binding Commands.NewTagCommand}" ToolTip="新建标签" Margin="0,0,2,0" Height="36">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="Padding" Value="8,0"/>
                    </Style>
                </Button.Style>
                <Image Source="{DynamicResource Icon_Add}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.ManageTagsCommand}" ToolTip="管理标签" Margin="0,0,2,0" Height="36">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="Padding" Value="8,0"/>
                    </Style>
                </Button.Style>
                <Image Source="{DynamicResource Icon_Settings}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Separator Margin="12,4" Height="20" VerticalAlignment="Center"/>
            <Button Command="{Binding Commands.BatchAddTagsCommand}" ToolTip="批量添加" Margin="0,0,2,0" Height="36">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="Padding" Value="8,0"/>
                    </Style>
                </Button.Style>
                <Image Source="{DynamicResource Icon_Add}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.TagStatisticsCommand}" ToolTip="标签统计" Margin="0,0,2,0" Height="36">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="Padding" Value="8,0"/>
                    </Style>
                </Button.Style>
                <Image Source="{DynamicResource Icon_Filter}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Separator Margin="12,4" Height="20" VerticalAlignment="Center"/>
            <Button Command="{Binding Commands.CopyCommand}" ToolTip="复制" Margin="0,0,2,0" Height="36">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="Padding" Value="8,0"/>
                    </Style>
                </Button.Style>
                <Image Source="{DynamicResource Icon_Copy}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.PasteCommand}" ToolTip="粘贴" Margin="0,0,2,0" Height="36">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="Padding" Value="8,0"/>
                    </Style>
                </Button.Style>
                <Image Source="{DynamicResource Icon_Format}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.DeleteCommand}" ToolTip="删除" Margin="0,0,2,0" Height="36">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="Padding" Value="8,0"/>
                    </Style>
                </Button.Style>
                <Image Source="{DynamicResource Icon_Delete_Outline}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </StackPanel>

        <StackPanel x:Name="SearchPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <Button Command="{Binding Commands.CopyCommand}" ToolTip="复制" Margin="0,0,4,0" Height="36">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="Padding" Value="8,0"/>
                    </Style>
                </Button.Style>
                <Image Source="{DynamicResource Icon_Copy}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.PasteCommand}" ToolTip="粘贴" Margin="0,0,4,0" Height="36">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="Padding" Value="8,0"/>
                    </Style>
                </Button.Style>
                <Image Source="{DynamicResource Icon_Format}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.DeleteCommand}" ToolTip="删除" Margin="0,0,4,0" Height="36">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="Padding" Value="8,0"/>
                    </Style>
                </Button.Style>
                <Image Source="{DynamicResource Icon_Delete_Outline}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Command="{Binding Commands.RefreshCommand}" ToolTip="刷新" Margin="0,0,4,0" Height="36">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="Padding" Value="8,0"/>
                    </Style>
                </Button.Style>
                <Image Source="{DynamicResource Icon_Refresh}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>



















