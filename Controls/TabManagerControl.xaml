<UserControl x:Class="YiboFile.Controls.TabManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="800"
             shell:WindowChrome.IsHitTestVisibleInChrome="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 导航箭头按钮样式 -->
            <Style x:Key="OverflowArrowButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ArrowBorder" Background="{TemplateBinding Background}" 
                                    CornerRadius="4" Opacity="0.6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ArrowBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                    <Setter TargetName="ArrowBorder" Property="Opacity" Value="1.0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ArrowBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Border x:Name="TabsBorder" Background="Transparent" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0" Visibility="Visible"
            shell:WindowChrome.IsHitTestVisibleInChrome="True"
            SizeChanged="TabsBorder_SizeChanged">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 左箭头 -->
                <ColumnDefinition Width="Auto"/>
                <!-- 标签区域 -->
                <ColumnDefinition Width="*"/>
                <!-- 右箭头 -->
                <ColumnDefinition Width="Auto"/>
                <!-- 新建按钮 -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左导航箭头 -->
            <Button x:Name="ScrollLeftButton" Grid.Column="0"
                    Style="{StaticResource OverflowArrowButtonStyle}"
                    Content="‹" Visibility="Collapsed"
                    Click="ScrollLeft_Click"
                    ToolTip="向左滚动"/>

            <!-- 标签页滚动区域 -->
            <ScrollViewer x:Name="TabScrollViewer" Grid.Column="1"
                          Style="{StaticResource OverlayScrollViewerStyle}"
                          PanningMode="HorizontalOnly"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          ScrollChanged="TabScrollViewer_ScrollChanged"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ItemsControl x:Name="TabsItemsControl" 
                              ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              ItemTemplate="{StaticResource PathTabDataTemplate}"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel x:Name="TabsPanel" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- 左渐变遮罩（覆盖在 ScrollViewer 上方） -->
            <Border x:Name="GradientLeft" Grid.Column="1"
                    HorizontalAlignment="Left" Width="24"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{DynamicResource BackgroundPrimaryBrush.Color}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 右渐变遮罩 -->
            <Border x:Name="GradientRight" Grid.Column="1"
                    HorizontalAlignment="Right" Width="24"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="{DynamicResource BackgroundPrimaryBrush.Color}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 右导航箭头 -->
            <Button x:Name="ScrollRightButton" Grid.Column="2"
                    Style="{StaticResource OverflowArrowButtonStyle}"
                    Content="›" Visibility="Collapsed"
                    Click="ScrollRight_Click"
                    ToolTip="向右滚动"/>

            <!-- 新建标签页按钮 -->
            <Button x:Name="NewTabButton" Grid.Column="3"
                    Style="{StaticResource NewTabButtonStyle}"
                    Width="32" Height="32"
                    Margin="2,0,2,0"
                    VerticalAlignment="Center"
                    Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NewTabCommand}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="新建标签页">
                <Image Source="{DynamicResource Icon_Add}" Width="16" Height="16" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
