<UserControl x:Class="YiboFile.Controls.TabManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:tabs="clr-namespace:YiboFile.Services.Tabs"
             xmlns:i18n="clr-namespace:YiboFile.Services.Localization"
             xmlns:converters="clr-namespace:YiboFile.Controls.Converters"
             xmlns:controls="clr-namespace:YiboFile.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="800"
             shell:WindowChrome.IsHitTestVisibleInChrome="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 导航箭头按钮样式 -->
            <Style x:Key="OverflowArrowButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ArrowBorder" Background="{TemplateBinding Background}" 
                                    CornerRadius="4" Opacity="0.6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ArrowBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                    <Setter TargetName="ArrowBorder" Property="Opacity" Value="1.0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ArrowBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <converters:WidthToVisibilityConverter x:Key="WidthToVisibilityConverter" />

            <!-- Tab 行专用滚动模板：不要复用普通内容区 OverlayScrollViewerStyle。
                 普通模板会给 ScrollContentPresenter 留 4px 底部空间，44px 标题栏里会压缩/裁切 tab。 -->
            <Style x:Key="TabStripScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                            <Grid ClipToBounds="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                                        Margin="0"
                                                        ClipToBounds="False"
                                                        SnapsToDevicePixels="True"
                                                        UseLayoutRounding="True" />
                                <ScrollBar x:Name="PART_HorizontalScrollBar"
                                           VerticalAlignment="Bottom"
                                           Height="0"
                                           Maximum="{TemplateBinding ScrollableWidth}"
                                           Orientation="Horizontal"
                                           ViewportSize="{TemplateBinding ViewportWidth}"
                                           Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                           Opacity="0" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="PathTabDataTemplate" DataType="{x:Type tabs:PathTab}">
                <Button x:Name="TabButton" Style="{StaticResource TabButtonStyle}" Width="{Binding TargetWidth}" 
                        Command="{Binding SelectCommand}" ToolTip="{Binding Title}" 
                        controls:TabManagerControl.IsActiveNotifier="{Binding IsActive}" 
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ContextMenuOpening="TabContextMenu_Opening">
                    <Button.InputBindings>
                        <MouseBinding MouseAction="MiddleClick" Command="{Binding CloseCommand}" />
                    </Button.InputBindings>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{i18n:Loc Key=TabContent.Context.Duplicate}" Click="DuplicateTab_Click" />
                            <MenuItem x:Name="PinMenuItem" Header="{i18n:Loc Key=TabContent.Context.Pin}" Click="TogglePinTab_Click" />
                            <MenuItem Header="{i18n:Loc Key=TabContent.Context.Rename}" Click="RenameTab_Click" />
                            <MenuItem Header="{i18n:Loc Key=TabContent.Context.CopyPath}" Click="CopyPath_Click" />
                            <MenuItem Header="{i18n:Loc Key=TabContent.Context.OpenExplorer}" Click="OpenInExplorer_Click" />
                            <Separator />
                            <MenuItem Header="{i18n:Loc Key=TabContent.Context.Close}" Click="CloseTab_Click" FontWeight="Bold" />
                            <MenuItem Header="{i18n:Loc Key=TabContent.Context.CloseOthers}" Click="CloseOtherTabs_Click" />
                            <MenuItem Header="{i18n:Loc Key=TabContent.Context.CloseLeft}" Click="CloseLeftTabs_Click" />
                            <MenuItem Header="{i18n:Loc Key=TabContent.Context.CloseRight}" Click="CloseRightTabs_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Grid x:Name="TabContentGrid" Margin="10,0" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <TextBlock Grid.Column="0" x:Name="IconText" Text="📁" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" IsHitTestVisible="False" 
                                   Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=80}" />

                        <!-- Title -->
                        <TextBlock Grid.Column="1" x:Name="TitleTextBlock" Text="{Binding Title}" Margin="0,0,24,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />

                        <!-- Close Button: overlay it so hidden close affordance never steals title width. -->
                        <Button Grid.Column="1" x:Name="PART_CloseButton" Width="18" Height="18" Margin="0" Padding="0" 
                                VerticalAlignment="Center" HorizontalAlignment="Right" 
                                Foreground="{DynamicResource ForegroundPrimaryBrush}" 
                                Command="{Binding CloseCommand}" 
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="Transparent" CornerRadius="4">
                                                    <Path x:Name="iconPath" Data="M 0,0 L 8,8 M 8,0 L 0,8" 
                                                          Stroke="{TemplateBinding Foreground}" 
                                                          StrokeThickness="1.2"
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"
                                                          Stretch="None" 
                                                          Opacity="0.7"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#FFE2E2"/>
                                                        <Setter TargetName="iconPath" Property="Stroke" Value="#E81123"/>
                                                        <Setter TargetName="iconPath" Property="Opacity" Value="1.0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#FFC6C6"/>
                                                        <Setter TargetName="iconPath" Property="Stroke" Value="#E81123"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1.0" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter TargetName="TabButton" Property="Style" Value="{StaticResource ActiveTabButtonStyle}" />
                        <Setter TargetName="IconText" Property="Opacity" Value="1.0" />
                    </DataTrigger>
                    <Trigger SourceName="TabButton" Property="IsMouseOver" Value="True">
                        <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <DataTrigger Binding="{Binding Path, Converter={StaticResource StringStartsWithConverter}, ConverterParameter='search://'}" Value="True">
                        <Setter TargetName="IconText" Property="Text" Value="🔍" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Path, Converter={StaticResource StringStartsWithConverter}, ConverterParameter='tag://'}" Value="True">
                        <Setter TargetName="IconText" Property="Text" Value="🏷️" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Path, Converter={StaticResource StringStartsWithConverter}, ConverterParameter='lib://'}" Value="True">
                        <Setter TargetName="IconText" Property="Text" Value="📚" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                        <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="IconText" Property="Text" Value="📌" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Border x:Name="TabsBorder" Background="{DynamicResource TitleBarBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Visibility="Visible"
            ClipToBounds="False"
            shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid ClipToBounds="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <!-- 左箭头 -->
                <ColumnDefinition Width="Auto"/>
                <!-- 标签区域 -->
                <ColumnDefinition Width="*"/>
                <!-- 右箭头 -->
                <ColumnDefinition Width="Auto"/>
                <!-- 新建按钮 -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左导航箭头 -->
            <Button x:Name="ScrollLeftButton" Grid.Column="0"
                    Style="{StaticResource OverflowArrowButtonStyle}"
                    Content="‹" Visibility="Collapsed"
                    Click="ScrollLeft_Click"
                    ToolTip="向左滚动"/>

            <ScrollViewer x:Name="TabScrollViewer" Grid.Column="1"
                          Style="{StaticResource TabStripScrollViewerStyle}"
                          ClipToBounds="False"
                          PanningMode="HorizontalOnly"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          ScrollChanged="TabScrollViewer_ScrollChanged"
                          SizeChanged="TabsBorder_SizeChanged"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ItemsControl x:Name="TabsItemsControl" 
                              xmlns:handlers="clr-namespace:YiboFile.Handlers"
                              ClipToBounds="False"
                              handlers:TabDragDropBehavior.IsEnabled="True"
                              ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              ItemTemplate="{StaticResource PathTabDataTemplate}"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel x:Name="TabsPanel" Orientation="Horizontal" ClipToBounds="False" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- 左渐变遮罩（覆盖在 ScrollViewer 上方） -->
            <Border x:Name="GradientLeft" Grid.Column="1"
                    HorizontalAlignment="Left" Width="24"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{DynamicResource TitleBarBackgroundBrush.Color}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 右渐变遮罩 -->
            <Border x:Name="GradientRight" Grid.Column="1"
                    HorizontalAlignment="Right" Width="24"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="{DynamicResource TitleBarBackgroundBrush.Color}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 右导航箭头 -->
            <Button x:Name="ScrollRightButton" Grid.Column="2"
                    Style="{StaticResource OverflowArrowButtonStyle}"
                    Content="›" Visibility="Collapsed"
                    Click="ScrollRight_Click"
                    ToolTip="向右滚动"/>

            <!-- 新建标签页按钮 -->
            <Button x:Name="NewTabButton" Grid.Column="3"
                    Style="{StaticResource NewTabButtonStyle}"
                    Width="{DynamicResource UI.TabItem.Height}" Height="{DynamicResource UI.TabItem.Height}"
                    Margin="{DynamicResource UI.TabItem.Margin}"
                    VerticalAlignment="Bottom"
                    Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NewTabCommand}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="新建标签页">
                <Image Source="{DynamicResource Icon_Add}" Width="16" Height="16" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
