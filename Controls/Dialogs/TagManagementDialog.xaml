<Window x:Class="YiboFile.Controls.Dialogs.TagManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YiboFile.Converters"
        mc:Ignorable="d"
        Title="标签管理" Height="500" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundPrimaryBrush}"
        Foreground="{DynamicResource ForegroundPrimaryBrush}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:MathConverter x:Key="MathConverter" />
        
        <!-- Simply Style for ListBoxItem to stretch content -->
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                         <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="标签管理" FontWeight="SemiBold" FontSize="16" Margin="15,15,15,5"/>

        <!-- Main Content: List of Groups (Expanders) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
            <ItemsControl x:Name="GroupsList" BorderThickness="0" Background="Transparent" AlternationCount="2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="4">
                            <Expander IsExpanded="True" BorderThickness="0" Background="Transparent" Padding="5">
                            <Expander.Header>
                                <Grid Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Expander}}, Path=ActualWidth, Converter={StaticResource MathConverter}, ConverterParameter=-50}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Color Indicator -->
                                    <Border Width="12" Height="12" CornerRadius="6" Background="{Binding Color}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    
                                    <!-- Group Name -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14"/>

                                    <!-- Group Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✎" Click="RenameGroup_Click" Style="{StaticResource ModernButtonStyle}" 
                                                Width="24" Height="24" Padding="0" Margin="4,0,0,0" ToolTip="重命名分组"
                                                Background="Transparent" BorderThickness="0"/>
                                                Width="24" Height="24" Padding="0" Margin="4,0,0,0" ToolTip="删除分组" Foreground="{DynamicResource StatusErrorBrush}"
                                                Background="Transparent" BorderThickness="0"/>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            
                            <Expander.Content>
                                <Grid Margin="0,5,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Tags List -->
                                    <ListBox ItemsSource="{Binding Tags}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel IsItemsHost="True"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Color}" CornerRadius="12" Padding="8,4" Margin="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ForegroundOnAccentBrush}" VerticalAlignment="Center"/>
                                                        <StackPanel x:Name="ActionButtons" Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0"
                                                                    Opacity="0">
                                                             <Button Content="✎" Click="RenameTag_Click" Width="16" Height="16" Padding="0"
                                                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ForegroundOnAccentBrush}" ToolTip="重命名" Margin="0,0,2,0"/>
                                                             <Button Content="✕" Click="DeleteTag_Click" Width="16" Height="16" Padding="0" 
                                                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ForegroundOnAccentBrush}" ToolTip="删除"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border.Triggers>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ActionButtons" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ActionButtons" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Add Tag Inline -->
                                    <Grid Grid.Row="1" Margin="4,10,4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Grid>
                                            <TextBox x:Name="NewTagBox" Style="{StaticResource ModernTextBoxStyle}" KeyDown="NewTagBox_KeyDown" Tag="添加标签..."/>
                                            <TextBlock Text="添加标签..." Foreground="{DynamicResource ForegroundSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=NewTagBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        
                                        <Button Grid.Column="1" Content="+" Width="30" Margin="5,0,0,0" Click="AddTagToGroup_Click" Style="{StaticResource ModernAccentButtonStyle}"/>
                                    </Grid>
                                </Grid>
                            </Expander.Content>
                        </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer: Add Group -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource WindowBackgroundBrush}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewGroupNameBox" Tag="新建分组..." Style="{StaticResource ModernTextBoxStyle}" KeyDown="NewGroupNameBox_KeyDown"/>
                <Button Grid.Column="1" Content="新建分组" Padding="15,0" Margin="10,0,0,0" Click="AddGroupBtn_Click" Style="{StaticResource ModernAccentButtonStyle}"/>
            </Grid>
        </Border>

        <!-- Error Snackbar -->
        <Border x:Name="ErrorOverlay" Grid.RowSpan="3" VerticalAlignment="Bottom" Background="{DynamicResource StatusErrorBrush}" Padding="15,10" Margin="20" CornerRadius="4" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Text="Error Message" Foreground="{DynamicResource ForegroundOnAccentBrush}" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
