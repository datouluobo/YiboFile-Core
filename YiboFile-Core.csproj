<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>YiboFile</RootNamespace>
    <AssemblyName>YiboFile-Core</AssemblyName>
    <AssemblyTitle>YiboFile - 鏂囦欢璧勬簮绠＄悊鍣?/AssemblyTitle>
    <AssemblyDescription>Windows鏂囦欢璧勬簮绠＄悊鍣ㄧ▼搴忥紝鐢ㄤ簬绠＄悊銆佸綊妗ｃ€佹祻瑙堝悇绉嶆牸寮忕殑鏂囨。銆佸浘鐗囥€佽棰?/AssemblyDescription>
    <AssemblyVersion>1.0.1820.0</AssemblyVersion>
    <FileVersion>1.0.1820.0</FileVersion>
    <Version>1.0.1820.0</Version>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- 鏋勫缓浼樺寲 -->
    <UseSharedCompilation>true</UseSharedCompilation>
    <BuildInParallel>true</BuildInParallel>
    <UseRidGraph>true</UseRidGraph>
    <Authors>YiboSoft</Authors>
    <Company>YiboSoft</Company>
    <Copyright>Copyright 漏 2024-2026 YiboSoft</Copyright>
    <ApplicationIcon>..\Icon\Logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.0" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.5" />
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.11.0" />
    <PackageReference Include="Markdig" Version="0.35.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" Version="1.0.17">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
    <PackageReference Include="IxMilia.Dxf" Version="0.8.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.0" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

  <!-- 鑷姩澶嶅埗 Dependencies\Everything 鏂囦欢澶瑰埌杈撳嚭鐩綍 -->
  <ItemGroup>
    <None Include="Dependencies\Everything\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 鑷姩澶嶅埗 Dependencies\7-Zip 鏂囦欢澶瑰埌杈撳嚭鐩綍 -->
  <ItemGroup>
    <None Include="Dependencies\7-Zip\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 鑷姩澶嶅埗 Resources 鏂囦欢澶瑰埌杈撳嚭鐩綍 (鎺掗櫎 Icons 涓嬬殑 XAML锛屽洜涓哄畠浠綔涓?Page 缂栬瘧) -->
  <ItemGroup>
    <None Include="Resources\**\*" CopyToOutputDirectory="PreserveNewest" Exclude="Resources\Icons\**\*.xaml;Resources\UIStyles\**\*.xaml" />
  </ItemGroup>

  <!-- 鑷姩澶嶅埗璇█鏂囦欢鍒拌緭鍑虹洰褰?-->
  <ItemGroup>
    <None Include="Languages\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>



  <Target Name="MoveLibVLC" AfterTargets="Build">
    <PropertyGroup>
        <LibVlcDest>$(OutputPath)Dependencies\libvlc</LibVlcDest>
    </PropertyGroup>
    <ItemGroup>
      <LibVlcFiles Include="$(OutputPath)libvlc\**\*.*" Exclude="$(OutputPath)libvlc\win-x86\**\*.*" />
    </ItemGroup>
    <!-- Move files to Dependencies/libvlc ONLY if libvlc.dll doesn't exist in destination (saves time) -->
    <Move SourceFiles="@(LibVlcFiles)" DestinationFolder="$(LibVlcDest)\%(RecursiveDir)" Condition="!Exists('$(LibVlcDest)\libvlc.dll')" />
    <!-- Remove the empty source directory if successful (or if we skipped move, we still want to clean up the source) -->
    <RemoveDir Directories="$(OutputPath)libvlc" />
  </Target>
  

</Project>




