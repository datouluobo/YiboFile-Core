<Window x:Class="YiboFile.Windows.NotesEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑笔记" Style="{StaticResource BaseDialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        Width="500" Height="350"
        MinWidth="400" MinHeight="250">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="{Binding FileName}" Margin="0,0,0,12" 
                   FontSize="14" FontWeight="SemiBold" 
                   Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
        
        <TextBox Grid.Row="1" 
                 Name="NotesTextBox"
                 AcceptsReturn="True" 
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14"
                 Padding="12"
                 BorderBrush="{DynamicResource BorderDefaultBrush}"
                 BorderThickness="1"
                 Background="{DynamicResource BackgroundSecondaryBrush}"
                 Foreground="{DynamicResource ForegroundPrimaryBrush}"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" Click="Save_Click" Style="{StaticResource PrimaryDialogButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="取消" Click="Cancel_Click" Style="{StaticResource DialogButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
