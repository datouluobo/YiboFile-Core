<Window x:Class="YiboFile.Windows.HotkeyEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑快捷键" Width="380" Height="280"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{DynamicResource BackgroundTertiaryBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Margin="15" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="设置快捷键" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource ForegroundPrimaryBrush}" Grid.Row="0" />
            
            <TextBlock x:Name="DescText" FontSize="13" Margin="0,0,0,20" Foreground="{DynamicResource ForegroundSecondaryBrush}" Grid.Row="1" />
            
            <Border BorderThickness="2" CornerRadius="8" Padding="15" Background="{DynamicResource BackgroundPrimaryBrush}" BorderBrush="{DynamicResource AccentDefaultBrush}" SnapsToDevicePixels="True" UseLayoutRounding="True" Height="70" Grid.Row="2">
                <TextBlock x:Name="KeyDisplayText" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundPrimaryBrush}" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0" Grid.Row="3">
                <Button x:Name="SaveBtn" Content="完成" Padding="20,6,20,6" Margin="0,0,10,0" Cursor="Hand" Click="SaveBtn_Click" Style="{DynamicResource ModernAccentButtonStyle}" />
                <Button Content="取消" Padding="20,6,20,6" Cursor="Hand" Click="CancelBtn_Click" Style="{DynamicResource ModernButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
