<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fluent Design UI Style -->
    
    <!-- Tabs -->
    <CornerRadius x:Key="UI.TabItem.CornerRadius">6,6,6,6</CornerRadius>
    <Thickness x:Key="UI.TabItem.Margin">4,4</Thickness>
    <Thickness x:Key="UI.TabItem.Padding">4,2</Thickness>
    <SolidColorBrush x:Key="UI.TabItem.ActiveBackground" Color="#FFFFFF"/>
    <Visibility x:Key="UI.TabItem.ActiveIndicatorVisibility">Collapsed</Visibility>
    <Visibility x:Key="UI.TabItem.SeparatorVisibility">Collapsed</Visibility>
    <Thickness x:Key="UI.TabItem.ActiveIndicatorMargin">0</Thickness>
    <CornerRadius x:Key="UI.TabItem.ActiveIndicatorRadius">0</CornerRadius>
    
    <!-- Toolbar Buttons -->
    <CornerRadius x:Key="UI.ToolbarButton.CornerRadius">6</CornerRadius>
    <Thickness x:Key="UI.ToolbarButton.BorderThickness">0</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Padding">12,4</Thickness>
    
    <!-- Sidebar / TreeView -->
    <CornerRadius x:Key="UI.Sidebar.ItemCornerRadius">6</CornerRadius>
    <Thickness x:Key="UI.Sidebar.ItemMargin">4,2</Thickness>
    <Visibility x:Key="UI.Sidebar.ActiveIndicatorVisibility">Visible</Visibility>
    
    <!-- Address Bar -->
    <CornerRadius x:Key="UI.AddressBar.CornerRadius">12</CornerRadius>
    <Thickness x:Key="UI.AddressBar.BorderThickness">0</Thickness>
    
    <!-- File List (DataGrid) -->
    <CornerRadius x:Key="UI.FileList.RowCornerRadius">6</CornerRadius>
    <Thickness x:Key="UI.FileList.RowMargin">6,2</Thickness>
    <Thickness x:Key="UI.FileList.RowBorderThickness">0</Thickness>
    
    <!-- Splitter -->
    <Visibility x:Key="UI.Splitter.VisibleLine">Collapsed</Visibility>

</ResourceDictionary>
