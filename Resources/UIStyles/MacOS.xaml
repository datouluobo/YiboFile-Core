<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- MacOS Clean Floating UI Style -->
    
    <!-- Tabs -->
    <CornerRadius x:Key="UI.TabItem.CornerRadius">10,10,10,10</CornerRadius>
    <Thickness x:Key="UI.TabItem.Margin">6,6</Thickness>
    <Thickness x:Key="UI.TabItem.Padding">8,4</Thickness>
    <SolidColorBrush x:Key="UI.TabItem.ActiveBackground" Color="#FFFFFF"/>
    <Visibility x:Key="UI.TabItem.ActiveIndicatorVisibility">Collapsed</Visibility>
    <Visibility x:Key="UI.TabItem.SeparatorVisibility">Collapsed</Visibility>
    <Thickness x:Key="UI.TabItem.ActiveIndicatorMargin">0</Thickness>
    <sys:Double x:Key="UI.TabItem.ActiveIndicatorRadius">0</sys:Double>
    
    <!-- Toolbar Buttons -->
    <CornerRadius x:Key="UI.ToolbarButton.CornerRadius">8</CornerRadius>
    <Thickness x:Key="UI.ToolbarButton.BorderThickness">0</Thickness>
    <Thickness x:Key="UI.ToolbarButton.Padding">10,6</Thickness>
    
    <!-- Sidebar / TreeView -->
    <CornerRadius x:Key="UI.Sidebar.ItemCornerRadius">8</CornerRadius>
    <Thickness x:Key="UI.Sidebar.ItemMargin">6,4</Thickness>
    <Visibility x:Key="UI.Sidebar.ActiveIndicatorVisibility">Collapsed</Visibility>
    
    <!-- Address Bar -->
    <CornerRadius x:Key="UI.AddressBar.CornerRadius">8</CornerRadius>
    <Thickness x:Key="UI.AddressBar.BorderThickness">0</Thickness>
    
    <!-- File List (DataGrid) -->
    <CornerRadius x:Key="UI.FileList.RowCornerRadius">8</CornerRadius>
    <Thickness x:Key="UI.FileList.RowMargin">8,4</Thickness>
    <Thickness x:Key="UI.FileList.RowBorderThickness">0</Thickness>
    
    <!-- Splitter -->
    <Visibility x:Key="UI.Splitter.VisibleLine">Collapsed</Visibility>

</ResourceDictionary>
